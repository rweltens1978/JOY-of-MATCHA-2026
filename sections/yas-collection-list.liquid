{%- liquid
  assign section_prefix_class = 'choosed-collection'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}
<style>
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .choosed-collection :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
  {% endif %}
</style>
{%- stylesheet -%}
  .choosed-collection .featured-products-section {
    display: var(--display-value);
  }

  .choosed-collection_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .choosed-collection_container-wrapper {
    padding: var(--xl-padding-tb) 0;
  }

  .inner-padding .choosed-collection_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .choosed-collection_container-wrapper {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .choosed-collection_wrapper.inner-padding .container {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .choosed-collection_wrapper.outer-padding .container {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .choosed-collection_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-lr);
    padding-right: var(--xl-padding-lr);
  }

  .choosed-collection_wrapper.inner-padding .container,
  .choosed-collection_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-lr);
    --cp-spacer-right: var(--xl-padding-lr);
  }

  .choosed-collection a,
  .choosed-collection .btn,
  .choosed-collection .btn svg path {
    transition: all 0.3s ease;
  }

  .choosed-collection a:hover {
    color: var(--color-bg-btn);
  }

  .choosed-collection .btn:hover {
    color: var(--btn-background);
    background: var(--btn-color);
  }

  .choosed-collection .btn:hover svg path {
    fill: var(--btn-background);
  }

  .choosed-collection .btn .icon_cart-btns {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .choosed-collection .btn .icon_cart-btns img {
    position: relative !important;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .choosed-collection .btn {
    margin-top: 14px;
    border-radius: var(--border-radius-btn);
    border: var(--btn-border);
    color: var(--btn-color);
    background: var(--btn-background);
    text-decoration: none;
    padding: 16.5px 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
    gap: 16px;
    width: 100%;
    margin-top: 20px;
  }

  .choosed-collection .content-wrapper {
    height: auto;
    margin: 0 auto;
    max-width: var(--width-value);
    display: block;
    position: relative;
    text-align: var(--heading-align);
    padding: 20px 0;
  }

  .choosed-collection .title h2,
  .choosed-collection .title h1,
  .choosed-collection .title h3,
  .choosed-collection .title p {
    font-size: var(--headin-size);
    line-height: 110%;
    font-weight: 700;
    text-transform: var(--text-transform);
    color: var(--text-color);
    margin: 0;
    text-align: var(--text-aling);
    margin-bottom: 12px;
  }

  .choosed-collection .title,
  .choosed-collection .subtitle {
    margin-bottom: 0;
  }

  .choosed-collection .heading {
    margin-bottom: 55px;
  }

  .choosed-collection .subtitle h2,
  .choosed-collection .subtitle h3,
  .choosed-collection .subtitle h1,
  .choosed-collection .subtitle p {
    font-size: 24px;
    font-weight: 500;
    line-height: 120%;
  }

  .choosed-collection .subtitle {
    margin: 0;
    text-align: var(--text-aling);
    color: var(--text-color);
    margin-bottom: 0;
  }

  .choosed-collection .uppertitle * {
    margin: 0;
  }

  .choosed-collection .product-item {
    text-align: left;
    overflow: hidden;
    border-radius: var(--bdr-radius);
    box-shadow: var(--box-shadow);
    position: relative;
    background-color: var(--card-bg);
    border: var(--border-width);
    display: flex;
    flex-direction: column;
  }

  .choosed-collection .product-item[onclick] {
    cursor: pointer;
  }

  .choosed-collection .product-info {
    order: var(--img-count);
    display: flex;
    flex-direction: column;
    padding: var(--card-padding);
    height: 100%;
    gap: 12px;
  }

  .choosed-collection .product-description {
    min-height: 38px;
  }

  .choosed-collection .btn svg path {
    fill: var(--fill);
  }

  .choosed-collection .product-title {
    text-transform: var(--card-transform);
    line-height: 100%;
  }

  .choosed-collection .product-description {
    font-size: 16px;
    line-height: 150%;
    color: #696969;
    margin-bottom: 20px;
  }

  .collections .product-image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    height: auto;
    border-radius: var(--bdr-radius);
  }

  .choosed-collection .product-image-wrapper:not(.has_second-img) .secondary-image:not([src]) {
    opacity: 0;
  }

  .collections .product-image-wrapper svg,
  .collections .product-image-wrapper img {
    border-radius: inherit;
  }

  @media (min-width: 768px) {
    .collections .product-image-wrapper {
      margin-bottom: 4px;
    }
  }

  @media (max-width: 768px) {
    .outer-padding .choosed-collection_container-wrapper:has(.container) {
      padding-left: var(--xs-padding-lr);
      padding-right: var(--xs-padding-lr);
    }

    .choosed-collection_wrapper.inner-padding .container,
    .choosed-collection_wrapper.outer-padding .container-fluid {
      --cp-spacer-left: var(--xs-padding-lr);
      --cp-spacer-right: var(--xs-padding-lr);
    }

    .choosed-collection_container-wrapper {
      padding: var(--xs-padding-tb) 0;
    }

    .choosed-collection .product-description {
      font-size: 12px;
    }

    .choosed-collection .heading {
      margin-bottom: 32px;
    }

    .choosed-collection .subtitle h2,
    .choosed-collection .subtitle h3,
    .choosed-collection .subtitle h1,
    .choosed-collection .subtitle p {
      font-size: 20px;
    }

    .choosed-collection .featured-products-section {
      display: var(--xs-display-value);
    }

    .choosed-collection .products-grid {
      grid-template-columns: repeat(auto-fit, minmax(calc((100% / var(--counts)) - 20px), 1fr)) !important;
    }

    .choosed-collection .btn svg {
      display: none;
    }

    .choosed-collection .btn {
      font-size: 14px;
      padding: 9.5px 15px;
      margin-top: 12px;
    }

    .choosed-collection .product-reviews {
      font-size: 12px;
    }

    .choosed-collection .content-wrapper {
      max-width: 100%;
    }

    .choosed-collection .title h2,
    .choosed-collection .title h1,
    .choosed-collection .title h3,
    .choosed-collection .title p {
      font-size: var(--xs-headin-size);
      line-height: 100%;
      margin: 0;
      margin-bottom: 10px;
    }

    .collections .product-title {
      font-size: 14px !important;
      line-height: 100% !important;
    }

    .collections .product-image-wrapper {
      margin-bottom: 13px;
    }

    .choosed-collection .subtitle h2,
    .choosed-collection .subtitle h1,
    .choosed-collection .subtitle h3,
    .choosed-collection .subtitle p {
      line-height: 24px;
    }

    .choosed-collection .product-title {
      font-size: 14px;
      min-height: 21px;
    }

    .choosed-collection .product-compare-price {
      font-size: 12px;
    }

    .choosed-collection .product-price {
      font-size: 14px;
    }

    .choosed-collection .section-subtitle {
      font-weight: 500;
      font-size: 16px;
    }

    .choosed-collection .product-info {
      gap: 3px;
    }

    .choosed-collection .featured-header-w {
      gap: 20px;
      margin-bottom: 32px;
    }

    .choosed-collection svg {
      height: 12px;
      width: 12px;
    }
  }
{%- endstylesheet -%}

<section
  class="featured-products-section {{ section_prefix_class }}_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  style="
    --counts: {{ section.settings.column_prod_mob }};
    --xs-padding-lr: {{ section.settings.padding_lr_mob }}px;
    --xs-padding-tb: {{ section.settings.padding_tb_mob }}px;
    --card-transform: {{ section.settings.card_title_typography }};
    {% if section.settings.setting_btn == 'global' %}
      --fill: {{ settings.button_text_color }};
    {% else %}
      --fill: {{ section.settings.button_text_color }};
    {% endif %}
    {% if section.settings.setting_btn == 'global' %}
      --border-radius-btn: {{ settings.button_radius }}px;
      --btn-border: {{ settings.button_border_size }}px solid {{ settings.button_color_border }};
      --btn-color: {{ settings.button_text_color }};
      --btn-background: {{ settings.button_color }};
    {% else %}
      --border-radius-btn: {{ section.settings.button_radius }}px;
      --btn-border: {{ section.settings.button_border_size }}px solid {{ section.settings.button_border_color }};
      --btn-color: {{ section.settings.button_text_color }};
      --btn-background: {% if section.settings.button_color != 'transparent' %}{{ section.settings.button_color }}{% else %}var(--color-bg-btn){% endif %};
    {% endif %}
    {% if section.settings.mobile_layout == "image_first" %}
     --img-count: 2;
    {% else %}
     --img-count: 1;
    {% endif %}
    {% if section.settings.container_styling == "card" %}
     --border-width: {{ section.settings.card_border }}px solid {{ section.settings.card_border_color }};
    {% else %}
     --border-width: none;
    {% endif %}
    --card-bg: {{ section.settings.card_background }};
    {% unless section.settings.card_background == 'transparent' or section.settings.card_background == '' %}
      --card-padding: {{ section.settings.card_padding }}px;
      {% else %}
        --card-padding: {{ section.settings.card_padding }}px 0;
    {% endunless %}
    {% if section.settings.container_styling == "shadow" %}
     --box-shadow: {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_blur }}px {{ section.settings.box_shadow_spread }}px {{ section.settings.box_shadow_color }};
    {% else %}
     --box-shadow: none;
    {% endif %}
    --bdr-radius: {{ section.settings.container_radius }}px;
    {% case section.settings.heading_align %}
      {% when 'left' %}
       --text-aling: left;
      {% when 'center' %}
       --text-aling: center;
      {% when 'right' %}
       --text-aling: right;
    {% endcase %}
    --text-transform: {{ section.settings.headline_typography }};
    {% case section.settings.heading_size %}
      {% when 'small' %}
       --headin-size: 28px;
      {% when 'medium' %}
       --headin-size: 40px;
      {% when 'large' %}
       --headin-size: 48px;
    {% endcase %}
    {% case section.settings.heading_size %}
      {% when 'small' %}
       --xs-headin-size: 20px;
      {% when 'medium' %}
       --xs-headin-size: 32px;
      {% when 'large' %}
       --xs-headin-size: 32px;
    {% endcase %}
    --heading-align: {{ section.settings.heading_align }};
    --text-color: {{ section.settings.text_color }};
    --xl-padding-lr: {{ section.settings.padding_lr_desk }}px;
    --xl-padding-tb: {{ section.settings.padding_tb_desk }}px;
    --bg-color: {{ section.settings.background_color }};
    {% case section.settings.display_on %}
      {% when 'all' %}
       --display-value: block;
      {% when 'mobile_only' %}
       --display-value: none;
      {% when 'desktop_only' %}
       --display-value: block;
    {% endcase %}
    {% case section.settings.display_on %}
      {% when 'all' %}
       --xs-display-value: block;
      {% when 'mobile_only' %}
       --xs-display-value: block;
      {% when 'desktop_only' %}
       --xs-display-value: none;
    {% endcase %}
  "
>
  <div
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="      --custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_width }}">
      <div class="content-wrapper">
        {%- if section.settings.uppertitle != blank or section.settings.subtitle or section.settings.title != blank -%}
          <div class="heading">
            <div class="title word--break">
              {%- if section.settings.title != blank -%}
                {{ section.settings.title }}
              {%- endif -%}
            </div>
            <div class="subtitle word--break">
              {%- if section.settings.subtitle != blank -%}
                {{ section.settings.subtitle }}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="products-grid">
          {% for block in section.blocks %}
            {%- liquid
              assign placeholder_index = forloop.index | modulo: 4
              if placeholder_index == 0
                assign placeholder_index = 4
              endif
            -%}
            {% assign collection = block.settings.collection %}
            <div
              class="product-item"
              {{ block.shopify_attributes }}
              {% if collection.title != blank %}
                {% if section.settings.card_clickable == true %}
                  onclick="location.href='{{ collection.url }}'"
                {% endif %}
              {% endif %}
            >
              <div class="product-image-wrapper {% if section.settings.secondary_image_highlight and collection.images[1] %}has_second-img{% endif %}">
                {% if collection.featured_image != blank %}
                  {%- liquid
                    assign max_width = collection.featured_image.width
                    if collection.featured_image > 588
                      assign max_width = 588
                    endif
                    assign image_height = max_width | divided_by: collection.featured_image.aspect_ratio | round

                    capture image_alt
                      if collection.featured_image.alt != blank
                        echo collection.featured_image.alt
                      else
                        echo product.title
                      endif
                    endcapture

                    capture sizes_attr
                      echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(50vw - 30px), (max-width: 1199px) 23.059vw'
                    endcapture
                  -%}
                  {{-
                    collection.featured_image
                    | image_url: width: max_width
                    | image_tag:
                      loading: 'lazy',
                      width: max_width,
                      height: image_height,
                      sizes: sizes_attr,
                      alt: image_alt,
                      class: 'primary-image'
                  -}}
                {% else %}
                  {%- render 'placeholder-svgs', type: 'collection', index: placeholder_index, class: '' -%}
                {% endif %}
                {% if section.settings.secondary_image_highlight and collection.images[1] %}
                  {%- liquid
                    assign max_width = collection.images[1].width
                    if collection.images[1] > 588
                      assign max_width = 588
                    endif
                    assign image_height = max_width | divided_by: collection.images[1].aspect_ratio | round

                    capture image_alt
                      if collection.images[1].alt != blank
                        echo collection.images[1].alt
                      else
                        echo 'Secondary image'
                      endif
                    endcapture

                    capture sizes_attr
                      echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(50vw - 30px), (max-width: 1199px) 23.059vw'
                    endcapture
                  -%}
                  {{-
                    collection.images[1]
                    | image_url: width: max_width
                    | image_tag:
                      loading: 'lazy',
                      width: max_width,
                      height: image_height,
                      sizes: sizes_attr,
                      alt: image_alt,
                      class: 'secondary-image'
                  -}}
                {% endif %}
              </div>
              <div class="product-info">
                {% if collection.title != blank %}
                  <h3
                    class="product-title"
                    style="
                      {% if section.settings.card_title_line %}
                        display: -webkit-box;
                        -webkit-line-clamp: 2;
                        -webkit-box-orient: vertical;
                        overflow: hidden;
                      {% else %}
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                      {% endif %}
                    "
                  >
                    {{ collection.title }}
                  </h3>
                {% else %}
                  <h3
                    class="product-title"
                    style="
                      {% if section.settings.card_title_line %}
                        display: -webkit-box;
                        -webkit-line-clamp: 2;
                        -webkit-box-orient: vertical;
                        overflow: hidden;
                      {% else %}
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                      {% endif %}
                    "
                  >
                    Category Name
                  </h3>
                {% endif %}

                {% if collection.description != blank %}
                  <span class="product-description">{{ collection.description | strip_html }}</span>
                {% else %}
                  {%- if block.settings.description -%}
                    <span class="product-description">{{ block.settings.description }}</span>
                  {%- endif -%}
                {% endif %}

                {% if section.settings.show_cta %}
                  <a
                    class="btn"
                    {% if collection.title != blank %}
                      href="{{ collection.url }}"
                    {% endif %}
                  >
                    {{ section.settings.text_btn_card }}
                    {% if section.settings.show_arrow == true %}
                      {% if section.settings.icon != blank %}
                        <i class="icon_cart-btns">
                          {%- liquid
                            assign max_width = section.settings.icon.width
                            if section.settings.icon > 150
                              assign max_width = 150
                            endif
                            assign image_height = max_width | divided_by: section.settings.icon.aspect_ratio | round

                            capture image_alt
                              if section.settings.icon.alt != blank
                                echo section.settings.icon.alt
                              else
                                echo 'Icon' | escape
                              endif
                            endcapture
                          -%}
                          {{-
                            section.settings.icon
                            | image_url: width: max_width
                            | image_tag:
                              loading: 'lazy',
                              width: max_width,
                              height: image_height,
                              alt: image_alt,
                              class: ''
                          -}}
                        </i>
                      {% elsif section.settings.icon_alt != blank %}
                        <i class="icon_cart-btns material-symbols-outlined">
                          {{ section.settings.icon_alt }}
                        </i>
                      {% else %}
                        <i class="icon_cart-btns">
                          {% render 'icon_arrow_submit2' %}
                        </i>
                      {% endif %}
                    {% endif %}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "class": "collections choosed-collection",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<h2>Find Your Perfect [Product/Category]</h2>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<h3>[Short enticing line that highlights variety, style, or quality]</h3>"
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "headline_typography",
      "label": "Headline Typography",
      "options": [
        {
          "value": "uppercase",
          "label": "AA"
        },
        {
          "value": "capitalize",
          "label": "Aa"
        },
        {
          "value": "lowercase",
          "label": "aa"
        }
      ],
      "default": "capitalize"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "font_variant",
      "label": "Font Family",
      "options": [
        {
          "value": "default",
          "label": "Default by theme"
        },
        {
          "value": "custom",
          "label": "Own choice"
        }
      ],
      "default": "default"
    },
    {
      "type": "font_picker",
      "label": "Regular Font",
      "id": "title_font",
      "default": "montserrat_n4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#EDEDED"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "contained-content",
          "label": "Contained content"
        },
        {
          "value": "container-fluid",
          "label": "Edge to edge"
        }
      ],
      "default": "contained-content"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_width",
      "label": "Enable custom page width",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_page_width",
      "label": "Custom page width",
      "min": 1292,
      "max": 1600,
      "step": 4,
      "default": 1472,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_width }}"
    },
    {
      "type": "range",
      "id": "padding_lr_desk",
      "label": "Horizontal Padding",
      "info": "for desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_tb_desk",
      "label": "Vertical Padding",
      "info": "for desktop",
      "min": 0,
      "max": 100,
      "default": 78
    },
    {
      "type": "range",
      "id": "padding_lr_mob",
      "label": "Horizontal Padding",
      "info": "for mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
