{%- liquid
  assign sid = section.id
  assign section_prefix_class = 'before-after-section'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}

<style>
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .main-before-after :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
  {% endif %}
</style>

{%- stylesheet -%}
  .before-after-section {
    color: var(--text-color);
    position: relative;
    overflow: hidden;
    text-align: var(--heading-align);
  }

  .before-after-section_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .before-after-section_container-wrapper {
    padding: var(--xl-padding-y) 0;
  }

  .inner-padding .before-after-section_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .before-after-section_container-wrapper {
    background: var(--background-color);
    color: var(--text-color);
  }

  .before-after-section_wrapper.inner-padding .container {
    background: var(--background-color);
    color: var(--text-color);
  }

  .before-after-section_wrapper.outer-padding .container,
  .before-after-section_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .before-after-section_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-x);
    padding-right: var(--xl-padding-x);
  }

  .before-after-section_wrapper.inner-padding .container,
  .before-after-section_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-x);
    --cp-spacer-right: var(--xl-padding-x);
  }

  .before-after-section .heading {
    margin-bottom: 20px;
    text-align: var(--heading-align);
  }

  .before-after-section .title h1,
  .before-after-section .title h2,
  .before-after-section .title h3,
  .before-after-section .title p {
    font-size: var(--font-size-heading);
    font-weight: 700;
    text-transform: var(--headline-transform);
    color: var(--text-color);
    margin-bottom: 16px;
    text-align: var(--heading-align);
    line-height: 110%;
  }

  .before-after-section .subtitle h2,
  .before-after-section .subtitle h1,
  .before-after-section .subtitle h3,
  .before-after-section .subtitle p {
    font-size: 24px;
    font-weight: 500;
    line-height: 150%;
    margin-bottom: 20px;
    text-align: var(--heading-align);
    color: var(--text-color);
  }

  .before-after-wrapper {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .before-after-slider {
    width: 100%;
    overflow: hidden;
    padding-bottom: 50px;
  }

  .before-after-item {
    border: 1px solid #cbcbcb;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .before-after-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--image-radius);
  }

  .before-image {
    clip-path: inset(0 50% 0 0);
  }

  .before-image,
  .after-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .before-image img,
  .after-image img,
  .before-image svg,
  .after-image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .after-image {
    clip-path: inset(0 0 0 50%);
  }

  .before-image,
  .after-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .divider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    background: var(--marker-color);
    cursor: ew-resize;
    z-index: 10;
  }

  .handle {
    position: absolute;
    top: 50%;
    left: -35px;
    width: 70px;
    height: 70px;
    background: var(--marker-color);
    border-radius: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: var(--marker-symbol);
    font-weight: bold;
  }

  .labels {
    display: flex;
    justify-content: space-around;
    align-items: center;
    width: 100%;
    height: 66px;
    text-align: center;
  }

  .before-label,
  .after-label {
    font-size: 21px;
    line-height: 125%;
    font-weight: bold;
    color: var(--text-color);
  }

  .main-before-after .swiper-button-prev,
  .main-before-after .swiper-button-next {
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    color: var(--marker-color);
  }

  .main-before-after .swiper-button-prev {
    left: 10px;
  }

  .main-before-after .swiper-button-next {
    right: 10px;
  }

  .main-before-after .before-after-item {
    border-radius: var(--image-radius);
  }

  .main-before-after .swiper-pagination-bullets.swiper-pagination-horizontal {
    width: auto;
    padding-top: 0;
  }

  .main-before-after .swiper-pagination {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .main-before-after .swiper-pagination-bullet {
    margin: 0;
  }

  .main-before-after .swiper-pagination-bullet.swiper-pagination-bullet-active {
    width: 20px;
    height: 20px;
  }

  .main-before-after .swiper-pagination-horizontal.swiper-pagination-bullets .swiper-pagination-bullet {
    margin: 0;
  }

  .main-before-after .swiper-pagination-bullet {
    width: 16px;
    height: 16px;
  }

  .main-before-after .swiper-b-next:hover,
  .main-before-after .swiper-b-prev:hover {
    background-color: var(--color-text-btn);
  }

  .main-before-after .swiper-b-next:hover svg,
  .main-before-after .swiper-b-prev:hover svg {
    color: var(--payment-terms-background-color);
  }

  .main-before-after .swiper-b-next:hover svg path,
  .main-before-after .swiper-b-prev:hover svg path {
    fill: var(--payment-terms-background-color);
  }

  @media (min-width: 769px) {
    .main-before-after .before-after-section {
      display: var(--display-value);
    }
  }

  @media (max-width: 768px) {
    .main-before-after .before-after-section {
      display: var(--xs-display-value);
    }

    .before-after-section .subtitle h2,
    .before-after-section .subtitle h1,
    .before-after-section .subtitle h3,
    .before-after-section .subtitle p {
      font-size: 20px;
      font-weight: 500;
    }

    .outer-padding .before-after-section_container-wrapper:has(.container) {
      padding-left: var(--xs-padding-x);
      padding-right: var(--xs-padding-x);
    }

    .before-after-section_wrapper.inner-padding .container,
    .before-after-section_wrapper.outer-padding .container-fluid {
      --cp-spacer-left: var(--xs-padding-x);
      --cp-spacer-right: var(--xs-padding-x);
    }

    .before-after-section_container-wrapper {
      padding: var(--xs-padding-y) 0;
    }

    .main-before-after .swiper-button-prev,
    .main-before-after .swiper-button-next {
      top: 50%;
      transform: translateY(-50%);
      width: 30px;
      height: 30px;
    }

    .main-before-after .swiper-button-prev {
      left: 5px;
    }

    .main-before-after .swiper-button-next {
      right: 5px;
    }

    .main-before-after .swiper-button-prev:after,
    .main-before-after .swiper-button-next:after {
      font-size: 16px;
    }

    .main-before-after .swiper-pagination {
      gap: 14px;
    }

    .main-before-after .swiper-pagination-bullet.swiper-pagination-bullet-active {
      width: 16px;
      height: 16px;
    }

    .main-before-after .swiper-pagination-bullet {
      width: 10px;
      height: 10px;
    }
  }
{%- endstylesheet -%}

<div
  class="before-after-section {{ section_prefix_class }}_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  data-section-id="{{ section.id }}"
  style="
         {% case section.settings.display_on %}
        {% when 'all' %}
          --display-value: block;
        {% when 'mobile_only' %}
          --display-value: none;
        {% when 'desktop_only' %}
          --display-value: block;
    {% endcase %}
    {% case section.settings.display_on %}
        {% when 'all' %}
          --xs-display-value: block;
        {% when 'mobile_only' %}
          --xs-display-value: block;
        {% when 'desktop_only' %}
          --xs-display-value: none;
    {% endcase %}
     --text-color: {{ section.settings.text_color }};
     --background-color: {{ section.settings.background_color }};
     --heading-align: {{ section.settings.heading_align }};
     --headline-transform: {{ section.settings.headline_typography }};
     --font-size-heading: {% case section.settings.heading_size %}{% when 'small' %}28px{% when 'medium' %}40px{% when 'large' %}48px{% endcase %};
     --font-size-heading-mob: {% case section.settings.heading_size %}{% when 'small' %}20px{% when 'medium' %}32px{% when 'large' %}32px{% endcase %};
     --xs-padding-x: {{ section.settings.padding_x_mob }}px;
     --xs-padding-y: {{ section.settings.padding_y_mob }}px;
     --xl-padding-x: {{ section.settings.padding_x_desk }}px;
     --xl-padding-y: {{ section.settings.padding_y_desk }}px;
     --image-radius: {{ section.settings.image_round }}px;
     --marker-color: {{ section.settings.marker_color }};
     --marker-symbol: {{ section.settings.marker_symbol }};
  "
>
  <div
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="        --custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_width }}">
      <div class="{{ section_prefix_class }}_content-wrapper">
        {% if section.settings.uppertitle != blank or section.settings.subtitle or section.settings.title != blank %}
          <div class="heading word--break">
            {% if section.settings.uppertitle != blank %}
              <div class="uppertitle word--break">
                <span class="star_span" aria-label="5 out of 5 stars">
                  {% for i in (1..5) %}
                    {% render 'star_comparison' %}
                  {% endfor %}
                </span>
                {{ section.settings.uppertitle }}
              </div>
            {% endif %}
            <div class="title word--break">
              {% if section.settings.title != blank %}{{ section.settings.title }}{% endif %}
            </div>
            <div class="subtitle word--break">
              {% if section.settings.subtitle != blank %}{{ section.settings.subtitle }}{% endif %}
            </div>
          </div>
        {% endif %}

        <div class="before-after-wrapper">
          <div class="swiper before-after-slider swiper-no-swiping">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% if block.settings.before_image and block.settings.after_image %}
                  <div class="swiper-slide" {{ block.shopify_attributes }}>
                    <div class="before-after-item">
                      <div class="before-after-container">
                        <div class="before-image">
                          {% if block.settings.before_image != blank %}
                            {%- liquid
                              assign max_width = block.settings.before_image.width
                              if block.settings.before_image > 1400
                                assign max_width = 1400
                              endif
                              assign image_height = max_width | divided_by: block.settings.before_image.aspect_ratio | round

                              capture image_alt
                                if block.settings.before_image.alt != blank
                                  echo block.settings.before_image.alt
                                elsif block.settings.before_image.alt == blank
                                  echo 'image_alternative.static' | t
                                else
                                  echo block.settings.before_label
                                endif
                              endcapture

                              capture sizes_attr
                                echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 59.216vw'
                              endcapture
                            -%}
                            {{-
                              block.settings.before_image
                              | image_url: width: max_width
                              | image_tag:
                                loading: 'lazy',
                                width: max_width,
                                height: image_height,
                                sizes: sizes_attr,
                                alt: image_alt,
                                class: ''
                            -}}
                          {% else %}
                            {%- render 'placeholder-svgs', type: 'hero', index: 1, class: '' -%}
                          {% endif %}
                        </div>
                        <div class="after-image">
                          {% if block.settings.after_image != blank %}
                            {%- liquid
                              assign max_width = block.settings.after_image.width
                              if block.settings.after_image > 1400
                                assign max_width = 1400
                              endif
                              assign image_height = max_width | divided_by: block.settings.after_image.aspect_ratio | round

                              capture image_alt
                                if block.settings.after_image.alt != blank
                                  echo block.settings.after_image.alt
                                elsif block.settings.after_image.alt == blank
                                  echo 'image_alternative.static' | t
                                else
                                  echo block.settings.after_label
                                endif
                              endcapture

                              capture sizes_attr
                                echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 59.216vw'
                              endcapture
                            -%}
                            {{-
                              block.settings.after_image
                              | image_url: width: max_width
                              | image_tag:
                                loading: 'lazy',
                                width: max_width,
                                height: image_height,
                                sizes: sizes_attr,
                                alt: image_alt,
                                class: ''
                            -}}
                          {% else %}
                            {%- render 'placeholder-svgs', type: 'hero', index: 2, class: '' -%}
                          {% endif %}
                        </div>
                        <div class="divider">
                          <div class="handle">
                            {% render 'handle-icon' %}
                          </div>
                        </div>
                      </div>
                      <div class="labels">
                        <span class="before-label word--break">{{ block.settings.before_label }}</span>
                        <span class="after-label word--break">{{ block.settings.after_label }}</span>
                      </div>
                    </div>
                  </div>
                {% else %}
                  <div class="swiper-slide" {{ block.shopify_attributes }}>
                    <div class="before-after-item">
                      <div class="before-after-container">
                        <div class="before-image">
                          {%- render 'placeholder-svgs', type: 'hero', index: 1, class: '' -%}
                        </div>
                        <div class="after-image">
                          {%- render 'placeholder-svgs', type: 'hero', index: 2, class: '' -%}
                        </div>
                        <div class="divider">
                          <div class="handle">
                            {% render 'handle-icon' %}
                          </div>
                        </div>
                      </div>
                      <div class="labels">
                        <span class="before-label">Before</span>
                        <span class="after-label">After</span>
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            <div class="swiper-pagination-w">
              <div class="swiper-b-prev">{% render 'swiper-arrow-left-n' %}</div>
              <div class="swiper-pagination"></div>
              <div class="swiper-b-next">{% render 'swiper-arrow-right-n' %}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    try {
      const totalItems = document.querySelectorAll('.before-after-slider .swiper-slide').length;
      const selector = `.before-after-section[data-section-id="{{ section.id }}"]`;
      const swiper = new Swiper(`${selector} .before-after-slider`, {
        slidesPerView: 1,
        spaceBetween: 20,
        loop: false,
        simulateTouch: false,
        allowTouchMove: false,
        noSwiping: true,
        scrollbar: { draggable: false },
        noSwipingClass: 'swiper-no-swiping',
        loop: true,
        navigation: {
          nextEl: `${selector} .swiper-b-next`,
          prevEl: `${selector} .swiper-b-prev`,
        },
        pagination: {
          el: `${selector} .swiper-pagination`,
          clickable: true,
        },
        breakpoints: {
          769: {
            slidesPerView: 2,
            allowTouchMove: true,
            touchRatio: 1,
          },
        },
        on: {
          init: function () {},
          slideChange: function () {
            const containers = document.querySelectorAll('.main-before-after .before-after-container');
            containers.forEach((container) => {
              const divider = container.querySelector('.divider');
              const beforeImage = container.querySelector('.before-image');
              const afterImage = container.querySelector('.after-image');
              divider.style.left = '50%';
              beforeImage.style.clipPath = 'inset(0 50% 0 0)';
              afterImage.style.clipPath = 'inset(0 0 0 50%)';
            });
          },
          resize: function () {},
        },
      });

      const containers = document.querySelectorAll('.main-before-after .before-after-container');
      containers.forEach((container) => {
        const divider = container.querySelector('.divider');
        const beforeImage = container.querySelector('.before-image');
        const afterImage = container.querySelector('.after-image');
        let isDragging = false;

        divider.addEventListener('mousedown', (e) => {
          e.preventDefault();
          e.stopPropagation();
          isDragging = true;
        });

        document.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          e.stopPropagation();
          const rect = container.getBoundingClientRect();
          const x = e.clientX - rect.left;
          let percentage = (x / rect.width) * 100;
          percentage = Math.max(0, Math.min(100, percentage));
          divider.style.left = `${percentage}%`;
          beforeImage.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
          afterImage.style.clipPath = `inset(0 0 0 ${percentage}%)`;
        });

        document.addEventListener('mouseup', () => {
          isDragging = false;
        });

        divider.addEventListener('touchstart', (e) => {
          e.preventDefault();
          e.stopPropagation();
          isDragging = true;
        });

        document.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          e.stopPropagation();
          const rect = container.getBoundingClientRect();
          const x = e.touches[0].clientX - rect.left;
          let percentage = (x / rect.width) * 100;
          percentage = Math.max(0, Math.min(100, percentage));
          divider.style.left = `${percentage}%`;
          beforeImage.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
          afterImage.style.clipPath = `inset(0 0 0 ${percentage}%)`;
        });

        document.addEventListener('touchend', () => {
          isDragging = false;
        });
      });
    } catch (error) {}
  });
</script>
{% schema %}
{
  "name": "Before After Slider",
  "class": "main-before-after",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
