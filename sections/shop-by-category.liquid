          "settings": {}
        },
        {
          "type": "category",
          "settings": {}
        },
        {
          "type": "category",
          "settings": {}
        },
        {
          "type": "category",
          "settings": {}
        },
        {
          "type": "category",
          "settings": {}
        },
        {
          "type": "category",
          "settings": {}
        },
        {
          "type": "category",
          "settings": {}
        },
        {
          "type": "category",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
