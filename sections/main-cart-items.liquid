{%- liquid
  assign section_prefix_class = 'main-cart'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'

  capture cart_heading
    if section.settings.heading != blank
      echo section.settings.heading
    else
      echo 'Your Shopping Cart'
    endif
  endcapture

  capture section_container_layout
    case section.settings.section_container_layout
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture

  assign cart_render_attr = 'data-line-items-container'
-%}
<style>
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .main-cart :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
  {% endif %}
</style>
{%- style -%}
  .main-cart {
    display: var(--xs-display-value);
  }
  .main-cart .cart-drawer_totals-wrap,
  .main-cart .cart-drawer_others-wrap {
    margin-bottom: 5px;
  }
  .main-cart .heading-head {
    margin-bottom: 30px;
  }
  .main-cart_textarea {
    width: 100%;
    height: 200px;
    padding: 14px;
  }
  .cart-drawer_btn-submit {
    transition: all 0.3s ease;
    font-size: 18px;
    font-weight: 700;
    line-height: 100%;
  }
  .cart-drawer_btn-submit:hover {
    color: var(--color-bg-btn);
  }
  .main-cart .main-cart_widget--totals form {
    flex-direction: column;
  }

  .main-cart_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .main-cart_container-wrapper {
    padding: var(--xl-padding-y) 0;
  }

  .main-cart_payment-icons {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    list-style: none;
    align-items: center;
    padding-left: 0;
    margin: 0;
    margin-top: 14px;
  }

  .inner-padding .main-cart_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .main-cart_container-wrapper {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-cart.inner-padding .container {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-cart.outer-padding .container {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .main-cart_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-x);
    padding-right: var(--xl-padding-x);
  }

  .main-cart.inner-padding .container,
  .main-cart.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-x);
    --cp-spacer-right: var(--xl-padding-x);
  }

  .cart-qty-w,
  line-item-qty {
    max-width: 92px;
    display: flex;
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.3);
    background: #fff;
    position: relative;
    overflow: hidden;
    height: 40px;
  }

  line-item-qty .btn__button,
  .cart-qty-w .btn__button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    outline: none;
    box-shadow: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    cursor: pointer;
    height: 100%;
    width: 30%;
    justify-content: center;
    align-items: center;
    color: #000;
  }

  line-item-qty .btn__button:hover,
  .cart-qty-w .btn__button:hover {
    opacity: 0.7;
  }

  line-item-qty .btn__button:active,
  .cart-qty-w .btn__button:active {
    opacity: 0.5;
  }

  .btn_button-minus[name='minus'],
  line-item-qty .btn_button-minus {
    left: 0px;
  }

  .btn_button-plus[name='plus'],
  line-item-qty .btn_button-plus {
    right: 0px;
  }

  line-item-qty button svg,
  .cart-qty-w button svg {
    width: 10px;
    height: 10px;
    pointer-events: none;
  }

  .line-item_quantity-select {
    margin-top: 4px;
  }

  line-item-qty input,
  .cart-qty-w input {
    width: 100%;
    height: 100%;
    box-shadow: none;
    outline: none;
    border: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    padding: 0;
    background: transparent;
  }

  line-item-qty input::-webkit-outer-spin-button,
  line-item-qty input::-webkit-inner-spin-button,
  .cart-qty-w input::-webkit-outer-spin-button,
  .cart-qty-w input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  line-item-qty input[type='number'],
  .cart-qty-w input[type='number'] {
    -moz-appearance: textfield;
  }

  .main-cart_head-heading,
  .main-cart_heading {
    margin-bottom: 0;
  }

  .main-cart_header--one {
    margin-bottom: 30px;
  }

  .main-cart_heading,
  .main-cart_head-heading {
    text-transform: var(--heading-transform);
    font-size: var(--xl-heading-size);
    font-weight: 700;
    line-height: 100%;
  }

  .visually-hidden {
    position: absolute !important;
    word-wrap: normal !important;
    overflow: hidden;
    padding: 0;
    border: 0;
    width: 1px;
    height: 1px;
    margin: -1px;
    clip: rect(0 0 0 0);
    background-color: #000 !important;
    color: #fff !important;
  }

  .show-one_heading {
    font-size: 16px;
    line-height: 120%;
    font-weight: 700;
    margin-bottom: 22px;
  }

  .cart-related_card {
    display: flex;
    gap: 14px;
  }

  .cart-related_title {
    font-size: 14px;
    font-weight: 700;
    line-height: 120%;
  }

  .cart-related-slider .wrap_image,
  .cart-related-slider .wrap_image img,
  .cart-related-slider .wrap_image svg {
    width: 70px;
    height: 70px;
    border-radius: 8px;
    object-fit: cover;
  }

  .cart-related_description {
    font-size: 12px;
    font-weight: 400;
    line-height: 120%;
    margin-top: 16px;
  }

  .cart-related_btn,
  .cart-drawer_btn-submit {
    border: 1px solid #000000;
    border-radius: 100px;
    padding: 14px 23px;
    display: inline-block;
    background: #000000;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.3s ease;
    text-align: center;
  }
  .cart-related_btn {
    font-size: 14px;
    font-weight: 700;
    line-height: 120%;
    margin-top: 16px;
  }
  .cart-drawer_btn-submit {
    font-size: 18px;
    font-weight: 700;
    line-height: 120%;
  }

  .cart-related_btn:hover {
    border: 1px solid #000000;
    border-radius: 100px;
    background: #ffffff;
    color: #000000;
  }

  .main-cart_cart-show-two {
    margin-bottom: 26px;
    overflow: hidden;
  }
  .cart-related_btn--desktop {
    display: none;
  }

  .shipping-bar {
    position: relative;
  }
  .shipping-bar .cart-slide__label {
    position: absolute;
    transform: translate(-50%, -50%);
    top: -13px !important;
    z-index: 1;
    font-size: 12px;
    line-height: 1;
    margin-top: -2px;
    text-align: center;
  }
  .shipping-bar .cart-slide__label i {
    margin-left: auto;
    margin-right: auto;
  }
  .shipping-bar .cart-slide__label p {
    margin-top: 6px;
    margin-bottom: -17px;
  }

  .main-cart_error {
    font-size: 12px;
    line-height: 15px;
    color: red;
  }

  @media (min-width: 768px) {
    .main-cart {
      display: var(--display-value);
    }
    .cart-related_btn--desktop {
      display: block;
    }
    .main-cart_main-col--stats {
      display: flex;
      gap: 75px;
      align-items: center;
    }
    .main-cart_cart-show-two {
      width: 50%;
      flex-shrink: 0;
      margin-bottom: 0;
    }
    .main-cart_cart-show-one {
      flex-grow: 1;
    }
    .cart-related_card {
      gap: 24px;
    }
    .cart-related_title {
      font-size: 16px;
    }
    .show-one_heading {
      font-size: 18px;
      line-height: 120%;
      font-weight: 700;
      margin-bottom: 44px;
    }
    .main-cart_header--one {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .main-cart_heading {
      flex-shrink: 0;
    }
    .shipping-bar-wrapper {
      flex-grow: 1;
      text-align: end;
    }
    .cart-related-slider .wrap_image,
    .cart-related-slider .wrap_image img,
    .cart-related-slider .wrap_image svg {
      width: 123px;
      height: 123px;
    }
    .cart-related_btn--mobile {
      display: none;
    }
  }
  @media (min-width: 1200px) {
    .main-cart_wrapper.internal--spacing {
      padding: 10px 30px;
    }
    .main-cart {
      --section-padding-top: calc(var(--padding-top) * 1);
      --section-padding-bottom: calc(var(--padding-bottom) * 1);
    }
  }
  @media (max-width: 767px) {
    .main-cart_heading,
    .main-cart_head-heading {
      font-size: var(--xs-heading-size);
    }
    .cart-related_btn {
      width: 100%;
    }
    .main-cart_heading {
      display: none;
    }
    .outer-padding .main-cart_container-wrapper:has(.container) {
      padding-left: var(--xs-padding-x);
      padding-right: var(--xs-padding-x);
    }

    .main-cart.inner-padding .container,
    .main-cart.outer-padding .container-fluid {
      --cp-spacer-left: var(--xs-padding-x);
      --cp-spacer-right: var(--xs-padding-x);
    }

    .main-cart_container-wrapper {
      padding: var(--xs-padding-y) 0;
    }
  }
{%- endstyle -%}
{{- 'main-cart.css' | asset_url | stylesheet_tag -}}
<div
  id="{{ section.id }}"
  class="{{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {% if section.settings.section_container_layout == 'contained-content' or section.settings.section_container_layout == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  style="
      --bg-color: {{ section.settings.background_color }};
      --text-color: {{ section.settings.text_color }};
      --xl-padding-x: {{ section.settings.padding_x_desk }}px;
      --xl-padding-y: {{ section.settings.padding_y_desk }}px;
      --xs-padding-x: {{ section.settings.padding_x_mob }}px;
      --xs-padding-y: {{ section.settings.padding_y_mob }}px;
      --progress-bar-color: {{ settings.progress_bar_color }};
      {% case section.settings.display_on %}
        {% when 'all' %}
          --display-value: block;
        {% when 'mobile_only' %}
          --display-value: none;
        {% when 'desktop_only' %}
          --display-value: block;
      {% endcase %}
      {% case section.settings.display_on %}
        {% when 'all' %}
          --xs-display-value: block;
        {% when 'mobile_only' %}
          --xs-display-value: block;
        {% when 'desktop_only' %}
          --xs-display-value: none;
      {% endcase %}
      --heading-transform: {{ section.settings.headline_typography }};
      {% case section.settings.heading_size %}
        {% when 'small' %}
        --xl-heading-size: 28px;
        {% when 'medium' %}
        --xl-heading-size: 40px;
        {% when 'large' %}
        --xl-heading-size: 48px;
      {% endcase %}
      {% case section.settings.heading_size %}
        {% when 'small' %}
        --xs-heading-size: 20px;
        {% when 'medium' %}
        --xs-heading-size: 32px;
        {% when 'large' %}
        --xs-heading-size: 32px;
      {% endcase %}
    --padding-top: {{ section.settings.section_top_padding | append: 'px' }};
    --padding-bottom: {{ section.settings.section_bottom_padding | append: 'px' }};
  "
  data-section-id="{{ section.id }}"
>
  <div
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="      --custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_container_layout }}">
      <div class="{{ section_prefix_class }}_content-wrapper">
        <div class="{{ section_prefix_class }}_wrapper">
          <div {{ cart_render_attr }}>
            {%- if cart != empty -%}
              <header class="heading-head --q-align --q-align-alignment --q-display --q-wrap --q-align-justify --q-gap {% unless settings.cart_enable_free_shipping_message %}heading-head--center{% endunless %}">
                <div class="{{ section_prefix_class }}_header--one --q-grow">
                  <h1
                    class="mty {{ section_prefix_class }}_heading"
                  >
                    {{- cart_heading -}}
                  </h1>
                  {%- unless settings.cart_enable_free_shipping_message -%}
                    <a
                      href="{{- routes.all_products_collection_url -}}"
                      class="button button--label cart-drawer_btn-cart "
                    >
                      Continue Shopping
                    </a>
                  {%- endunless -%}
                  <span class="shipping-bar_text --word-break --align-left" data-shipping-bar-text="">
                    {{- settings.cart_free_shipping_text -}}
                  </span>
                </div>
                <div
                  data-render-shipping-bar=""
                  class="shipping-bar-wrapper"
                >
                  <shipping-bar
                    class="shipping-bar"
                    data-amount="{{ settings.cart_free_shipping_amount | default: '' | strip }}"
                    data-cart-totals="{{ cart.total_price | default: 0 }}"
                    data-shipping-message="{{ settings.cart_free_shipping_message | default: '✓ FREE Shipping Unlocked!' | strip }}"
                  >
                    <span data-progress-span="" class="shipping-bar_progress" style="--bar-width: 0%;" data-value="0"
                      >0</span
                    >
                    {%- unless settings.cart_free_shipping_amount == blank -%}
                      <div
                        class="cart-slide__label cart-slide__label-freeshiping"
                        data-price="{{ settings.cart_free_shipping_amount | default: '' | strip }}"
                      >
                        <i class="cart-slide__label-circl">{% render 'icon-delivery-truck' %}</i>
                        <p>{{- settings.cart_free_shipping_label -}}</p>
                      </div>
                    {%- endunless -%}
                    {%- unless settings.cart_free_discount_amount == blank -%}
                      <div
                        class="cart-slide__label cart-slide__label-discount"
                        data-price="{{ settings.cart_free_discount_amount | default: '' | strip }}"
                      >
                        <i class="cart-slide__label-circl">{% render 'icon-discount' %}</i>
                        <p>{{- settings.cart_free_discount_label -}}</p>
                      </div>
                    {%- endunless -%}
                  </shipping-bar>
                </div>
              </header>
              <div
                class="{{ section_prefix_class }}_main-wrapper"
              >
                <div class="{{ section_prefix_class }}_main-col {{ section_prefix_class }}_main-col--content">
                  <div class="{{ section_prefix_class }}_scroll-wrap">
                    <div class="{{ section_prefix_class }}_data">
                      <div class="{{ section_prefix_class }}_tbody">
                        {%- for item in cart.items -%}
                          {% render 'line-item-compact',
                            item: item,
                            index: forloop.index,
                            loading_attr: 'eager',
                            section_id: section.id,
                            width: 334
                          %}
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                </div>
                <aside class="{{ section_prefix_class }}_main-col {{ section_prefix_class }}_main-col--stats">
                  {%- if section.settings.cart_related_collection.products -%}
                    <div class="{{ section_prefix_class }}_cart-show-two cart-show-related">
                      {%- if section.settings.related_heading != blank -%}
                        <div class="show-one_heading">
                          {{- section.settings.related_heading -}}
                        </div>
                      {%- endif -%}
                      <div
                        class="swiper-container"
                        id="cart-related-{{ section.id }}"
                      >
                        <div class="swiper-wrapper">
                          {%- for product in section.settings.cart_related_collection.products limit: 5 -%}
                            <div
                              class="swiper-slide cart-related-slider"
                              data-idx="{{ forloop.index }}"
                            >
                              <div class="cart-related_card">
                                <div class="wrap_image">
                                  {%- liquid
                                    unless product.media.size == 0
                                      assign final_image = product.selected_or_first_available_variant.featured_media
                                      unless final_image != blank
                                        for media in product.media
                                          assign final_image = media
                                          break
                                        endfor
                                      endunless
                                    endunless

                                    assign max_width = final_image.width
                                    if final_image.width > 250
                                      assign max_width = 250
                                    endif
                                    assign image_height = max_width | divided_by: final_image.aspect_ratio | round

                                    capture product_title
                                      unless product.title == blank
                                        echo product.title
                                      else
                                        echo 'Product title'
                                      endunless
                                    endcapture

                                    capture image_alt
                                      unless featured_media.alt == blank
                                        echo featured_media.alt
                                      else
                                        echo product_title | escape
                                      endunless
                                    endcapture

                                    capture sizes_attr
                                      echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc((100vw / 2) - 30px), (max-width: 991px) calc((100vw / 3) - 30px), (max-width: 1199px) calc((100vw / 4) - 30px), 25vw'
                                    endcapture
                                  -%}
                                  {%- unless final_image == blank -%}
                                    {{-
                                      final_image
                                      | image_url: width: max_width
                                      | image_tag:
                                        loading: 'lazy',
                                        width: max_width,
                                        height: image_height,
                                        sizes: sizes_attr,
                                        alt: image_alt,
                                        class: ''
                                    -}}
                                  {%- endunless -%}
                                </div>
                                <div class="related-car_content">
                                  {%- if product.title != blank -%}
                                    <div class="cart-related_title word--break">
                                      {{- product.title -}}
                                    </div>
                                  {%- endif -%}
                                  {%- if product.description != blank -%}
                                    <div class="cart-related_description word--break">
                                      {{- product.description | truncate: 200 -}}
                                    </div>
                                  {%- endif -%}
                                  {%- liquid
                                    assign target = product

                                    assign price = target.price | default: 1999

                                    assign money_price = price | money
                                    if settings.show_currency_code
                                      assign money_price = price | money_with_currency
                                    endif

                                    if target == product and product.price_varies
                                      assign money_price = money_price | prepend: text_from
                                    endif
                                  -%}
                                  <a href="{{ product.url }}" class="cart-related_btn cart-related_btn--desktop">
                                    Add to cart - {{ money_price }}
                                  </a>
                                </div>
                              </div>
                              <a href="{{ product.url }}" class="cart-related_btn cart-related_btn--mobile">
                                Add to cart - {{ money_price }}
                              </a>
                            </div>
                          {%- endfor -%}
                        </div>
                        <div class="swiper-pagination-w">
                          <div class="swiper-b-prev">{% render 'swiper-arrow-left-n' %}</div>
                          <div class="swiper-pagination"></div>
                          <div class="swiper-b-next">{% render 'swiper-arrow-right-n' %}</div>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                  <div class="{{ section_prefix_class }}_cart-show-one cart-show-check">
                    <form action="{{- routes.cart_url -}}" method="post" class="--q-direction --q-display">
                      {%- if section.settings.enable_order_notes -%}
                        <div class="{{ section_prefix_class }}_widget {{ section_prefix_class }}_widget--totals widget--styles {{ section_prefix_class }}_widget--notes">
                          <div class="{{ section_prefix_class }}_form --q-direction --q-display">
                            <div class="cart_total-wrap" data-render-cart-totals="">
                              <details class="{{ section_prefix_class }}_widget--collapse cart-drawer_widget--collapse">
                                <summary
                                  class="{{ section_prefix_class }}_widget-opener text-size--large h --font-weight --q-display"
                                  style="--font-weight: 500;"
                                >
                                  <span class="{{ section_prefix_class }}_widget-opener-text --q-display">
                                    <svg
                                      xmlns="http://www.w3.org/2000/svg"
                                      width="22px"
                                      height="22px"
                                      viewBox="0 -0.5 25 25"
                                      fill="none"
                                    >
                                      <g id="SVGRepo_bgCarrier" stroke-width="0"/>
                                      <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"/>
