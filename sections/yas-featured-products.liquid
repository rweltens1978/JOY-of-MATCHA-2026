{%- liquid
  assign section_prefix_class = 'main-featured-grid'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}
<style>
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .main-featured-grid :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
  {% endif %}
</style>
{%- stylesheet -%}
  .main-featured-grid .featured-products-section {
    display: var(--display-value);
  }
  .product-item_top-wrap {
    flex-grow: 1;
  }
  .product-item_bottom-wrap {
    margin-top: 20px;
    padding-left: var(--hor-card-padding);
    padding-right: var(--hor-card-padding);
  }

  .main-featured-grid .anchor-btn .icon_cart-btns {
    width: 20px !important;
    height: 20px;
    flex-shrink: 0 !important;
  }

  .main-featured-grid .anchor-btn .icon_cart-btns img {
    position: relative !important;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-item_bottom-wrap [aria-disabled='true'].anchor-btn {
    pointer-events: none;
  }

  .main-featured-grid_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .main-featured-grid_container-wrapper {
    padding: var(--xl-padding-tb) 0;
  }

  .inner-padding.--top-btm_padding .main-featured-grid_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .main-featured-grid_container-wrapper {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-featured-grid_wrapper.inner-padding .container {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-featured-grid_wrapper.outer-padding .container,
  .main-featured-grid_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .main-featured-grid_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-rl);
    padding-right: var(--xl-padding-rl);
  }

  .main-featured-grid_wrapper.inner-padding .container,
  .main-featured-grid_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-rl);
    --cp-spacer-right: var(--xl-padding-rl);
  }

  .main-featured-grid a,
  .main-featured-grid .btn,
  .main-featured-grid .anchor-btn,
  .main-featured-grid .btn svg path,
  .main-featured-grid .anchor-btn svg path {
    transition: all 0.3s ease;
  }

  .main-featured-grid .viewmore_btn-w:hover {
    color: var(--color-bg-btn) !important;
  }

  .featured-product-grid .viewmore_btn-w .viewmore_btn:hover {
    color: var(--color-bg-btn);
    border-color: var(--color-bg-btn);
  }

  .featured-product-grid .btn,
  .featured-product-grid .anchor-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16.5px 7px;
    font-weight: 700;
    font-size: 16px;
    gap: 16px;
    width: 100%;
    margin-top: auto;
    text-decoration: none;
  }

  .main-featured-grid .section-title {
    text-transform: var(--heading-transform);
    color: var(--text-color);
    font-weight: 700;
  }
  .main-featured-grid .section-title h1,
  .main-featured-grid .section-title h2,
  .main-featured-grid .section-title h3,
  .main-featured-grid .section-title p {
    font-size: var(--xl-heading-size);
    line-height: 120%;
    font-weight: 700;
  }

  .main-featured-grid .section-title * {
    font-size: inherit;
    line-height: inherit;
    font-weight: inherit;
  }

  .main-featured-grid .section-subtitle {
    color: var(--subtitle-color);
    font-family: var(--font-family);
  }

  .main-featured-grid .product-item {
    border-radius: var(--bdr-radius);
    box-shadow: var(--box-shadow);
    border: var(--border);
    background-color: var(--card-bg);
  }

  .main-featured-grid .product-info {
    order: var(--img-count);
    padding: var(--ver-card-padding) var(--hor-card-padding);
  }

  .main-featured-grid .btn,
  .main-featured-grid .anchor-btn {
    border-radius: var(--btn-border-radius);
    border: var(--btn-border);
    color: var(--btn-color);
    background: var(--btn-background);
  }

  .main-featured-grid .btn:hover,
  .main-featured-grid .anchor-btn:hover,
  .main-featured-grid a.anchor-btn:hover {
    color: var(--btn-background);
    background: var(--btn-color);
  }

  .main-featured-grid .btn:hover svg path,
  .main-featured-grid .anchor-btn:hover svg path {
    fill: var(--btn-background);
  }

  .main-featured-grid .btn svg path,
  .main-featured-grid .anchor-btn svg path {
    fill: var(--fill);
  }

  .main-featured-grid .product-title {
    text-transform: var(--card-transform);
  }

  .main-featured-grid .section-subtitle p,
  .main-featured-grid .section-subtitle h3,
  .main-featured-grid .section-subtitle h2,
  .main-featured-grid .section-subtitle h1 {
    font-size: 24px;
    font-weight: 500;
    line-height: 100%;
  }

  .featured-product-grid .featured-header-w {
    margin-bottom: 61px;
    text-align: var(--heading-align);
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    gap: 9px;
  }

  .main-featured-grid .section-subtitle h3 {
    margin-bottom: 0;
  }

  .featured-product-grid .product-image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    height: auto;
    margin-bottom: 28px;
  }

  .featured-product-grid .product-image-wrapper img,
  .featured-product-grid .product-image-wrapper svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.3s ease;
  }

  .featured-product-grid .product-image-wrapper:not(.has_second-img) .secondary-image:not([src]) {
    opacity: 0;
  }

  .featured-product-grid .product-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  .featured-product-grid .product-compare-price {
    font-size: 14px;
    font-weight: 400;
    text-decoration: line-through;
    color: #999;
    margin-right: 5px;
  }

  .featured-product-grid .viewmore_btn-w .viewmore_btn {
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
    color: var(--view-more-color);
    border-bottom: 1px solid var(--view-more-color);
    line-height: 22px;
  }

  .featured-product-grid .viewmore_btn-w [aria-disabled='true'].viewmore_btn {
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .main-featured-grid .products-grid {
      gap: 31px;
      grid-template-columns: repeat(auto-fit, minmax(calc(292px), 1fr));
    }

    .featured-product-grid .product-price {
      font-size: 18px;
      font-weight: 500;
    }

    .featured-product-grid .product-title {
      font-size: 24px;
      font-weight: 500;
      overflow: hidden;
    }
  }

  @media (max-width: 768px) {
    .featured-product-grid .viewmore_btn-w .viewmore_btn {
      font-weight: 600;
      font-size: 16px;
    }

    .outer-padding .main-featured-grid_container-wrapper:has(.container) {
      padding-left: var(--xs-padding-rl);
      padding-right: var(--xs-padding-rl);
    }

    .main-featured-grid_wrapper.inner-padding .container,
    .main-featured-grid_wrapper.outer-padding .container-fluid {
      --cp-spacer-left: var(--xs-padding-rl);
      --cp-spacer-right: var(--xs-padding-rl);
    }

    .main-featured-grid_container-wrapper {
      padding: var(--xs-padding-tb) 0;
    }

    .main-featured-grid .section-title h1,
    .main-featured-grid .section-title h2,
    .main-featured-grid .section-title h3,
    .main-featured-grid .section-title p {
      font-size: var(--xs-heading-size);
    }

    .featured-product-grid .btn,
    .featured-product-grid .anchor-btn {
      padding: 9.5px 7px;
    }

    .featured-product-grid .product-compare-price {
      font-size: 12px;
    }

    .featured-product-grid .product-price {
      font-size: 14px;
      font-weight: 700;
    }

    .featured-product-grid .product-title {
      font-size: 16px;
      font-weight: 700px;
      line-height: 100%;
      letter-spacing: 0;
    }

    .featured-product-grid .product-reviews svg {
      width: 12px;
      height: 12px;
    }

    .featured-product-grid .product-info {
      gap: 10px;
    }

    .featured-product-grid .product-image-wrapper {
      margin-bottom: 20px;
    }

    .featured-product-grid .featured-header-w {
      gap: 2px;
      margin-bottom: 21px;
    }

    .main-featured-grid .section-subtitle p,
    .main-featured-grid .section-subtitle h3,
    .main-featured-grid .section-subtitle h2,
    .main-featured-grid .section-subtitle h1 {
      font-size: 20px;
      line-height: 100%;
    }

    .main-featured-grid .product-info {
      padding: 0;
    }

    .main-featured-grid .btn svg,
    .main-featured-grid .anchor-btn svg {
      display: none;
    }

    .featured-product-grid .btn,
    .featured-product-grid .anchor-btn {
      padding: 11px 0px;
      font-size: 14px;
    }

    .main-featured-grid .featured-products-section {
      display: var(--xs-display-value);
    }

    .main-featured-grid .products-grid {
      grid-template-columns: repeat(auto-fit, minmax(calc((100% / var(--column-counts)) - 20px), 1fr));
    }
  }
{%- endstylesheet -%}

<section
  class="featured-products-section {{ section_prefix_class }}_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %} {% if section.settings.top_btm_padding %}--top-btm_padding{% endif %}"
  style="
    --heading-align: {{ section.settings.heading_align }};
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xs-heading-size: 20px;
      {% when 'medium' %}
      --xs-heading-size: 32px;
      {% when 'large' %}
      --xs-heading-size: 32px;
    {% endcase %}
    --card-transform: {{ section.settings.card_title_typography }};
    {% if section.settings.setting_btn == 'global' %}
      --fill: {{ settings.button_text_color }};
    {% else %}
      --fill: {{section.settings.button_text_color}};
    {% endif %}
    {% if section.settings.setting_btn == 'global' %}
      --btn-border-radius: {{ settings.button_radius }}px;
      --btn-border: {{ settings.button_border_size }}px solid {{ settings.button_color_border }};
      --btn-color: {{ settings.button_text_color }};
      --btn-background: {{ settings.button_color }};
    {% else %}
      --btn-border-radius: {{ section.settings.button_radius }}px;
      --btn-border: {{ section.settings.button_border_size }}px solid {{ section.settings.button_border_color }};
      --btn-color: {{ section.settings.button_text_color }};
      --btn-background: {{ section.settings.button_color }};
    {% endif %}
    --ver-card-padding: {{ section.settings.ver_card_padding }}px;
    --hor-card-padding: {{ section.settings.hor_card_padding }}px;
    {% if section.settings.mobile_layout == 'image_first' %}
      --img-count: 2;
    {% else %}
    --img-count: 1;
    {% endif %}
    --card-bg: {{ section.settings.card_background }};
    {% if section.settings.container_styling == 'shadow' %}
      --box-shadow: {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_blur }}px {{ section.settings.box_shadow_spread }}px {{ section.settings.box_shadow_color }};
    {% endif %}
    {% if section.settings.container_styling == 'card' %}
      --border: {{ section.settings.card_border }}px solid {{ section.settings.card_border_color }};
    {% endif %}
    --bdr-radius: {{ section.settings.container_radius }}px;
    --font-family: {{ section.settings.title_font.family }};
    --subtitle-color: {{ section.settings.subtitle_color }};
    --heading-transform: {{ section.settings.headline_typography }};
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xl-heading-size: 28px;
      {% when 'medium' %}
      --xl-heading-size: 40px;
      {% when 'large' %}
      --xl-heading-size: 48px;
    {% endcase %}
    --column-counts: {{ section.settings.column_prod_mob }};
    --xl-padding-tb: {{ section.settings.padding_tb_desk }}px;
    --xl-padding-rl: {{ section.settings.padding_lr_desk }}px;
    --xs-padding-tb: {{ section.settings.padding_tb_mob }}px;
    --xs-padding-rl: {{ section.settings.padding_lr_mob }}px;
    --text-color: {{ section.settings.text_color }};
    --bg-color: {{ section.settings.background_color }};
    --view-more-color: {{ section.settings.view_more_color }};
    {% case section.settings.display_on %}
      {% when 'all' %}
        --xs-display-value: block;
      {% when 'mobile_only' %}
        --xs-display-value: block;
      {% when 'desktop_only' %}
        --xs-display-value: none;
    {% endcase %}
    {% case section.settings.display_on %}
      {% when 'all' %}
        --display-value: block;
      {% when 'mobile_only' %}
        --display-value: none;
      {% when 'desktop_only' %}
        --display-value: block;
    {% endcase %}
  "
>
  <div
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="--custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_width }}">
      <div class="{{ section_prefix_class }}_content-wrapper">
        {%- if section.settings.title != blank or section.settings.under_title_text != blank -%}
          <div class="featured-header-w">
            {% if template contains 'product' %}
              {%- if section.settings.product_page_title != blank -%}
                <div class="section-title word--break">{{ section.settings.product_page_title }}</div>
              {% else %}
                {%- if section.settings.title != blank -%}
                  <div class="section-title word--break">{{ section.settings.title }}</div>
                {%- endif -%}
              {%- endif -%}
            {% else %}
              {%- if section.settings.title != blank -%}
                <div class="section-title word--break">{{ section.settings.title }}</div>
              {%- endif -%}
            {% endif %}
            {%- if section.settings.under_title_text != blank -%}
              <div class="section-subtitle word--break">{{ section.settings.under_title_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="products-grid">
          {% for block in section.blocks %}
            {%- liquid
              assign placeholder_index = forloop.index | modulo: 4
              if placeholder_index == 0
                assign placeholder_index = 4
              endif
            -%}
            {% assign product = block.settings.product %}
            {% if product != blank %}
              {%- liquid
                assign variant = product.selected_or_first_available_variant
                assign is_product_available = product.available

                # Check if variant is available considering inventory management
                assign is_variant_available = false
                if variant.available
                  if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
                    if variant.inventory_quantity > 0
                      assign is_variant_available = true
                    endif
                  else
                    assign is_variant_available = true
                  endif
                endif

                # Product is considered available only if both product and variant are available
                assign show_button = false
                if is_product_available and is_variant_available
                  assign show_button = true
                endif
              -%}
              <div
                class="product-item"
                {% if section.settings.card_clickable == true and show_button %}
                  onclick="location.href='{{ product.url }}'"
                {% elsif section.settings.card_clickable == true %}
                  style="cursor: default;"
                {% endif %}
              >
                <div class="product-item_top-wrap">
                  <div class="product-image-wrapper {% if section.settings.secondary_image_highlight and product.images[1] %}has_second-img{% endif %}">
                    {% if product.featured_image != blank %}
                      {%- liquid
                        assign max_width = product.featured_image.width
                        if product.featured_image > 1400
                          assign max_width = 1400
                        endif
                        assign image_height = max_width | divided_by: product.featured_image.aspect_ratio | round

                        capture image_alt
                          if product.featured_image.alt != blank
                            echo product.featured_image.alt
                          else
                            echo product.title
                          endif
                        endcapture

                        capture sizes_attr
                          echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 25.49vw'
                        endcapture
                      -%}
                      {{-
                        product.featured_image
                        | image_url: width: max_width
                        | image_tag:
                          loading: 'lazy',
                          width: max_width,
                          height: image_height,
                          sizes: sizes_attr,
                          alt: image_alt,
                          class: 'primary-image'
                      -}}
                    {% else %}
                      {%- render 'placeholder-svgs',
                        type: 'collection',
                        index: placeholder_index,
                        class: 'primary-image'
                      -%}
                    {% endif %}
                    {% if section.settings.secondary_image_highlight and product.images[1] %}
                      {%- liquid
                        assign max_width = product.images[1].width
                        if product.images[1] > 1400
                          assign max_width = 1400
                        endif
                        assign image_height = max_width | divided_by: product.images[1].aspect_ratio | round

                        capture image_alt
                          if product.images[1].alt != blank
                            echo product.images[1].alt
                          else
                            echo 'Secondary image'
                          endif
                        endcapture

                        capture sizes_attr
                          echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 25.49vw'
                        endcapture
                      -%}
                      {{-
                        product.images[1]
                        | image_url: width: max_width
                        | image_tag:
                          loading: 'lazy',
                          width: max_width,
                          height: image_height,
                          sizes: sizes_attr,
                          alt: image_alt,
                          class: 'secondary-image'
                      -}}
                    {% endif %}
                  </div>
                  <div class="product-info">
                    {% if section.settings.show_reviews %}
                      <div class="product-reviews">
                        <span>
                          {%- for i in (1..block.settings.star_count) -%}
                            {% render 'review-stars' %}
                          {%- endfor -%}
                        </span>
                        {{ block.settings.review_text }}
                      </div>
                    {% endif %}
                    <h3
                      class="product-title"
                      style="
                        {% if section.settings.card_title_line %}
                          display: -webkit-box;
                          -webkit-line-clamp: 2;
                          -webkit-box-orient: vertical;
                        {% endif %}
                      "
                    >
                      {{ product.title }}
                    </h3>
                    <p>
                      {% if variant.compare_at_price > variant.price %}
                        <span class="product-compare-price">{{ variant.compare_at_price | money }}</span>
                      {% endif %}
                      <span class="product-price">{{ variant.price | money }}</span>
                    </p>
                  </div>
                </div>
                {% if section.settings.show_cta and show_button %}
                  <div class="product-item_bottom-wrap">
                    <button class="btn" onclick="location.href='{{ product.url }}'">
                      {{ section.settings.text_btn_card }}
                      {% if section.settings.show_arrow == true %}
                        {% if section.settings.icon != blank %}
                          <i class="icon_cart-btns">
                            {%- liquid
                              assign max_width = section.settings.icon.width
                              if section.settings.icon > 150
                                assign max_width = 150
                              endif
                              assign image_height = max_width | divided_by: section.settings.icon.aspect_ratio | round

                              capture image_alt
                                if section.settings.icon.alt != blank
                                  echo section.settings.icon.alt
                                else
                                  echo 'Icon' | escape
                                endif
                              endcapture
                            -%}
                            {{-
                              section.settings.icon
                              | image_url: width: max_width
                              | image_tag:
                                loading: 'lazy',
                                width: max_width,
                                height: image_height,
                                alt: image_alt,
                                class: ''
                            -}}
                          </i>
                        {% elsif section.settings.icon_alt != blank %}
                          <i class="icon_cart-btns material-symbols-outlined">
                            {{ section.settings.icon_alt }}
                          </i>
                        {% else %}
                          <i class="icon_cart-btns">
                            {% render 'icon_arrow_submit2' %}
                          </i>
                        {% endif %}
                      {% endif %}
                    </button>
                  </div>
                {% endif %}
              </div>
            {% else %}
              {% assign currency_symbol = shop.money_format | replace: '{{amount}}', '' | strip %}
              <div
                class="product-item"
                {% if product.title != blank %}
                  onclick="location.href='{{ product.url }}'"
                {% endif %}
              >
                <div class="product-item_top-wrap">
                  <div class="product-image-wrapper {% if section.settings.secondary_image_highlight and product.images[1] %}has_second-img{% endif %}">
                    {% if template contains 'product' %}
                      {%- render 'placeholder-svgs', type: 'hero', index: placeholder_index, class: '' -%}
                    {% else %}
                      {%- render 'placeholder-svgs', type: 'hero', index: placeholder_index, class: '' -%}
                    {% endif %}
                  </div>
                  <div class="product-info">
                    {% if section.settings.show_reviews %}
                      <div class="product-reviews">
                        <span>
                          {%- for i in (1..block.settings.star_count) -%}
                            {% render 'review-stars' %}
                          {%- endfor -%}
                        </span>
                        {{ block.settings.review_text }}
                      </div>
                    {% endif %}
                    <h3
                      class="product-title"
                      style="
                        {% if section.settings.card_title_line %}
                          display: -webkit-box;
                          -webkit-line-clamp: 2;
                          -webkit-box-orient: vertical;
                        {% endif %}
                      "
                    >
                      Product
                    </h3>
                    <p>
                      <span class="product-compare-price">{{ currency_symbol }}100</span>
                      <span class="product-price">{{ currency_symbol }}50</span>
                    </p>
                  </div>
                </div>
                {% if section.settings.show_cta %}
                  <div class="product-item_bottom-wrap">
                    <a
                      class="anchor-btn"
                      {% if product.title != blank %}
                        href="{{ product.url }}"
                      {% endif %}
                    >
                      SHOP NOW
                      {% if section.settings.show_arrow == true %}
                        {% if section.settings.icon != blank %}
                          <i class="icon_cart-btns">
                            {%- liquid
                              assign max_width = section.settings.icon.width
                              if section.settings.icon > 150
                                assign max_width = 150
                              endif
                              assign image_height = max_width | divided_by: section.settings.icon.aspect_ratio | round

                              capture image_alt
                                if section.settings.icon.alt != blank
                                  echo section.settings.icon.alt
                                else
                                  echo 'Icon' | escape
                                endif
                              endcapture
                            -%}
                            {{-
                              section.settings.icon
                              | image_url: width: max_width
                              | image_tag:
                                loading: 'lazy',
                                width: max_width,
                                height: image_height,
                                alt: image_alt,
                                class: ''
                            -}}
                          </i>
                        {% elsif section.settings.icon_alt != blank %}
                          <i class="icon_cart-btns material-symbols-outlined">
                            {{ section.settings.icon_alt }}
                          </i>
                        {% else %}
                          <i class="icon_cart-btns">
                            {% render 'icon_arrow_submit2' %}
                          </i>
                        {% endif %}
                      {% endif %}
                    </a>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        {% if section.settings.view_more_url != blank or section.settings.view_more_btn != blank %}
          <div class="viewmore_btn-w">
            <a
              {% if section.settings.view_more_url %}
                href="{{ section.settings.view_more_url }}"
              {% endif %}
              class="viewmore_btn"
            >
              {{- section.settings.view_more_btn -}}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

