    {
      "type": "range",
      "id": "w-padding_y_desk",
      "label": "Vertical Padding",
      "info": "for desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "w-padding_x_mob",
      "label": "Horizontal Padding",
      "info": "for mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "w-padding_y_mob",
      "label": "Vertical Padding",
      "info": "for mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 25
    },
    {
      "type": "range",
      "id": "w_radius",
      "label": "Corner Radius",
      "min": 0,
