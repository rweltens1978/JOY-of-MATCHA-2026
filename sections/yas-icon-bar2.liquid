{%- liquid
  assign section_prefix_class = 'main-icon-bar-two'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}
<style>
  {%- comment -%} Custom font face (loaded once) {%- endcomment -%}
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
      .main-icon-bar-two :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
        font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      }
  {% endif %}
</style>
{%- stylesheet -%}
  .main-icon-bar-two_wrapper {
    display: var(--display-value);
    color: var(--text-color);
  }

  .main-icon-bar-two_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .main-icon-bar-two_container-wrapper {
    padding: var(--xl-padding-y) 0;
  }

  .inner-padding .main-icon-bar-two_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .main-icon-bar-two_container-wrapper {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-icon-bar-two_wrapper.inner-padding .container {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-icon-bar-two_wrapper.outer-padding .container {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .main-icon-bar-two_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-x);
    padding-right: var(--xl-padding-x);
  }

  .main-icon-bar-two_wrapper.inner-padding .container,
  .main-icon-bar-two_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-x);
    --cp-spacer-right: var(--xl-padding-x);
  }

  .main-icon-bar-two .btn .icon_cart-btns {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .main-icon-bar-two .btn .icon_cart-btns img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-icon-bar-two .title h2,
  .main-icon-bar-two .title h1,
  .main-icon-bar-two .title h3,
  .main-icon-bar-two .title p {
    font-size: var(--xl-heading-size);
    line-height: 110%;
    font-weight: 700;
    text-transform: var(--heading-transform);
    color: var(--text-color);
    margin: 0;
    text-align: var(--heading-align);
    margin: 0 0 8px 0;
  }
  .icon_bar_2 .heading {
    margin-bottom: 66px;
  }

  .main-icon-bar-two_content-wrapper {
    text-align: center;
    position: relative;
  }

  .main-icon-bar-two .heading {
    margin-bottom: 64px;
    text-align: var(--heading-align);
  }

  .main-icon-bar-two .subtitle * {
    margin: 0;
    color: var(--subtitle-color);
  }

  .main-icon-bar-two .subtitle h1,
  .main-icon-bar-two .subtitle h2,
  .main-icon-bar-two .subtitle h3,
  .main-icon-bar-two .subtitle p{
    font-size: 24px;
    font-weight: 500;
    line-height: 150%;
  }

  .main-icon-bar-two .icon-content-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 80px;
    border-radius: var(--w-radius);
    padding: var(--w-padding-y) var(--w-padding-x);
    background: var(--w-bg-color);
  }

  .main-icon-bar-two .icon_item {
    max-width: 315px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    justify-content: center;
  }

  .main-icon-bar-two .icon_item-img {
    max-width: 90px;
    width: 100%;
    margin: 0 auto;
  }

  .main-icon-bar-two .icon_item-img * {
    width: 100%;
    height: auto;
  }

  .main-icon-bar-two .icon_item-img svg {
    border-radius: 50%;
  }

  .main-icon-bar-two .icon_item h4 {
    font-weight: 500;
    font-size: 18px;
    line-height: 120%;
    letter-spacing: 0;
    text-align: center;
    margin: 0 0 6px;
  }

  .main-icon-bar-two p {
    font-weight: 400;
    font-size: 16px;
    line-height: 120%;
    letter-spacing: 0;
    text-align: center;
    margin: 0;
  }

  .main-icon-bar-two a {
    transition: all 0.3s ease;
  }

  .main-icon-bar-two a:hover {
    color: var(--color-bg-btn);
  }

  .main-icon-bar-two.title {
    margin-bottom: 0;
  }

  .main-icon-bar-two .icon-heading {
    font-size: 18px;
    line-height: 120%;
    font-weight: 500;
  }

  .main-icon-bar-two .icon_item h4 {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .main-icon-bar-two_wrapper {
      display: var(--xs-display-value);
    }

    .main-icon-bar-two .subtitle h1,
    .main-icon-bar-two .subtitle h2,
    .main-icon-bar-two .subtitle h3,
    .main-icon-bar-two .subtitle p{
      font-size: 20px;
      font-weight: 500;
      line-height: 150%;
    }

    .main-icon-bar-two .title h2,
    .main-icon-bar-two .title h1,
    .main-icon-bar-two .title h3,
    .main-icon-bar-two .title p {
      font-size: var(--xs-heading-size);
      line-height: 100%;
      margin-bottom: 0;
    }

    .main-icon-bar-two .heading {
      margin-bottom: 24px;
    }

    .icon_bar_2 .subtitle * {
      font-size: 20px;
      line-height: 120%;
      font-weight: 500;
    }

    .main-icon-bar-two .title {
      margin-bottom: 8px;
    }

    .main-icon-bar-two .icon-heading {
      font-size: 16px;
    }

    .outer-padding .main-icon-bar-two_container-wrapper:has(.container) {
      padding-left: var(--xs-padding-x);
      padding-right: var(--xs-padding-x);
    }

    .main-icon-bar-two_wrapper.inner-padding .container,
    .main-icon-bar-two_wrapper.outer-padding .container-fluid {
      --cp-spacer-left: var(--xs-padding-x);
      --cp-spacer-right: var(--xs-padding-x);
    }

    .main-icon-bar-two_container-wrapper {
      padding: var(--xs-padding-y) 0;
    }

    .main-icon-bar-two .icon-content-wrapper {
      gap: 44px;
      padding: var(--w-padding-xs-y) var(--w-padding-xs-x);
    }

    .main-icon-bar-two .icon_item {
      max-width: 305px;
      gap: 24px;
    }

    .main-icon-bar-two .icon_item-img {
      max-width: 70px;
    }

    .main-icon-bar-two .icon_item h4 {
      font-size: 18px;
      line-height: 21.94px;
    }

    .main-icon-bar-two p {
      font-size: 14px;
    }

    .main-icon-bar-two .icon_item-img {
      max-width: 70px;
    }

    .main-icon-bar-two .icon_item h4 {
      font-size: 18px;
      line-height: 21.94px;
    }

    .icon_bar_w .wrapp_icon {
      gap: 44px !important;
    }
  }
{%- endstylesheet -%}

<div
  class="{{  section_prefix_class }}_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  style="
    {% if section.settings.settging_btn == 'global' %}
      --btn-border-radius: {{ settings.button_radius }}px;
      --btn-border: {{ settings.button_border_size }}px solid {{ settings.button_color_border }};
      --btn-color: {{ settings.button_text_color }};
      --btn-background: {{ settings.button_color }};
    {% else %}
      --btn-border-radius: {{ section.settings.button_radius }}px;
      --btn-border: {{ section.settings.button_border_size }}px solid {{ section.settings.button_border_color }};
      --btn-color: {{ section.settings.button_text_color }};
      --btn-background: {{ section.settings.button_color }};
    {% endif %}
    {% if section.settings.w-padding_y_mob %}
      --w-padding-xs-y: {{ section.settings.w-padding_y_mob }}px;
    {%  else %}
      --w-padding-xs-y: 25px;
    {% endif %}
    {% if section.settings.w-padding_x_mob %}
      --w-padding-xs-x: {{ section.settings.w-padding_x_mob }}px;
    {%  else %}
      --w-padding-xs-x: px;
    {% endif %}
    --w-bg-color: {{ section.settings.icon_background_w }};
    --w-padding-x: {{ section.settings.w-padding_x_desk }}px;
    --w-padding-y: {{ section.settings.w-padding_y_desk }}px;
    --w-radius: {{ section.settings.w_radius }}px;
    --icn-color: {{ section.settings.icon_color }};
    --subtitle-color: {{ section.settings.subtitle_color }};
    --heading-transform: {{ section.settings.headline_typography }};
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xl-heading-size: 28px;
      {% when 'medium' %}
      --xl-heading-size: 40px;
      {% when 'large' %}
      --xl-heading-size: 48px;
    {% endcase %}
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xs-heading-size: 20px;
      {% when 'medium' %}
      --xs-heading-size: 32px;
      {% when 'large' %}
      --xs-heading-size: 32px;
    {% endcase %}
    {% case section.settings.heading_align %}
      {% when 'left' %}
      --heading-align: left;
      {% when 'center' %}
      --heading-align: center;
      {% when 'right' %}
      --heading-align: right;
    {% endcase %}
    {% if section.settings.section_width == 'full' %}
    --width-value: 100%;
    {% else %}
    --width-value: {{ settings.page_width }}px;
    {% endif %}
    --text-color: {{ section.settings.text_color }};
    --bg-color: {{ section.settings.background_color }};
    --xl-padding-x: {{ section.settings.padding_x_desk }}px;
    --xl-padding-y: {{ section.settings.padding_y_desk }}px;
    --xs-padding-x: {{ section.settings.padding_x_mob }}px;
    --xs-padding-y: {{ section.settings.padding_y_mob }}px;
    {% case section.settings.display_on %}
      {% when 'all' %}
        --xs-display-value: block;
      {% when 'mobile_only' %}
        --xs-display-value: block;
      {% when 'desktop_only' %}
        --xs-display-value: none;
    {% endcase %}
    {% case section.settings.display_on %}
      {% when 'all' %}
        --display-value: block;
      {% when 'mobile_only' %}
        --display-value: none;
      {% when 'desktop_only' %}
        --display-value: block;
    {% endcase %}
  "
>
  <div
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="      --custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_width }}">
      <div class="{{ section_prefix_class }}_content-wrapper">
        {%- if section.settings.title != blank or section.settings.under_title_text != blank -%}
          <div class="heading word--break">
            <div class="title word--break">
              {%- if section.settings.title != blank -%}
                {{ section.settings.title }}
              {%- endif -%}
            </div>
            <div class="subtitle word--break">
              {%- if section.settings.subtitle != blank -%}
                {{ section.settings.subtitle }}
              {%- endif -%}
            </div>
            {% if section.settings.btn != blank %}
              <div class="wbtn word--break">
                <a
                  {% if section.settings.btn_url != blank %}
                    href="{{ section.settings.btn_url }}"
                  {% endif %}
                  class="btn"
                >
                  {{ section.settings.btn }}
                  {% if section.settings.show_arrow == true %}
                    {% if section.settings.icon != blank %}
                      <i class="icon_cart-btns">
                        {%- liquid
                          assign max_width = section.settings.icon.width
                          if section.settings.icon > 150
                            assign max_width = 150
                          endif
                          assign image_height = max_width | divided_by: section.settings.icon.aspect_ratio | round

                          capture image_alt
                            if section.settings.icon.alt != blank
                              echo section.settings.icon.alt
                            else
                              echo 'Icon' | escape
                            endif
                          endcapture
                        -%}
                        {{-
                          section.settings.icon
                          | image_url: width: max_width
                          | image_tag:
                            loading: 'lazy',
                            width: max_width,
                            height: image_height,
                            alt: image_alt,
                            class: ''
                        -}}
                      </i>
                    {% elsif section.settings.icon_alt != blank %}
                      <i class="icon_cart-btns material-symbols-outlined">
                        {{ section.settings.icon_alt }}
                      </i>
                    {% else %}
                      <i class="icon_cart-btns">
                        {% render 'icon_arrow_submit2' %}
                      </i>
                    {% endif %}
                  {% endif %}
                </a>
              </div>
            {% endif %}
          </div>
        {%- endif -%}

        <div class="icon-content-wrapper">
          {% for block in section.blocks %}
            {%- liquid
              assign placeholder_index = forloop.index | modulo: 4
              if placeholder_index == 0
                assign placeholder_index = 4
              endif
            -%}
            <div class="icon_item">
              <div class="icon_item-img">
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign max_width = block.settings.image.width
                    if block.settings.image > 80
                      assign max_width = 80
                    endif
                    assign image_height = max_width | divided_by: block.settings.image.aspect_ratio | round

                    capture image_alt
                      if block.settings.image.alt != blank
                        echo block.settings.image.alt
                      elsif block.settings.after_image.alt == blank
                        echo 'Icon'
                      else
                        echo block.settings.title
                      endif
                    endcapture
                  -%}
                  {{-
                    block.settings.image
                    | image_url: width: max_width
                    | image_tag: loading: 'lazy', width: max_width, height: image_height, alt: image_alt, class: ''
                  -}}
                {%- else -%}
                  {%- render 'placeholder-svgs', type: 'product', index: placeholder_index, class: '' -%}
                {%- endif -%}
              </div>
              <div class="icon_item-info word--break" style="color: {{ section.settings.icon_color }};">
                <h4>{{ block.settings.title }}</h4>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon Bar 2",
  "tag": "section",
  "class": "section icon_bar_2 main-icon-bar-two",
  "settings": [
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<h2>Why thousands of people choose us</h2>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<h3>Experience the [benefit] with our trusted products and support.</h3>"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "select",
      "id": "settging_btn",
      "label": "Settings",
      "options": [
        { "value": "global", "label": "Global" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "global"
    },
    {
      "type": "text",
      "id": "btn",
      "label": "Button text",
      "default": "[Direct CTA encouraging action]"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Button Icon image"
    },
    {
      "type": "text",
      "id": "icon_alt",
      "label": "Button Google Icon"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow button",
      "default": false
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_border_size",
      "label": "Button Border Size",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button Corner Radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 50
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#000"
    },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Button Text Color", "default": "#ffffff" },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "headline_typography",
      "label": "Headline Typography",
      "options": [
        {
          "value": "uppercase",
          "label": "AA"
        },
        {
          "value": "capitalize",
          "label": "Aa"
        },
        {
          "value": "lowercase",
          "label": "aa"
        }
      ],
      "default": "capitalize"
    },
    {
      "type": "select",
      "id": "font_variant",
      "label": "Font Family",
      "options": [
        {
          "value": "default",
          "label": "Default by theme"
        },
        {
          "value": "custom",
          "label": "Own choice"
        }
      ],
      "default": "default"
    },
    {
      "type": "font_picker",
      "label": "Regular Font",
      "id": "title_font",
      "default": "montserrat_n4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
