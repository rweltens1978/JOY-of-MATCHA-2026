{%- liquid
  assign section_prefix_class = 'main-collection-grid'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}
<style>
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    .main-collection-grid :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
  {% endif %}
</style>
{%- stylesheet -%}
  .main-collection-grid .collection-grid {
    --section-padding-top: var(--xs-padding-top);
    --section-padding-bottom: var(--xs-padding-bottom);
    --section-padding-left: var(--xs-padding-left);
    --section-padding-right: var(--xs-padding-right);
    display: var(--display-value);
  }

  .main-collection-grid_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .main-collection-grid_container-wrapper {
    padding-top: var(--xl-padding-top);
    padding-bottom: var(--xl-padding-bottom);
    padding-left: 0;
    padding-right: 0;
  }

  .inner-padding .main-collection-grid_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .main-collection-grid_container-wrapper {
    background: var(--background-color);
  }

  .main-collection-grid_wrapper.inner-padding .container {
    background: var(--background-color);
  }

  .main-collection-grid .collection-grid-items {
    color: var(--card-text-color);
  }

  .main-collection-grid_wrapper.outer-padding .container,
  .main-collection-grid_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .main-collection-grid_container-wrapper:has(.container-fluid),
  .outer-padding .main-collection-grid_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-left);
    padding-right: var(--xl-padding-right);
  }

  .main-collection-grid_wrapper.inner-padding .container {
    --cp-spacer-left: var(--xl-padding-left);
    --cp-spacer-right: var(--xl-padding-right);
  }

  .main-collection-grid .collection-info-title,
  .collection-grid .collection-cta-btn {
    transition: all 0.3s ease;
  }

  .collection-grid .collection-cta-btn:hover {
    color: var(--color-bg-btn) !important;
  }

  .main-collection-grid .collection-grid-wrapper {
    text-align: var(--text-alignment);
  }

  /* .main-collection-grid .title {
    font-size: 36px;
    line-height: 1.1;
    font-weight: 400;
    margin-bottom: 15px;
  } */

  .main-collection-grid .title h2,
  .main-collection-grid .title h3,
  .main-collection-grid .title h1,
  .main-collection-grid .title p {
    font-weight: 600;
    line-height: 100%;
    font-size: var(--heading-font-size);
    color: var(--text-color);
    margin-bottom: 20px;
  }

  .main-collection-grid .subtitle p,
  .main-collection-grid .subtitle h1,
  .main-collection-grid .subtitle h2,
  .main-collection-grid .subtitle h3 {
    font-size: var(--font-size);
    font-weight: 500;
    line-height: 120%;
  }

  .main-collection-grid .subtitle {
    text-wrap: balance;
    color: var(--text-color);
  }

  .main-collection-grid .title,
  .main-collection-grid .subtitle {
    text-transform: var(--text-transform);
    text-align: var(--text-align);
  }

  .collection-grid .collection-img {
    width: 100%;
    object-fit: cover;
    border-radius: inherit;
    height: 100%;
  }

  .collection-grid-header .subtitle {
    margin-bottom: 32px;
    /* font-size: 18px; */
    /* font-weight: 400; */
  }

  .collection-item {
    position: relative;
    background-color: #ebebeb;
    margin: 0px 20px 70px 20px;
  }

  .collection-item a,
  .collection-item {
    border-radius: var(--collection-item-radius);
  }

  .collection-item.media-empty,
  .collection-item.not-overlay-text {
    background-color: transparent;
  }

  .collection-item.media-empty img {
    height: auto;
    width: 100%;
    border-radius: inherit;
  }

  .collection-item.overlay_image,
  .collection-item.not-overlay-text {
    margin: 0;
    width: 100%;
  }

  .collection-item a {
    line-height: 0;
    position: relative;
    display: block;
    text-decoration: none;
  }

  .collection-item-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 10px;
  }

  .overlay_image .collection-item-info {
    position: absolute;
    bottom: 5%;
    left: 50%;
    text-align: left;
    transform: translateX(-50%);
    width: 100%;
    padding: 0px 40px;
  }

  .collection-info-title {
    margin: 0;
    font-size: 20px;
    line-height: 120%;
    letter-spacing: 0;
    text-transform: capitalize;
    font-weight: 500;
    font-family: 'Material Medium';
    text-decoration: none;
  }

  .collection-grid .collection-cta-btn {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0;
    text-transform: uppercase;
    text-decoration: underline;
  }

  .collection-item-info svg {
    min-height: 40px;
    min-width: 40px;
    max-height: 40px;
    max-width: 40px;
  }

  .collection-grid-cta {
    margin-top: 64px;
  }

  .collection-cta-btn {
    color: var(--btnlink_color);
  }

  @media screen and (min-width: 576px) {
    .collection-item.overlay_image,
    .collection-item.not-overlay-text {
      margin: 0;
      width: calc(50% - 19px);
    }

    .collection-grid-header .title h2,
    .collection-grid-header .title h3,
    .collection-grid-header .title h1,
    .collection-grid-header .title p {
      margin-bottom: 24px !important;
    }

    .collection-grid-header .subtitle {
      margin-bottom: 64px;
    }

    .collection-grid-items {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      column-gap: 28px;
      row-gap: 80px;
    }

    .collection-grid-items:has(.collection-item.overlay_image),
    .collection-grid-items:has(.collection-item.not-overlay-text) {
      row-gap: 40px;
    }

    .collection-item {
      margin: 0;
    }
  }

  @media (min-width: 768px) {
    .collection-item.overlay_image,
    .collection-item.not-overlay-text {
      margin: 0;
      width: calc(33.33% - 19px);
    }
  }

  @media screen and (max-width: 767px) {
    .main-collection-grid .collection-grid {
      display: var(--xs-display-value);
    }

    .main-collection-grid .subtitle p,
    .main-collection-grid .subtitle h1,
    .main-collection-grid .subtitle h2,
    .main-collection-grid .subtitle h3 {
      font-size: var(--xs-font-size);
      line-height: 120%;
    }

    .main-collection-grid .collection-item {
      margin-bottom: 22px;
    }

    .main-collection-grid .collection-item:last-child {
      margin-bottom: 0;
    }

    .outer-padding .main-collection-grid_container-wrapper:has(.container-fluid),
    .outer-padding .main-collection-grid_container-wrapper:has(.container) {
      padding-left: var(--xs-padding-left);
      padding-right: var(--xs-padding-right);
    }

    .main-collection-grid_wrapper.inner-padding .container {
      --cp-spacer-left: var(--xs-padding-left);
      --cp-spacer-right: var(--xs-padding-right);
    }

    .main-collection-grid_container-wrapper {
      padding-top: var(--xs-padding-top);
      padding-bottom: var(--xs-padding-bottom);
      padding-left: 0;
      padding-right: 0;
    }

    .main-collection-grid .title h2,
    .main-collection-grid .title h3,
    .main-collection-grid .title h1,
    .main-collection-grid .title p {
      font-weight: 600;
      line-height: 100%;
      font-size: var(--heading-xs-font-size);
    }
  }
{%- endstylesheet -%}

<section
  class="collection-grid {{ section_prefix_class }}_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  style="
    --xs-padding-top: {{ section.settings.mobile_padding_top }}px;
    --xs-padding-bottom: {{ section.settings.mobile_padding_bottom }}px ;
    --xs-padding-left: {{ section.settings.mobile_padding_left }}px;
    --xs-padding-right: {{ section.settings.mobile_padding_right }}px;
    --xl-padding-top: {{ section.settings.desktop_padding_top }}px;
    --xl-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --xl-padding-left: {{ section.settings.desktop_padding_left }}px;
    --xl-padding-right: {{ section.settings.desktop_padding_right }}px;
    --background-color: {{ section.settings.background_color }};
    --card-text-color: {{ section.settings.card_text_color }};
    --collection-item-radius: {{ section.settings.collection_item_radius }}px;
    --btnlink_color: {{ section.settings.btnlink_color }};
    --arrow_color: {{ section.settings.arrow_color }};
    --arrow_bg_color: {{ section.settings.arrow_bg_color }};
    {% case section.settings.display_on %}
      {% when 'all' %}
        --display-value: block;
      {% when 'mobile_only' %}
        --display-value: none;
      {% when 'desktop_only' %}
        --display-value: block;
    {% endcase %}
    {% case section.settings.display_on %}
      {% when 'all' %}
        --xs-display-value: block;
      {% when 'mobile_only' %}
        --xs-display-value: block;
      {% when 'desktop_only' %}
        --xs-display-value: none;
    {% endcase %}
  "
>
  <div
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="      --custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_width }}">
      <div
        class="collection-grid-wrapper {{ section_prefix_class }}_content-wrapper"
        style="        --text-alignment: {{ section.settings.heading_align }};"
      >
        <div class="collection-grid-header">
          {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
            <div
              class="heading"
              style="
                {% case section.settings.heading_align %}
                  {% when 'left' %}
                  --text-align: left;
                  {% when 'center' %}
                  --text-align: center;
                  {% when 'right' %}
                  --text-align: right;
                {% endcase %};
                --text-transform: {{ section.settings.headline_typography }};
              "
            >
              {%- if section.settings.title != blank -%}
                <div
                  class="title word--break"
                  style="
                    {% case section.settings.heading_size %}
                      {% when 'small' %}
                        --heading-font-size: 28px;
                      {% when 'medium' %}
                        --heading-font-size: 40px;
                      {% when 'large' %}
                        --heading-font-size: 48px;
                    {% endcase %};
                    {% case section.settings.heading_size %}
                      {% when 'small' %}
                        --heading-xs-font-size: 20px;
                      {% when 'medium' %}
                        --heading-xs-font-size: 32px;
                      {% when 'large' %}
                        --heading-xs-font-size: 32px;
                    {% endcase %};
                    --text-color: {{ section.settings.text_color }};
                  "
                >
                  {{ section.settings.title }}
                </div>
              {%- endif -%}
              {%- if section.settings.subtitle != blank -%}
                <div
                  class="subtitle word--break"
                  style="
                    {% case section.settings.subheading_size %}
                      {% when 'small' %}
                      --font-size: 16px;
                      {% when 'medium' %}
                      --font-size: 20px;
                      {% when 'large' %}
                      --font-size: 24px;
                    {% endcase %};
                    {% case section.settings.subheading_size %}
                      {% when 'small' %}
                      --xs-font-size: 12px;
                      {% when 'medium' %}
                      --xs-font-size: 16px;
                      {% when 'large' %}
                      --xs-font-size: 20px;
                    {% endcase %};
                    --text-color: {{ section.settings.subtext_color }};
                  "
                >
                  {{ section.settings.subtitle }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        <div class="collection-grid-items">
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection = block.settings.collection
              capture collection_title
                unless collection.title == blank
                  echo collection.title
                else
                  echo 'image_alternative.static' | t
                endunless
              endcapture

              capture loading_attr
                if section.index < 3
                  if forloop.index == 1
                    echo 'eager'
                  else
                    echo 'lazy'
                  endif
                else
                  echo 'lazy'
                endif
              endcapture
            -%}
            <div class="collection-item {% if block.settings.custom_image == blank %}media-empty {% endif %}{% if section.settings.overlay_image %} overlay_image{% else %}not-overlay-text{% endif %}">
              <a
                {% if collection != blank %}
                  href="{{ collection.url }}"
                {% endif %}
              >
                {% if block.settings.custom_image != blank %}
                  {%- liquid
                    assign max_width = block.settings.custom_image.width
                    if block.settings.custom_image > 714
                      assign max_width = 714
                    endif
                    assign image_height = max_width | divided_by: block.settings.custom_image.aspect_ratio | round

                    capture image_alt
                      unless block.settings.custom_image.alt == blank
                        echo block.settings.custom_image.alt
                      else
                        echo collection_title | escape
                      endunless
                    endcapture
                  -%}
                  {{-
                    block.settings.custom_image
                    | image_url: width: max_width
                    | image_tag:
                      loading: loading_attr,
                      width: max_width,
                      sizes: '(max-width: 767px) calc(100vw - 80px), (max-width: 1199px) calc((100vw / 3) - 80px), 24.271vw',
                      height: image_height,
                      alt: image_alt,
                      class: 'collection-img'
                  -}}
                {%- elsif collection.title != blank and collection.featured_image != blank -%}
                  {%- liquid
                    assign max_width = collection.featured_image.width
                    if collection.featured_image > 714
                      assign max_width = 714
                    endif
                    assign image_height = max_width | divided_by: collection.featured_image.aspect_ratio | round

                    capture image_alt
                      unless collection.featured_image.alt == blank
                        echo collection.featured_image.alt
                      else
                        echo collection_title | escape
                      endunless
                    endcapture
                  -%}
                  {{-
                    collection.featured_image
                    | image_url: width: max_width
                    | image_tag:
                      loading: loading_attr,
                      width: max_width,
                      sizes: '(max-width: 767px) calc(100vw - 80px), (max-width: 1199px) calc((100vw / 3) - 80px), 24.271vw',
                      height: image_height,
                      alt: image_alt,
                      class: 'collection-img'
                  -}}
                {% else %}
                  {%- render 'placeholder-svgs', type: 'hero', index: forloop.index, class: 'collection-img' -%}
                {% endif %}

                <div class="collection-item-info">
                  <h3 class="collection-info-title" style="color:{{ block.settings.title_color }}">
                    {% if collection != blank %}
                      {{ collection.title }}
                    {% else %}
                      Collection Name
                    {% endif %}
                  </h3>
                  {%- if section.settings.hide_arrow -%}
                    {% render 'icons',
                      arrow_color: section.settings.arrow_color,
                      arrow_bg_color: section.settings.arrow_bg_color,
                      icon_name: 'right-arrow'
                    %}
                  {%- endif -%}
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
        {% if section.settings.btnlink != blank %}
          <div class="collection-grid-cta">
            <a href="{{ section.settings.btnlink }}" class="collection-cta-btn">
              {{- 'custom_section.collection_grid.cta_btn' | t -}}
            </a>
          </div>
        {% else %}
          <div class="collection-grid-cta">
            <a href="/collections/all" class="collection-cta-btn">
              {{- 'custom_section.collection_grid.cta_btn' | t -}}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "class": "main-collection-grid",
  "settings": [
    {
      "type": "header",
      "content": "Heading & Subheading"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<h2>shop by collection</h2>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Choose your favourite product type</p>"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Sub Title Color",
      "default": "#696969"
    },
    {
      "type": "header",
      "content": "Design Options"
    },
    {
      "type": "checkbox",
      "id": "overlay_image",
      "label": "Show text on image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_arrow",
      "label": "Show Arrow",
      "default": true
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow Color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow Background Color",
      "default": "#000"
    },
    {
      "type": "url",
      "id": "btnlink",
      "label": "View All Button Link"
    },
    {
      "type": "color",
      "id": "btnlink_color",
      "label": "View all button link color",
      "default": "#000"
    },
    {
      "type": "header",
      "content": "Layout & General Settings"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "contained-content",
          "label": "Contained content"
        },
        {
          "value": "container-fluid",
          "label": "Edge to edge"
        }
      ],
      "default": "contained-content"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_width",
      "label": "Enable custom page width",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_page_width",
      "label": "Custom page width",
      "min": 1292,
      "max": 1600,
      "step": 4,
      "default": 1472,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_width }}"
    },
    {
      "type": "range",
      "id": "collection_item_radius",
      "label": "Collection card radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "display_on",
      "label": "Display On",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile_only",
          "label": "Mobile Only"
        },
        {
          "value": "desktop_only",
          "label": "Desktop Only"
        }
      ],
      "default": "all"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_variant",
      "label": "Font Family",
      "options": [
        {
          "value": "default",
          "label": "Default by theme"
        },
        {
          "value": "custom",
          "label": "Own choice"
        }
      ],
      "default": "default"
    },
    {
      "type": "font_picker",
      "label": "Custom Font (if selected)",
      "id": "title_font",
      "default": "montserrat_n4"
    },
    {
      "type": "select",
      "id": "headline_typography",
      "label": "Headline Text Style",
      "options": [
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        }
      ],
      "default": "capitalize"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Sub-Heading Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Spacing Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 90
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "label": "Desktop padding left",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "label": "Desktop padding right",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
