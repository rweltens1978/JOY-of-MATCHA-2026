      "label": "Compamy Logo 1"
    },
    {
      "type": "text",
      "id": "company_name2",
      "label": "Company Name #2"
    },
    {
      "type": "image_picker",
      "id": "logo2",
      "label": "Compamy Logo 2"
    },
    {
      "type": "text",
      "id": "company_name3",
      "label": "Company Name #3"
    },
    {
      "type": "image_picker",
      "id": "logo3",
      "label": "Compamy Logo 3"
    },
    {
      "type": "text",
      "id": "company_name4",
      "label": "Company Name #4"
    },
    {
      "type": "image_picker",
      "id": "logo4",
      "label": "Compamy Logo 4"
    },
    {
      "type": "text",
      "id": "company_name5",
      "label": "Company Name #5"
    },
    {
      "type": "image_picker",
      "id": "logo5",
      "label": "Compamy Logo 5"
    },
    {
      "type": "text",
      "id": "company_name6",
      "label": "Company Name #6"
    },
    {
      "type": "image_picker",
      "id": "logo6",
      "label": "Compamy Logo 6"
    },
    {
      "type": "header",
      "content": "Icon settings"
    },
    {
      "type": "image_picker",
      "id": "icon_cross",
      "label": "Icon cross"
    },
    {
      "type": "image_picker",
      "id": "icon_check",
      "label": "Icon check"
    },
    {
      "type": "color",
      "id": "icon_check_color",
      "label": "Icon Check Color",
      "default": "#0CF681"
    },
    {
      "type": "color",
      "id": "icon_cross_color",
      "label": "Icon Cross Color",
      "default": "#CC4C4C"
    }
  ],
  "blocks": [
    {
      "type": "company",
      "name": "Company Column",
      "settings": [
        {
          "type": "header",
          "content": "Key Feature settings"
        },
