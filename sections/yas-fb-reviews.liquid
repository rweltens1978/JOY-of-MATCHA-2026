{%- liquid
  assign section_prefix_class = 'main-fb-reviews'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}
<style>
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .main-fb-reviews :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
  {% endif %}
</style>
{%- stylesheet -%}
  .main-fb-reviews_content-wrapper a p {
    color: var(--text-color);
    cursor: pointer;
  }

  .main-fb-reviews a{
    transition: all 0.3s ease;
  }

  .main-fb-reviews a:hover{
    color: var(--color-bg-btn);
  }

  .main-fb-reviews .main-fb-reviews_wrapper{
    display: var(--display-value);
    text-align: var(--heading-align);
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }

  .main-fb-reviews_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .main-fb-reviews_container-wrapper {
    padding: var(--xl-padding-y) 0;
  }

  .inner-padding .main-fb-reviews_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .main-fb-reviews_container-wrapper {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-fb-reviews_wrapper.inner-padding .container {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-fb-reviews_wrapper.outer-padding .container {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .main-fb-reviews_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-x);
    padding-right: var(--xl-padding-x);
  }

  .main-fb-reviews_wrapper.inner-padding .container,
  .main-fb-reviews_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-x);
    --cp-spacer-right: var(--xl-padding-x);
  }

  .main-fb-reviews_content-wrapper { display: block; position: relative; text-align: var(--heading-align); }

  .main-fb-reviews .title h1,
  .main-fb-reviews .title h2,
  .main-fb-reviews .title h3,
  .main-fb-reviews .title p {
    font-size: var(--xl-heading-size);
    text-transform: var(--heading-transform);
    color: var(--title-color);
    margin: 0;
    text-align: var(--heading-align);
    line-height: 110%;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .main-fb-reviews .subtitle h2,
  .main-fb-reviews .subtitle h3,
  .main-fb-reviews .subtitle h1,
  .main-fb-reviews .subtitle p {
    color: var(--subtitle-color);
    font-size: 24px;
    font-weight: 500;
    text-align: var(--heading-align);
    line-height: 150%;
    margin: 0;
    margin-bottom: 20px;
  }

  .main-fb-reviews .uppertitle {
    display: flex;
    justify-content: var(--heading-justify);
    align-items: center;
    margin: 0;
    margin-bottom: 14.5px;
  }

  .main-fb-reviews .uppertitle svg path { fill: var(--fill); }
  .main-fb-reviews .uppertitle .star_span { display: flex; align-items: center; margin-right: 8px; }
  .main-fb-reviews .uppertitle h2,
  .main-fb-reviews .uppertitle h3,
  .main-fb-reviews .uppertitle p {
    color: var(--upper-title);
    font-size: 16px;
    font-weight: 400;
    line-height: 120%;
    margin: 0;
  }

  .main-fb-reviews .slider-container { display: flex; flex-direction: column; align-items: center; gap: 15px; }
  .main-fb-reviews .carousel-wrapper { width: 100%; margin: 0 auto; padding: 100px 0 25px; overflow: hidden; position: relative; }
  .main-fb-reviews .carousel { display: flex; align-items: center; justify-content: flex-start; gap: 24px; position: relative; width: 100%; transition: transform 0.5s ease; padding: 0 40px; }

  .main-fb-reviews .carousel .carousel-item {
    flex: 0 0 auto;
    width: 404px;
    /* height: 383px; */
    background-color: var(--card-bg);
    border: var(--border-solid);
    border-radius: var(--bdr-radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    box-shadow: var(--box-shadow);
    color: var(--body-color);
  }
  .main-fb-reviews .carousel .carousel-item .top-slide-content img { width: 60px; height: 60px; }
  .main-fb-reviews .carousel .carousel-item .top-slide-content .dots { width: 20px; height: 20px; }
  .main-fb-reviews .carousel .carousel-item .imgslide { width: 100%; height: auto; border-radius: 10px; object-fit: cover; margin: 0; }
  .main-fb-reviews .carousel .carousel-item .rating { color: #f4a261; font-size: 12px; margin: 0; width: 160px; margin-left: 13px; text-align: left; height: 13px; }
  .main-fb-reviews .carousel .carousel-item .name { font-weight: bold; font-size: 16px; line-height: 20px; margin: 0; width: 160px; margin-left: 13px; margin-bottom: 5px; text-align: left; }
  .main-fb-reviews .carousel .carousel-item .status { color: var(--status-color); font-size: 12px; line-height: 20px; margin: 0; width: 160px; margin-left: 13px; margin-bottom: 5px; text-align: left; }
  .main-fb-reviews .carousel .carousel-item p { font-size: 14px; line-height: 1.3; color: var(--body-color); margin: 0; flex-grow: 1; display: flex; text-align: left; 
  /* overflow: hidden;  */
  align-items: center; }
  .main-fb-reviews .fbicons { width: 16px; height: 16px; border-radius: 0; }
  .main-fb-reviews .carousel-nav .arrow { font-size: 20px; cursor: pointer; padding: 5px; border: 1px solid var(--swiper-navigation-color); color: var(--swiper-navigation-color); border-radius: 50%; transition: background-color 0.3s; width: 54px; line-height: normal; height: 54px; align-items: center; display: inline-flex; justify-content: center; }
  .main-fb-reviews .carousel-nav .dot.active { background: var(--bullet-active-color); }
  .main-fb-reviews .review-stats { display: flex; width: 100%; flex-wrap: nowrap; justify-content: space-between; }
  .main-fb-reviews .review-divider { border: 1px solid black; width: 100%; opacity: 0.25; }
  .main-fb-reviews .review-actions { display: flex; width: 100%; flex-wrap: nowrap; justify-content: center; gap: 40px; }
  .main-fb-reviews .action-item { display: flex; align-items: center; }
  .fb_carousel-pagination{
    display: flex;
    gap: 30px;
    align-items: center;
    flex-wrap: wrap;
  }

  .review-fb_smile svg{
    line-height: 0;
  }

  .review-fb_smile{
    display: flex;
    align-items: center;
    gap: 5px;
  }
 
  @media (max-width: 768px) {
    .main-fb-reviews .main-fb-reviews_wrapper{
      display: var(--xs-display-value);
    }

    .main-fb-reviews .subtitle h2,
    .main-fb-reviews .subtitle h3,
    .main-fb-reviews .subtitle h1,
    .main-fb-reviews .subtitle p {
      color: var(--subtitle-color);
      font-size: 20px;
      font-weight: 500;
    }

    .main-fb-reviews .carousel-nav{
      gap: 36px !important;
      flex-wrap: unset !important;
    }

    .fb_carousel-pagination{
      gap: 14px;
    }

    .outer-padding .main-fb-reviews_container-wrapper:has(.container) {
      padding-left: var(--xs-padding-x);
      padding-right: var(--xs-padding-x);
    }

    .main-fb-reviews_wrapper.inner-padding .container,
    .main-fb-reviews_wrapper.outer-padding .container-fluid {
      --cp-spacer-left: var(--xs-padding-x);
      --cp-spacer-right: var(--xs-padding-x);
    }

    .main-fb-reviews_container-wrapper {
      padding: var(--xs-padding-y) 0;
    }
    .main-fb-reviews .heading { margin: 0; padding: 0; }
    .main-fb-reviews .title h1,
    .main-fb-reviews .title h2,
    .main-fb-reviews .title h3,
    .main-fb-reviews .title p {
      font-size: var(--xs-heading-size);
      line-height: 100%;
      margin-bottom: 16px;
    }
    .main-fb-reviews .subtitle h2,
    .main-fb-reviews .subtitle h1,
    .main-fb-reviews .subtitle h3,
    .main-fb-reviews .subtitle p { font-size: 16px; line-height: 24px; }
    .main-fb-reviews .uppertitle h2,
    .main-fb-reviews .uppertitle h1,
    .main-fb-reviews .uppertitle h3,
    .main-fb-reviews .uppertitle p { font-size: 14px; }
    .main-fb-reviews .uppertitle { margin-bottom: 16px; }
    .main-fb-reviews .uppertitle svg { max-width: 12px; margin-left: 0; }
    .main-fb-reviews .carousel-wrapper { max-width: 100%; margin-top: 26px; padding-top: 0; padding-left: var(--xs-padding-x); }
    .main-fb-reviews .carousel { padding: 0; }
    .main-fb-reviews .carousel .carousel-item { 
      width: 350px; 
      /* height: 404px;  */
      gap: 20px; 
    }
    .main-fb-reviews .carousel .carousel-item .top-slide-content img { width: 50px; height: 50px; }
    .main-fb-reviews .carousel .carousel-item .rating { font-size: 13px; }
    .main-fb-reviews .carousel-nav .arrow { font-size: 16px; padding: 3px; width: 40px; height: 40px; }
    .main-fb-reviews .carousel-nav .dot { width: 7px; height: 7px; background: grey; }
    .main-fb-reviews .carousel-nav .dot.active { width: 12px; height: 12px; }
    .main-fb-reviews .swiper-b-next { width: 40px; height: 40px; }
    .main-fb-reviews .carousel-nav { margin-top: 40px; max-width: 340px; }
  }
{%- endstylesheet -%}

<div 
  class="{{ section_prefix_class }}_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  style="
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xs-heading-size: 20px;
      {% when 'medium' %}
      --xs-heading-size: 32px;
      {% when 'large' %}
      --xs-heading-size: 32px;
    {% endcase %}
    --status-color: {{ section.settings.status_color }};
    --body-color: {{ section.settings.body_color }};
    {% if section.settings.container_styling == "shadow" %}
      --box-shadow: {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_blur }}px {{ section.settings.box_shadow_spread }}px {{ section.settings.box_shadow_color }};
    {% else %}
      --box-shadow: none;
    {% endif %}
    --bdr-radius: {{ section.settings.container_radius }}px;
     --border-solid: {{ section.settings.card_border }}px solid {{ section.settings.card_border_color }};
     --title-color: {{ section.settings.title_color }};
    --card-bg: {{ section.settings.card_background }};
    --upper-title: {{ section.settings.uppertitle_color }};
    --fill: {{ section.settings.star_color }};
    {% case section.settings.heading_align %}
      {% when 'left' %}
      --heading-justify: flex-start;
      {% when 'center' %}
      --heading-justify: center;
      {% when 'right' %}
      --heading-justify: flex-end;
    {% endcase %}
    --subtitle-color: {{ section.settings.subtitle_color }};
    {% case section.settings.heading_align %}
      {% when 'left' %}
      --heading-align: left;
      {% when 'center' %}
      --heading-align: center;
      {% when 'right' %}
      --heading-align: right;
    {% endcase %}
    --heading-transform: {{ section.settings.headline_typography }};
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xl-heading-size: 28px;
      {% when 'medium' %}
      --xl-heading-size: 40px;
      {% when 'large' %}
      --xl-heading-size: 48px;
    {% endcase %}
    --heading-align: {{ section.settings.heading_align }};
    --bg-color: {{ section.settings.background_color }};
    --xl-padding-x: {{ section.settings.padding_x_desk }}px;
    --xl-padding-y: {{ section.settings.padding_y_desk }}px;
    --xs-padding-x: {{ section.settings.padding_x_mob }}px;
    --xs-padding-y: {{ section.settings.padding_y_mob }}px;
    {% case section.settings.display_on %}
      {% when 'all' %}
        --xs-display-value: block;
      {% when 'mobile_only' %}
        --xs-display-value: block;
      {% when 'desktop_only' %}
        --xs-display-value: none;
    {% endcase %}
    {% case section.settings.display_on %}
      {% when 'all' %}
        --display-value: block;
      {% when 'mobile_only' %}
        --display-value: none;
      {% when 'desktop_only' %}
        --display-value: block;
    {% endcase %}
    --text-color: {{ section.settings.text_color }};
  "
>
  <div 
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="
      --custom-width: {{ section.settings.custom_page_width }};
    "
  >
    <div class="{{ section_width }}">
      <div class="{{ section_prefix_class }}_content-wrapper">
        {%- if section.settings.uppertitle != blank or section.settings.subtitle or section.settings.title != blank -%}
          <div class="heading" style="
                {% if section.settings.section_width == 'container-fluid' %}
                  margin: 0 10%;
                {% endif %}"
          >
            {% if section.settings.uppertitle != blank %}
              <div class="uppertitle"><span class="star_span">{% for i in (1..5) %}{% render 'star_comparison' %}{% endfor %}</span>{{ section.settings.uppertitle }}</div>
            {% endif %}
            <div class="title">
              {%- if section.settings.title != blank -%}
                {{ section.settings.title }}
              {%- endif -%}
            </div>
            <div class="subtitle">
              {%- if section.settings.subtitle != blank -%}
                {{ section.settings.subtitle }}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        <div class="slider-container">
          <div class="carousel-wrapper">
            <div class="carousel" data-section-id="{{ section.id }}">
              {% for block in section.blocks %}
                {%- liquid 
                  assign placeholder_index = forloop.index | modulo: 4
                  if placeholder_index == 0
                    assign placeholder_index = 4
                  endif
                -%}
                <div class="carousel-item">
                  <div class="top-slide-content">
                    {% if block.settings.image != blank %}
                      {%- liquid
                        assign max_width = block.settings.image.width
                        if block.settings.image > 120
                            assign max_width = 120
                        endif
                        assign image_height = max_width | divided_by: block.settings.image.aspect_ratio | round

                        capture image_alt
                          if block.settings.image.alt != blank
                            echo block.settings.image.alt
                          else
                            echo block.settings.name
                          endif
                        endcapture

                        capture sizes_attr
                          echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 4.706vw'
                        endcapture
                      -%}
                      {{-
                        block.settings.image
                        | image_url: width: max_width
                        | image_tag: loading: 'lazy', width: max_width, height: image_height, sizes: sizes_attr, alt: image_alt, class: ''
                      -}}
                    {% else %}
                      {%- render 'placeholder-svgs', type: 'hero', index: placeholder_index, class: '' -%}
                    {% endif %}
                    <div>
                      <div class="name word--break">{{ block.settings.name }}</div>
                      <div class="status word--break">{{ block.settings.status }}</div>
                    </div>
                    <img class="dots" src="{{ 'dots.svg' | asset_url }}"/>
                  </div>
                    {{ block.settings.text | truncate: 480 }}
                  <div class="review-stats word--break">
                    <div class="review-fb_smile">
                      <svg xmlns="http://www.w3.org/2000/svg" width="50" height="20" viewBox="0 0 50 20" fill="none">
