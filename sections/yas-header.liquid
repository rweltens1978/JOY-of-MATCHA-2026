tColor"/>
              </svg>
              {%- if cart != empty -%}
                {% if cart.item_count > 0 %}
                  <div class="cart-count-bubble">
                    {%- if cart.item_count < 100 -%}
                      <span aria-hidden="true">{{ cart.item_count }}</span>
                    {%- endif -%}
                  </div>
                {% endif %}
              {%- endif -%}
            </button>
          {%- else -%}
            <a href="{{- routes.cart_url -}}" class="cart">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 17 15" fill="none">
                <path d="M6.75 13.5C6.75 13.7225 6.68402 13.94 6.5604 14.125C6.43679 14.31 6.26109 14.4542 6.05552 14.5394C5.84995 14.6245 5.62375 14.6468 5.40552 14.6034C5.18729 14.56 4.98684 14.4528 4.8295 14.2955C4.67217 14.1382 4.56502 13.9377 4.52162 13.7195C4.47821 13.5012 4.50049 13.275 4.58564 13.0695C4.67078 12.8639 4.81498 12.6882 4.99998 12.5646C5.18499 12.441 5.4025 12.375 5.625 12.375C5.92337 12.375 6.20952 12.4935 6.4205 12.7045C6.63147 12.9155 6.75 13.2016 6.75 13.5ZM12.9375 12.375C12.715 12.375 12.4975 12.441 12.3125 12.5646C12.1275 12.6882 11.9833 12.8639 11.8981 13.0695C11.813 13.275 11.7907 13.5012 11.8341 13.7195C11.8775 13.9377 11.9847 14.1382 12.142 14.2955C12.2993 14.4528 12.4998 14.56 12.718 14.6034C12.9363 14.6468 13.1625 14.6245 13.368 14.5394C13.5736 14.4542 13.7493 14.31 13.8729 14.125C13.9965 13.94 14.0625 13.7225 14.0625 13.5C14.0625 13.2016 13.944 12.9155 13.733 12.7045C13.522 12.4935 13.2359 12.375 12.9375 12.375ZM16.1297 3.52969L14.2734 10.0266C14.1715 10.3788 13.9581 10.6884 13.6652 10.909C13.3724 11.1296 13.0159 11.2492 12.6492 11.25H5.91328C5.54663 11.2492 5.19013 11.1296 4.89727 10.909C4.6044 10.6884 4.39099 10.3788 4.28906 10.0266L2.43281 3.53672V3.52266L1.74375 1.125H0.5625C0.413316 1.125 0.270242 1.06574 0.164752 0.960248C0.0592632 0.854758 0 0.711684 0 0.5625C0 0.413316 0.0592632 0.270242 0.164752 0.164752C0.270242 0.0592632 0.413316 0 0.5625 0H1.74375C1.98809 0.000885714 2.22558 0.0808022 2.42074 0.22781C2.61591 0.374818 2.75827 0.581025 2.82656 0.815625L3.39609 2.8125H15.5883C15.6754 2.81241 15.7614 2.83256 15.8394 2.87136C15.9174 2.91016 15.9853 2.96655 16.0378 3.03609C16.0903 3.10563 16.1259 3.18641 16.1419 3.27207C16.1578 3.35773 16.1536 3.44592 16.1297 3.52969ZM14.843 3.9375H3.71953L5.37188 9.71719C5.40551 9.83478 5.47656 9.93821 5.57425 10.0118C5.67195 10.0854 5.79097 10.1251 5.91328 10.125H12.6492C12.7715 10.1251 12.8905 10.0854 12.9882 10.0118C13.0859 9.93821 13.157 9.83478 13.1906 9.71719L14.843 3.9375Z" fill="currentColor"/>
              </svg>
              {%- if cart != empty -%}
                {% if cart.item_count > 0 %}
                  <div class="cart-count-bubble">
                    {%- if cart.item_count < 100 -%}
                      <span aria-hidden="true">{{ cart.item_count }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </a>
          {%- endunless -%}
        </div>
        <div
          class="sub_header"
          id="sub_header"
          aria-hidden="true"
          style="
            --hdr-h: 169px;
            --z-sticky: 9999;
            --z-overlay: 9997;
            --z-drawer: 9998;
            --logo-width-xl: {{ settings.logo_width | append: 'px' }};
            --logo-width-xs: {{ settings.logo_mobwidth | append: 'px' }};
          "
        >
          <div class="menu-top_header">
            <div class="menu-top_label word--break">Menu</div>
            <div class="menu-top_close">
              <button class="menu-burger-close" id="menu_close" aria-label="Close menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 28 28" fill="none">
                  <path d="M7.46732 22.1654L5.83398 20.532L12.3673 13.9987L5.83398 7.46536L7.46732 5.83203L14.0007 12.3654L20.534 5.83203L22.1673 7.46536L15.634 13.9987L22.1673 20.532L20.534 22.1654L14.0007 15.632L7.46732 22.1654Z" fill="black"/>
                </svg>
              </button>
              <a href=""></a>
            </div>
          </div>
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'slider' %}
                {% if block.settings.show_slider %}
                  {% if block.settings.product_list != blank %}
                    <div class="sub_header-slider">
                      <div class="title-slider">
                        {{ block.settings.title_slider }}
                        <span class="control_sub-header">
                          <div class="swiper-b-prev">{% render 'swiper-arrow-left-n' %}</div>
                          <div class="swiper-b-next">{% render 'swiper-arrow-right-n' %}</div>
                        </span>
                      </div>
                      <div class="product-list">
                        <div class="swiper swiper_menu">
                          <div class="swiper-wrapper">
                            {% for product in block.settings.product_list %}
                              {% if product %}
                                <div class="swiper-slide">
                                  <div class="product-item-s">
                                    <a href="{{ product.url }}">
                                      {% if product.featured_image %}
                                        {%- liquid
                                          assign max_width = product.featured_image.width
                                          if product.featured_image > 140
                                            assign max_width = 140
                                          endif
                                          assign image_height = max_width | divided_by: product.featured_image.aspect_ratio | round

                                          capture image_alt
                                            if product.featured_image.alt != blank
                                              echo product.featured_image.alt
                                            else
                                              echo product.title | escape
                                            endif
                                          endcapture

                                          capture sizes_attr
                                            echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 10.98vw'
                                          endcapture
                                        -%}
                                        {{-
                                          product.featured_image
                                          | image_url: width: max_width
                                          | image_tag:
                                            loading: 'lazy',
                                            width: max_width,
                                            height: image_height,
                                            sizes: sizes_attr,
                                            alt: image_alt,
                                            class: ''
                                        -}}
                                      {% else %}
                                        {%- render 'placeholder-svgs',
                                          type: 'product',
                                          index: placeholder_index,
                                          class: ''
                                        -%}
                                      {% endif %}
                                      {% if block.settings.show_reviews %}
                                        <div class="product-reviews">
                                          <span>
                                            {%- for i in (1..block.settings.star_count) -%}
                                              {% render 'review-stars' %}
                                            {%- endfor -%}
                                          </span>
                                          {{ block.settings.review_text }}
                                        </div>
                                      {% endif %}
                                      <h3>{{ product.title }}</h3>
                                      {%- assign variant = product.selected_or_first_available_variant -%}
                                      <span class="price">{{ variant.price | money }}</span>
                                    </a>
                                  </div>
                                </div>
                              {% endif %}
                            {% endfor %}
                          </div>
                        </div>
                      </div>
                    </div>
                  {% else %}
                    <div class="sub_header-slider">
                      <div class="title-slider">
                        {{ block.settings.title_slider }}
                        <span class="control_sub-header">
                          <div class="swiper-b-prev">{% render 'swiper-arrow-left-n' %}</div>
                          <div class="swiper-b-next">{% render 'swiper-arrow-right-n' %}</div>
                        </span>
                      </div>
                      <div class="product-list">
                        <div class="swiper swiper_menu">
                          <div class="swiper-wrapper">
                            {% for placeholder_block in (1..4) %}
                              <div class="swiper-slide">
                                <div class="product-item-s">
                                  <a>
                                    {%- render 'placeholder-svgs', type: 'hero', index: forloop.index, class: '' -%}
                                    {% if block.settings.show_reviews %}
                                      <div class="product-reviews">
                                        <span>
                                          {%- for i in (1..block.settings.star_count) -%}
                                            {% render 'review-stars' %}
                                          {%- endfor -%}
                                        </span>
                                        {{ block.settings.review_text }}
                                      </div>
                                    {% endif %}
                                    <h3>Product title</h3>
                                    <span class="price">$100</span>
                                  </a>
                                </div>
                              </div>
                            {% endfor %}
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {% when 'collection' %}
                {% if block.settings.show_collection %}
                  {% if block.settings.collection_list != blank %}
                    {% if block.settings.collection_styling == 'noporuduct' %}
                      <div class="sub_header-collection not-product-collection">
                        <div class="collection-list">
                          {% for collection in block.settings.collection_list limit: block.settings.limit %}
                            {%- liquid
                              assign placeholder_index = forloop.index | modulo: 4
                              if placeholder_index == 0
                                assign placeholder_index = 4
                              endif
                            -%}
                            {% if collection %}
                              <div class="collection-item">
                                <a href="{{ collection.url }}">
                                  {% if collection.image %}
                                    {%- liquid
                                      assign max_width = collection.image.width
                                      if collection.image > 140
                                        assign max_width = 140
                                      endif
                                      assign image_height = max_width | divided_by: collection.image.aspect_ratio | round

                                      capture image_alt
                                        if collection.image.alt != blank
                                          echo collection.image.alt
                                        else
                                          echo collection.title | escape
                                        endif
                                      endcapture

                                      capture sizes_attr
                                        echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 10.98vw'
                                      endcapture
                                    -%}
                                    {{-
                                      collection.image
                                      | image_url: width: max_width
                                      | image_tag:
                                        loading: 'lazy',
                                        width: max_width,
                                        height: image_height,
                                        sizes: sizes_attr,
                                        alt: image_alt,
                                        class: ''
                                    -}}
                                  {% else %}
                                    {%- render 'placeholder-svgs',
                                      type: 'collection',
                                      index: placeholder_index,
                                      class: ''
                                    -%}
                                  {% endif %}
                                  <div class="collection-content-box">
                                    <h3>{{ collection.title }}</h3>
                                    {%- if collection.description != blank
                                      and block.settings.collection_text == blank
                                    -%}
                                      <p>{{ collection.description | strip_html | truncate: 65 }}</p>
                                    {%- endif -%}
                                    {%- if block.settings.collection_text != blank -%}
                                      <p>{{ block.settings.collection_text }}</p>
                                    {%- endif -%}
                                  </div>
                                </a>
                              </div>
                            {% endif %}
                          {% endfor %}
                        </div>
                      </div>
                    {% else %}
                      <div class="sub_header-collection collection-toogle">
                        <div class="collection-list">
                          {% for collection in block.settings.collection_list limit: block.settings.limit %}
                            {%- liquid
                              assign placeholder_index = forloop.index | modulo: 4
                              if placeholder_index == 0
                                assign placeholder_index = 4
                              endif
                            -%}
                            {% if collection %}
                              <div class="collection-item" data-open="false">
                                <a
                                  href="{{ collection.url }}"
                                  class="collection-toggle"
                                  data-collection-toggle
                                  role="button"
                                  aria-expanded="false"
                                  aria-controls="listprod-{{ section.id }}-{{ forloop.index }}"
                                >
                                  {% if collection.image %}
                                    {%- liquid
                                      assign max_width = collection.image.width
                                      if collection.image > 140
                                        assign max_width = 140
                                      endif
                                      assign image_height = max_width | divided_by: collection.image.aspect_ratio | round

                                      capture image_alt
                                        if collection.image.alt != blank
                                          echo collection.image.alt
                                        else
                                          echo collection.title | escape
                                        endif
                                      endcapture

                                      capture sizes_attr
                                        echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 10.98vw'
                                      endcapture
                                    -%}
                                    {{-
                                      collection.image
