    justify-content: center;
  }
  .page-header .control_sub-header .swiper-button-disabled {
    opacity: 0.4;
  }
  .page-header .sub_header-slider .product-reviews {
    font-size: 10px;
    font-weight: 500;
    gap: 8px;
    color: var(--text-color);
  }
  .page-header .sub_header-slider .product-reviews span {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .page-header .sub_header-slider .product-reviews svg {
    width: 10px;
  }
  .page-header .sub_header-slider h3,
  body.no-scroll {
    overflow: hidden;
  }
  .page-header .sub_header-slider h3 {
    font-weight: 700;
    font-size: 14px;
    line-height: 100%;
    color: var(--text-color);
    margin: 12px 0;
    /* min-height: 28px; */
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .page-header .sub_header-slider span.price {
    font-weight: 700;
    font-size: 14px;
    line-height: 100%;
    text-align: center;
    color: var(--text-color);
  }
  body.no-scroll {
    touch-action: none;
  }
  .page-header_fixed-area {
    transition: box-shadow 0.3s ease;
  }
  .page-header--fixed .page-header_fixed-area {
    position: fixed;
    left: 0;
    z-index: 99999;
    width: 100%;
    background-color: var(--bg-color);
    box-shadow: 0 16px 24px rgba(0, 0, 0, 0.35);
  }
  .page-header--fixed [data-behavior='upwards'] .page-header_fixed-area {
    animation: header-upwards-animation 0.5s;
  }
  .page-header--fixed .page-header_fixed-area {
    top: 0;
  }
  .page-header_box {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: space-between;
    padding: var(--xl-padding-y) var(--xl-padding-x);
  }
  .menu-top_header {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 17px !important;
    border-bottom: 1px solid var(--mega-bdr-color);
    margin-bottom: 20px !important;
  }
  .menu-burger-close {
    border: 0;
    line-height: 0;
    padding: 0;
  }
  .menu-top_label {
    font-size: 16px;
    line-height: 120%;
    font-weight: 700;
  }
  .menu-top_label,
  .title-slider,
  .product-reviews h3,
  .collection-content-box h3,
  .custom-menu ul li a {
    text-transform: var(--menu-transform);
  }
  @media (max-width: 768px) {
    .header_w .logo img {
      width: var(--logo-width-xs);
    }
    .page-header--fixed .page-header_fixed-area {
      background-color: var(--mob-bg-color);
    }
    .page-header .sub_header,
    .page-header .sub_header .collection-item a {
      max-width: 100%;
    }
    .header_w,
    .page-header .sub_header {
      background-color: var(--mob-bg-color);
      color: var(--mob-text-color);
    }
    .page-header .sub_header-slider .product-reviews,
    .page-header .sub_header-slider h3,
    .page-header .sub_header-slider span.price,
    .page-header .sub_header .collection-item a h3,
    .collection-content-box p,
    .page-header .sub_header .sub_header-menu a {
      color: var(--mob-text-color);
    }
    .menu-burger-close svg path {
      fill: var(--mob-text-color);
    }
    .page-header_box {
      padding: var(--xs-padding-y) var(--xs-padding-x);
    }
  }
  @media (min-width: 998px) {
    .page-header_box {
      gap: 28px;
    }
    .header_wrap_navigate,
    .page-header .collection-item_product {
      gap: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-header .sub_header,
    .header_w .menu_burger span,
    .page-header .menu-overlay {
      transition: none;
    }
  }
{%- endstylesheet -%}
<div
  id="{{- section.id -}}"
  class="header_w {% if settings.enable_sticky_header %}header_w--sticky{% endif %} {% if section.settings.enable_logo_left %}header_w--logo-left{% endif %}"
  style="
    --hdr-h: 62px;
    --z-sticky: 9999;
    --z-overlay: 9997;
    --z-drawer: 9998;
    --logo-width-xl: {{ settings.logo_width | append: 'px' }};
    --logo-width-xs: {{ settings.logo_mobwidth | append: 'px' }};
    --bg-color: {{ section.settings.background_color }};
    --mob-bg-color: {{ section.settings.mob_background_color }};
    --text-color: {{ section.settings.text_color }};
    --mob-text-color: {{ section.settings.mob_text_color }};
    --menu-transform: {{ section.settings.mega_menu_typography }};
    --xs-padding-x: {{ section.settings.padding_x_mob }}px;
    --xs-padding-y: {{ section.settings.padding_y_mob }}px;
    --xl-padding-x: {{ section.settings.padding_x_desk }}px;
    --xl-padding-y: {{ section.settings.padding_y_desk }}px;
    --mega-bdr-color: {{ section.settings.mega_bdr_color }};
  "
>
  {%- unless settings.section_enable_sticky == 'none' -%}
    <sticky-block
      class="sticky-header-wrapper"
      data-ref-block=".page-header_fixed-area"
      data-body-class="page-header--fixed"
      data-revealed="false"
      data-behavior="{{- sticky_behavior -}}"
      data-spacer="true"
    >
  {%- endunless -%}
  <div
    class="page-header_fixed-area {% if section.settings.enable_custom_width %}page-header_custom-page-width{% endif %}"
    style="--custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_width }}">
      <div class="page-header_box">
        <div class="header_left">
          <button
            class="menu_burger"
            id="menu_burger"
            aria-label="Toggle menu"
            aria-controls="sub_header"
            aria-expanded="false"
          >
            <span></span><span></span><span></span>
          </button>
          <a href=""></a>
        </div>
        <a
          href="{{ routes.root_url }}"
          class="logo word--break"
        >
          {%- if settings.logo != blank -%}
            {%- liquid
              assign max_width = settings.logo.width
              if settings.logo > 100
                assign max_width = 100
              endif
              assign image_height = max_width | divided_by: settings.logo.aspect_ratio | round

              capture image_alt
                if settings.logo.alt != blank
                  echo settings.logo.alt
                else
                  echo shop.name | escape
                endif
              endcapture
            -%}
            {{-
              settings.logo
              | image_url: width: max_width
              | image_tag: loading: 'lazy', width: max_width, height: image_height, alt: image_alt, class: ''
            -}}
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </a>
        <div class="header_wrap_navigate">
          {%- if shop.customer_accounts_enabled -%}
            <div class="header__action-search">
              <a
                class="form-icon"
                {% unless customer %}
                  href="{{- routes.account_login_url -}}"
                {% else %}
                  href="{{- routes.account_url -}}"
                {% endunless %}
              >
                {%- unless customer -%}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="21"
                    height="21"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                  </svg>
                {%- else -%}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="21"
                    height="21"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                  </svg>
                {%- endunless -%}
              </a>
            </div>
          {%- endif -%}
          {% if section.settings.enable_search %}
            <div class="header__action-search" id="js-search-box">
              <button
                type="button"
                class="form-icon"
                id="js-search-toggle"
                aria-expanded="false"
                aria-controls="search-modal"
              >
                <span class="material-icons" aria-hidden="true">search</span>
              </button>
            </div>
          {% endif %}
          {%- unless template.name == 'cart' -%}
            <button class="cart js-cart-toggle" type="button" aria-label="Open cart">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 17 15" fill="none">
