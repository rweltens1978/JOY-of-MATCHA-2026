                                    {%- endif -%}
                                  </div>
                                  <span class="btn_collection-toogle" aria-hidden="true">+</span>
                                </div>
                              </a>
                              <div class="collection-item_listprod" id="listprod-{{ section.id }}-{{ forloop.index }}">
