                {%- when 'timeline' -%}
                  <div
                    class="lab-tested-section main-product_block-spacing"
                    style="--block-spacing: {{ block.settings.block_spacing | append: 'px' }}"
                    data-timeline-enabled="{{ block.settings.delivery_timeline_enabled }}"
                    {{ block.shopify_attributes }}
                  >
                    {% if block.settings.delivery_timeline_enabled %}
                      {% assign today = 'now' | date: '%s' %}

                      {% assign seconds_step_2 = block.settings.days_to_step_2 | times: 86400 %}
                      {% assign seconds_step_3 = block.settings.days_to_step_3 | times: 86400 %}

                      {% assign step_1_timestamp = today %}
                      {% assign step_2_timestamp = today | plus: seconds_step_2 %}
                      {% assign step_3_timestamp = today | plus: seconds_step_3 %}

                      {% assign step_1_date = step_1_timestamp | date: '%d %b %Y' %}
                      {% assign step_2_date = step_2_timestamp | date: '%d %b %Y' %}
                      {% assign step_3_date = step_3_timestamp | date: '%d %b %Y' %}
                    {% endif %}

                    {% for i in (1..3) %}
                      {% assign icon_key = 'icon_' | append: i %}
                      {% assign icon_alt_key = 'icon_' | append: i | append: '_alt' %}
                      {% assign text_key = 'text_' | append: i %}
                      {% assign image = block.settings[icon_key] %}
                      {% assign alt_icon = block.settings[icon_alt_key] %}

                      <div class="lab-tested-step-wrapper">
                        <div class="lab-tested-step">
                          <!-- ICON CIRCLE -->
                          <div class="lab-tested-circle-w">
                            <div class="lab-tested-circle" style="background: {{ block.settings.stroke_item }}">
                              <div class="lab-tested-inner" style="background: {{ block.settings.background_item }}">
                                {% if image != blank %}
                                  {%- liquid
                                    assign max_width = image.width
                                    if image > 150
                                      assign max_width = 150
                                    endif
                                    assign image_height = max_width | divided_by: image.aspect_ratio | round

                                    capture image_alt
                                      if image.alt != blank
                                        echo image.alt
                                      else
                                        echo 'Icon {{ i }}'
                                      endif
                                    endcapture
                                  -%}
                                  {{-
                                    image
                                    | image_url: width: max_width
                                    | image_tag:
                                      loading: 'lazy',
                                      width: max_width,
                                      height: image_height,
                                      alt: image_alt,
                                      class: ''
                                  -}}

                                {% elsif alt_icon contains 'material-icons' %}
                                  <span
                                    class="material-icons material-symbols-outlined"
                                    style="color: {{ block.settings.icon_item }}"
                                  >
                                    {{ alt_icon | remove: 'material-icons ' }}
                                  </span>

                                {% elsif alt_icon != blank %}
                                  {%- render 'placeholder-svgs', type: 'hero', index: 1, class: 'shopable-image' -%}

                                {% else %}
                                  <div class="placeholder-icon" style="color: {{ block.settings.icon_item }}"></div>
                                {% endif %}
                              </div>
                            </div>
                          </div>

                          <!-- TEXT BELOW ICON -->
                          <div class="lab-tested-text">
                            {% if block.settings.delivery_timeline_enabled %}
                              {%- case i -%}
                                {%- when 1 -%}
                                  {{ step_1_date }}
                                  <div class="timeline-mode-text">
                                    {{ block.settings.step_1_label }}
                                  </div>
                                {%- when 2 -%}
                                  {{ step_2_date }}
                                  <div class="timeline-mode-text">
                                    {{ block.settings.step_2_label }}
                                  </div>
                                {%- when 3 -%}
                                  {{ step_3_date }}
                                  <div class="timeline-mode-text">
                                    {{ block.settings.step_3_label }}
                                  </div>
                              {%- endcase -%}
                            {% else %}
                              {{ block.settings[text_key] | newline_to_br }}
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    {% endfor %}
