                {%- when 'size' -%}
                  <div
                    class="product-sizechart-content main-product_block-spacing"
                    style="--block-spacing: {{ block.settings.block_spacing | append: 'px' }}; background: {{ block.settings.background_color }};"
                    {{ block.shopify_attributes }}
                  >
                    <ul class="product-points-list">
                      <li>
                        {% if block.settings.icon_1 != blank %}
                          {%- liquid
                            assign max_width = block.settings.icon_1.width
                            if block.settings.icon_1 > 24
                              assign max_width = 24
                            endif
                            assign image_height = max_width | divided_by: block.settings.icon_1.aspect_ratio | round

                            capture image_alt
                              if block.settings.icon_1.alt != blank
                                echo block.settings.icon_1.alt
                              else
                                echo 'Icon 1'
                              endif
                            endcapture
                          -%}
                          {{-
                            block.settings.icon_1
                            | image_url: width: max_width
                            | image_tag:
                              loading: 'lazy',
                              width: max_width,
                              height: image_height,
                              alt: image_alt,
                              class: ''
                          -}}
                        {% elsif section.settings.icon_1_text != blank %}
                          <span class="material-symbols-outlined">{{ section.settings.icon_1_text }}</span>
                        {% endif %}
                        <span
                          id="sizechart-link-wrapper"
                          data-discount="{{ block.settings.discount }}"
                          data-success-message="{{ block.settings.discountsuc | escape }}"
                          data-redirect="{{ shop.url }}/discount/{{ block.settings.discount }}?redirect={{ request.path }}"
                        >
                          <a
                            onclick="event.preventDefault(); document.getElementById('sizechart-modal').style.display = 'flex';"
                            class="open-sizechart"
                            href="#"
                            style="
                              color: {{ block.settings.text_color }};
                              font-size: {% case block.settings.title_size %}
                                {% when 'small' %}20px
                                {% when 'medium' %}28px
                                {% when 'large' %}36px
                              {% endcase %};
                              font-weight: 700;
                              text-transform: {{ block.settings.title_format }};
                            "
                          >
                            {{ block.settings.title }}
                          </a>
                        </span>
                      </li>
                    </ul>
                    <div id="sizechart-modal" class="sizechart-modal">
                      <div class="sizechart-modal-backdrop"></div>
                      <div class="sizechart-modal-content">
                        <button class="sizechart-close" aria-label="Close popup">&times;</button>
                        {% if block.settings.image != blank %}
                          {%- liquid
                            assign max_width = block.settings.image.width
                            if block.settings.image > 1200
                              assign max_width = 1200
                            endif
                            assign image_height = max_width | divided_by: block.settings.image.aspect_ratio | round

                            capture image_alt
                              if block.settings.image.alt != blank
                                echo block.settings.image.alt
                              else
                                echo 'Size Chart'
                              endif
                            endcapture

                            capture sizes_attr
                              echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(50vw - 30px), (max-width: 1199px) 59.216vw'
                            endcapture
                          -%}
                          {{-
                            block.settings.image
                            | image_url: width: max_width
                            | image_tag:
                              loading: 'lazy',
                              width: max_width,
                              height: image_height,
                              sizes: sizes_attr,
                              alt: image_alt,
                              class: 'sizechart-image'
                          -}}
                        {% else %}
                          {%- render 'placeholder-svgs',
                            type: 'hero',
                            index: 1,
                            class: 'sizechart-image sizecahrt-placeholder'
                          -%}
                        {% endif %}
                      </div>
                    </div>
                    <div
                      id="sizechart-modal"
                      style="
                        display: none;
                        position: fixed;
                        top: 0; left: 0;
                        width: 100vw; height: 100vh;
                        background-color: rgba(0, 0, 0, 0.6);
                        z-index: 9999;
                        justify-content: center;
                        align-items: center;
                      "
                    >
                      <div
                        id="sizechart-modal-content"
                        style="
                          position: relative;
                          background: white;
                          padding: 20px;
                          max-width: 90vw;
                          max-height: 90vh;
                          overflow: auto;
                          border-radius: 8px;
                          box-shadow: 0 0 15px rgba(0,0,0,0.3);
                        "
                      >
                        <button
                          id="sizechart-close"
                          style="
                            position: absolute;
                            top: 10px;
                            right: 15px;
                            font-size: 28px;
                            background: none;
                            border: none;
                            cursor: pointer;
                          "
                        >
                          &times;
                        </button>
                        {% if block.settings.image != blank %}
                          {%- liquid
                            assign max_width = block.settings.image.width
                            if block.settings.image > 1200
                              assign max_width = 1200
                            endif
                            assign image_height = max_width | divided_by: block.settings.image.aspect_ratio | round

                            capture image_alt
                              if block.settings.image.alt != blank
                                echo block.settings.image.alt
                              else
                                echo 'Size Chart'
                              endif
                            endcapture

                            capture sizes_attr
                              echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(50vw - 30px), (max-width: 1199px) 59.216vw'
                            endcapture
                          -%}
                          {{-
                            block.settings.image
                            | image_url: width: max_width
                            | image_tag:
                              loading: 'lazy',
                              width: max_width,
                              height: image_height,
                              sizes: sizes_attr,
                              alt: image_alt,
                              class: 'sizechart-image'
                          -}}
                        {% else %}
                          {%- render 'placeholder-svgs',
                            type: 'hero',
                            index: 1,
                            class: 'sizechart-image sizecahrt-placeholder'
                          -%}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {%- when 'add' -%}
                  <div
                    class="main-product_block-spacing"
                    style="--block-spacing: {{ block.settings.block_spacing | append: 'px' }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if product.title != blank -%}
                      {% assign product_form_installment_id = 'product-installment-form-'
                        | append: section.id
                        | append: '-'
                        | append: product.id
                      %}
                      {%- form 'product',
                        product,
                        data-productid: product.id,
                        id: product_form_installment_id,
                        class: 'main-product_installment-form'
                      -%}
                        <input
                          type="hidden"
                          name="id"
                          data-productid="{{- product.id -}}"
                          value="{{- product.selected_or_first_available_variant.id -}}"
                        >
                        {{- form | payment_terms -}}
                      {%- endform -%}
                      <add-card-prod>
                        {% assign product_form_id = 'product-form-'
                          | append: section.id
                          | append: '-'
                          | append: product.id
                        %}
                        {%- form 'product',
                          product,
                          id: product_form_id,
                          class: 'form form_add_cartp',
                          novalidate: 'novalidate',
                          data-type: 'add-to-cart-form'
                        -%}
                          <input
                            type="hidden"
                            name="id"
                            value="{{ product.selected_or_first_available_variant.id }}"
                            {% if product.selected_or_first_available_variant.available == false
                              or product.selected_or_first_available_variant == null
                            %}
                              disabled
                            {% endif %}
                            class="product-variant-id"
                            id="product-variant-id"
                          >
                          {% if block.settings.show_quantity and pack_options_exists != 'true' %}
                            <quantity-inputs class="cart-quantity">
                              <button class="btn__button" name="minus" type="button">
                                {{ 'icon-minus-new.svg' | inline_asset_content }}
                              </button>
                              <input
                                class=""
                                type="number"
                                min="1"
                                name="quantity"
                                step="1"
                                value="1"
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: product.selected_or_first_available_variant.title | escape }}"
                              >
                              <button class="btn__button" name="plus" type="button">
                                {{ 'icon-plus-new.svg' | inline_asset_content }}
                              </button>
                            </quantity-inputs>
                          {% else %}
                            <input
                              class=""
                              type="hidden"
                              name="quantity"
                              step="1"
                              value="1"
                              aria-label="{{ 'products.product.quantity.input_label' | t: product: product.selected_or_first_available_variant.title | escape }}"
                            >
                          {% endif %}
                          {%- liquid
                            assign check_against_inventory = true
                            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
                              assign check_against_inventory = false
                            endif
                            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                              assign quantity_rule_soldout = true
                            endif
                          -%}
                          <button
                            type="submit"
                            name="add"
                            class="submit_add_cart"
                            {% if product.selected_or_first_available_variant.available == false
                              or quantity_rule_soldout
                              or product.selected_or_first_available_variant == null
                            %}
                              disabled
                            {% endif %}
                          >
                            <span class="submit_add_cart_text" data-atc-text-span="">
                              {%- if product.selected_or_first_available_variant == null -%}
                                {{ 'products.product.unavailable' | t }}
                              {%- elsif product.selected_or_first_available_variant.available == false
                                or quantity_rule_soldout
                              -%}
                                {{ 'products.product.sold_out' | t }}
                              {%- else -%}
                                {{ 'products.product.add_to_cart' | t }}
                              {%- endif -%}
                            </span>
                            {% if block.settings.icon != blank %}
                              <i class="icon_cart-btns">
                                {%- liquid
                                  assign max_width = block.settings.icon.width
                                  if block.settings.icon > 150
                                    assign max_width = 150
                                  endif
                                  assign image_height = max_width | divided_by: block.settings.icon.aspect_ratio | round

                                  capture image_alt
                                    if block.settings.icon.alt != blank
                                      echo block.settings.icon.alt
                                    else
                                      echo 'Icon' | escape
                                    endif
                                  endcapture
                                -%}
                                {{-
                                  block.settings.icon
                                  | image_url: width: max_width
                                  | image_tag:
                                    loading: 'lazy',
                                    width: max_width,
                                    height: image_height,
                                    alt: image_alt,
                                    class: ''
                                -}}
                              </i>
                            {% elsif block.settings.icon_alt != blank %}
                              <i class="icon_cart-btns material-symbols-outlined">{{ block.settings.icon_alt }}</i>
                            {% else %}
                              <i class="icon_cart-btns">{% render 'icon-cart-svg' %}</i>
                            {% endif %}
                          </button>
                        {%- endform -%}
                        <div class="payment-methods">
                          {% if block.settings.payment_icons_text != blank %}
                            <div class="payment-secure">
                              {% unless block.settings.payment_icon != blank %}
                                {% render 'icon-secure-prod' %}
                              {% else %}
                                <i class="icon_cart-btns material-symbols-outlined">
                                  {{- block.settings.payment_icon -}}
                                </i>
                              {% endunless %}
                              <div class="payment-secure-text">
                                {{ block.settings.payment_icons_text }}
                              </div>
                            </div>
                          {% endif %}
                          {% assign icons_count = 0 %}
                          {% capture icons %}
                              {% for i in (1..7) %}
                                {% assign key    = 'payment_icon_' | append: i %}
                                {% assign altkey = 'payment_icon_' | append: i | append: '_alt' %}
                                {% assign icon   = settings[key] %}
                                {% if icon %}
                                  {% assign icons_count = icons_count | plus: 1 %}
                                  <li>
                                  {%- liquid
                                    assign max_width = icon.width
                                    if icon > 72
                                        assign max_width = 72
                                    endif
                                    assign image_height = max_width | divided_by: icon.aspect_ratio | round

                                    capture image_alt
                                      if icon.alt != blank
                                        echo icon.alt
                                      elsif icon.alt == blank
                                        echo 'Payment method'
                                      else
                                        echo settings[altkey]
                                      endif
                                    endcapture

                                    capture sizes_attr
                                      echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 4.706vw'
                                    endcapture
                                  -%}
                                  {{-
                                    icon
                                    | image_url: width: max_width
                                    | image_tag: loading: 'lazy', width: max_width, height: image_height, sizes: sizes_attr, alt: image_alt, class: 'payicon'
                                  -}}
                                  </li>
                                {% endif %}
                              {% endfor %}
                            {% endcapture %}
                          {% if block.settings.show_payment_icons %}
                            <ul class="payment-icons-list list-unstyled">
                              {{ icons }}
                              {%- for type in shop.enabled_payment_types -%}
                                <li>
                                  {{ type | payment_type_svg_tag }}
                                </li>
                              {%- endfor -%}
                            </ul>
                          {% endif %}
                        </div>
                      </add-card-prod>
                    {%- else -%}
