{% assign product = section.settings.product %}
{%- liquid
  assign sid = section.id

  assign section_prefix_class = 'main-product-section'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture

  capture pack_options_exists
    for block in section.blocks
      if block.type == 'addon'
        echo 'true'
        break
      endif
    endfor
  endcapture
-%}

<style>
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .main-product-section :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
  {% endif %}

  .outer-padding .main-product-section_container-wrapper,
  .main-product-section_wrapper.inner-padding .container{
    background-image: url({{ section.settings.bg_image | image_url: width: 2000 }});
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Dynamic Block Styles */
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'addon' %}
        .main-product-section .product-addons__item {
          border-radius: {{ block.settings.container_radius }}px;
          box-shadow: {% if block.settings.container_styling == "shadow" %}{{ block.settings.box_shadow_offset }}px {{ block.settings.box_shadow_offset }}px {{ block.settings.box_shadow_blur }}px {{ block.settings.box_shadow_spread }}px {{ block.settings.box_shadow_color }}{% else %}none{% endif %};
          border: {% if block.settings.container_styling == "card" %} {{ block.settings.card_border }}px solid {{ block.settings.card_border_color }}{% else %}none{% endif %};
          padding: {{ block.settings.padding_y_desk }}px {{ block.settings.padding_x_desk }}px;
        }
        @media (max-width: 768px) {
          .main-product-section .product-addons__item {
            padding: {{ block.settings.cpadding_y_mob }}px {{ block.settings.cpadding_x_mob }}px;
          }
        }
      {% when 'gifts' %}
        .main-product-section .unlock-gifts-section .gift-image {
          border-radius: {{ block.settings.container_radius }}px;
          box-shadow: {% if block.settings.container_styling == "shadow" %}{{ block.settings.box_shadow_offset }}px {{ block.settings.box_shadow_offset }}px {{ block.settings.box_shadow_blur }}px {{ block.settings.box_shadow_spread }}px {{ block.settings.box_shadow_color }}{% else %}none{% endif %};
          border: {% if block.settings.container_styling == "card" %} {{ block.settings.card_border }}px solid {{ block.settings.card_border_color }}{% else %}none{% endif %};
        }
      {% when 'add' %}
        .main-product-section add-card-prod .submit_add_cart{
          {% if block.settings.setting_btn == 'global' %}
            border-radius: {{ settings.button_radius }}px;
            border: {{ settings.button_border_size }}px solid {{ settings.button_color_border }};
            color: {{ settings.button_text_color }};
            background: {{ settings.button_color }};
          {% else %}
            border-radius: {{ block.settings.button_radius }}px;
            border: {{ block.settings.button_border_size }}px solid {{ block.settings.button_border_color }};
            color: {{block.settings.button_text_color}};
            background: {% if block.settings.button_color != 'rgba(0,0,0,0)' %}{{block.settings.button_color}}{% else %}var(--color-bg-btn){% endif %};
          {% endif %}
        }
        .main-product-section add-card-prod .submit_add_cart svg path{
          {% if block.settings.setting_btn == 'global' %}
            stroke: {{ settings.button_text_color }};
          {% else %}
            stroke: {{block.settings.button_text_color}};
          {% endif %}
        }
        .main-product-section quantity-inputs {
          {% if block.settings.qty_align =='right' %}
            order: 2;
          {% else %}
            order:0;
          {% endif %}
        }
        .main-product-section .payment-methods{
          margin: 20px 0 0;
        }
      {% when 'timeline' %}
        .main-product-section .lab-tested-section:after { background: {{block.settings.stroke_item}}; }
      {% when 'testimonial' %}
        .main-product-section .product-testimonial-section .testimonial-card {
          border-radius: {{ block.settings.container_radius }}px;
          box-shadow: {% if block.settings.container_styling == "shadow" %}{{ block.settings.box_shadow_offset }}px {{ block.settings.box_shadow_offset }}px {{ block.settings.box_shadow_blur }}px {{ block.settings.box_shadow_spread }}px {{ block.settings.box_shadow_color }}{% else %}none{% endif %};
          border: {% if block.settings.container_styling == "card" %} {{ block.settings.card_border }}px solid {{ block.settings.card_border_color }}{% else %}none{% endif %};
        }
      {% when 'pack_options' %}
        .main-product-section .pack-options-section .pack {
          border-radius: {{ block.settings.container_radius }}px;
          box-shadow: {% if block.settings.container_styling == "shadow" %}{{ block.settings.box_shadow_offset }}px {{ block.settings.box_shadow_offset }}px {{ block.settings.box_shadow_blur }}px {{ block.settings.box_shadow_spread }}px {{ block.settings.box_shadow_color }}{% else %}none{% endif %};
          border: {% if block.settings.container_styling == "card" %} {{ block.settings.card_border }}px solid {{ block.settings.card_border_color }}{% else %}none{% endif %};
        }
        .main-product-section .pack-options-section .pack.active,
        .main-product-section .pack-options-section .pack:hover {
          border-color: {{ block.settings.card_border_color_active }};
        }
        .main-product-section .pack-options-section .pack.active:after {
          opacity: 0.1;
          background: {{ block.settings.card_border_color_active }};
        }
        .main-product-section .product-info-section .rating .rating-star {
          color: {{ block.settings.star_color }};
        }
        .main-product-section .product-info-section .rating .rating-text {
          color: {{ block.settings.review_color }};
        }
        .main-product-section .pack-options-section .discount-label {
          color: {{ block.settings.discount_color }};
          background-color: {{ block.settings.discount_color_bg }};
        }
        .main-product-section .pack-options-section .pack-quantity {
          color: {{ block.settings.price_color }};
          background-color: {{ block.settings.price_color_bg }};
        }
        @media (max-width: 980px)
        {
            #shopify-section-{{ sid }} .pack-shipping { font-size: 10px;  line-height: 12px;  padding: 5px 0;}
            #shopify-section-{{ sid }} .pack-quantity {font-size: 11px;}
            #shopify-section-{{ sid }} .pack-options-section .pack  {padding: 5px;}
        }
    {% endcase %}
  {% endfor %}
</style>

{%- stylesheet -%}
  .main-product-section .content-wrapper a p {
    margin: 0 auto;
    color: var(--text-color);
    cursor: pointer;
  }
  .main-product-section .product-common_taxes-text {
    font-size: 12px;
    font-weight: 400;
    display: block;
    margin-bottom: 8px;
    margin-top: 8px;
  }

  .main-product-section add-card-prod .submit_add_cart svg path {
    stroke: var(--stroke);
  }

  .main-product-section_wrapper {
    display: var(--display-value);
    text-align: var(--heading-align);
    position: relative;
    width: 100%;
    text-decoration: none;
  }

  .submit_add_cart--placeholder {
    width: 100%;
  }

  .main-product-section_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .main-product-section_container-wrapper {
    padding: var(--xl-padding-y) 0;
  }

  .lab-tested-inner svg {
    border-radius: 100px;
    height: 100%;
  }

  .outer-padding .main-product-section_container-wrapper {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-product-section_wrapper.inner-padding .container {
    background: var(--bg-color);
    color: var(--text-color);
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .main-product-section_wrapper.outer-padding .container {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .main-product-section_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-x);
    padding-right: var(--xl-padding-x);
  }

  .main-product-section_wrapper.inner-padding .container,
  .main-product-section_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-x);
    --cp-spacer-right: var(--xl-padding-x);
  }

  .main-product-section add-card-prod .submit_add_cart {
    border-radius: var(--btn-border-radius);
    border: var(--btn-border);
    color: var(--btn-color);
    background: var(--btn-background);
  }

  .main-product-section_content-wrapper {
    display: block;
    position: relative;
    text-align: var(--heading-align);
  }

  .main-product-section .title h2,
  .main-product-section .title h1,
  .main-product-section .title h3,
  .main-product-section .title p {
    font-size: var(--font-size);
    text-transform: var(--heading-transform);
    color: var(--text-color);
    margin: 0;
    text-align: var(--heading-align);
    line-height: 110%;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .main-product-section .heading .sub-heading {
    font-size: 18px;
    font-weight: 500;
    font-family: var(--font-heading-family);
    margin-bottom: 0px;
  }

  .main-product-section .subtitle h2,
  .main-product-section .subtitle h3,
  .main-product-section .subtitle h1,
  .main-product-section .subtitle p {
    color: var(--text-color);
    font-size: 20px;
    font-weight: 400;
    text-align: var(--heading-align);
    line-height: 150%;
    margin: 0;
  }

  .main-product-section .uppertitle {
    display: flex;
    justify-content: var(--heading-align);
    align-items: center;
    margin: 0;
    margin-bottom: 14.5px;
  }

  .main-product-section .uppertitle svg path {
    fill: var(--fill);
  }

  .main-product-section .uppertitle h2,
  .main-product-section .uppertitle h3,
  .main-product-section .uppertitle h4,
  .main-product-section .uppertitle p {
    color: var(--text-color);
    font-size: 16px;
    font-weight: 400;
    line-height: 120%;
    order: 5;
    margin-left: 11px;
  }

  .main-product-section .uppertitle p {
    margin-left: 0;
  }

  .main-product-section .sizecahrt-placeholder {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .main-product-section .gallery-column {
    position: sticky;
    top: 0;
    align-self: flex-start;
  }

  .main-product_block-spacing {
    margin-bottom: var(--block-spacing);
  }

  .main-product-section .price-block {
    display: flex;
    row-gap: 15px;
    column-gap: 17px;
    align-content: center;
    align-items: center;
    margin-top: 0;
  }

  .main-product-section .instock {
    font-size: 14px;
    line-height: 150%;
    font-weight: 400;
    display: flex;
  }

  .main-product-section .cprice {
    font-weight: 400;
    font-size: 22px;
    line-height: auto;
    letter-spacing: 0%;
    text-transform: capitalize;
    text-decoration: line-through;
    margin-right: 0;
  }

  .main-product-section .priced {
    font-weight: 700;
    font-size: 16px;
    line-height: 150%;
    background: black;
    border-radius: 50px;
    padding: 6px 14px;
    gap: 10px;
    color: white;
    max-height: 36px;
    margin: 0 0;
  }

  .main-product-section .price {
    font-size: 24px;
    font-weight: bold;
    color: #000;
  }

  .main-product-section .description-block {
    font-size: 16px;
    line-height: 150%;
    color: #000;
    margin-top: 0;
    text-align: left;
  }

  /* Ripple animation styles */
  .main-product-section .ripple {
    transform-origin: center;
    animation: ripple 1.8s infinite ease-out;
  }

  .main-product-section .ripple:nth-of-type(2) {
    animation-delay: 0s;
  }

  .main-product-section .ripple:nth-of-type(3) {
    animation-delay: 0.6s;
  }

  .main-product-section .ripple:nth-of-type(4) {
    animation-delay: 1.2s;
  }

  @keyframes ripple {
    0% {
      r: 4;
      opacity: 0.8;
      stroke-width: 4;
    }

    100% {
      r: 25;
      opacity: 0;
      stroke-width: 0;
    }
  }

  /* Inline styles extracted to CSS classes */
  .main-product-section .instock-text,
  .main-product-section .outstock-text {
    align-content: center;
  }

  /* Trust icons styles */
  .main-product-section .icon-text {
    font-size: 14px;
    line-height: 1.4;
  }

  .main-product-section .icon-text--right {
    width: 85px;
    padding-left: 10px;
  }

  .main-product-section .icon-items {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .main-product-section .icon-items--bottom {
    gap: 20px;
  }

  .main-product-section .icon-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .main-product-section .icon-item--bottom {
    flex: 0 1 calc(25% - 15px);
    flex-direction: column;
    text-align: center;
  }

  .main-product-section .icon-item--side {
    flex: 0 1 30%;
    width: 30%;
    text-align: left;
  }

  .main-product-section .icon-items--right {
    flex: unset;
  }

  .main-product-section .icon-item--right {
    width: 50%;
  }

  /* Icon wrapper and color styles */
  .main-product-section .icon-wrapper-dynamic {
    background: var(--background-item);
  }

  .main-product-section .icon-color {
    color: var(--icon-item);
  }

  /* Addon styles */
  .main-product-section h3 {
    font-size: 1.2em;
    margin-bottom: 10px;
    font-weight: bold;
    margin-top: 0;
  }

  .main-product-section .product-addons__item {
    border-radius: var(--container-radius);
    box-shadow: var(--box-shadow);
    border: var(--card-border);
    padding: var(--padding-y-desk) var(--padding-x-desk);
  }

  .main-product-section .product-addons__item--placeholder {
    opacity: 0.6;
    pointer-events: none;
    cursor: not-allowed;
  }

  .main-product-section .product-addons__item--placeholder .product-addons__switch {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .main-product-section .product-addons__item--placeholder .product-addons__toggle:disabled {
    cursor: not-allowed;
  }

  .product-page-layout .uppertitle .star_span {
    margin-right: 14px;
  }

  @media (max-width: 768px) {
    .main-product-section .product-addons__item {
      padding: var(--padding-y-mob) var(--padding-x-mob);
    }

    .main-product-section .icon-item {
      gap: 10px;
    }

    .outer-padding .main-product-section_container-wrapper:has(.container) {
      padding-left: var(--xs-padding-x);
      padding-right: var(--xs-padding-x);
    }

    .main-product-section_wrapper.inner-padding .container,
    .main-product-section_wrapper.outer-padding .container-fluid {
      --cp-spacer-left: var(--xs-padding-x);
      --cp-spacer-right: var(--xs-padding-x);
    }

    .main-product-section_container-wrapper {
      padding: var(--xs-padding-y) 0;
    }
  }

  /* Gifts styles */
  .main-product-section .unlock-gifts-section .gift-image {
    overflow: hidden;
    border-radius: var(--container-radius);
    box-shadow: var(--box-shadow);
    border: var(--card-border);
  }

  .main-product-section .product-points-content p {
    font-size: 20px;
    font-weight: 400;
    margin: 0 0 32px;
    line-height: 150%;
    color: inherit;
  }

  .main-product-section .product-points-content .product-points-list {
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .main-product-section .product-points-content .product-points-list li {
    font-size: 16px;
    color: var(--color-list);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    line-height: 150%;
  }

  .main-product-section .product-points-content .product-points-list img {
    width: 24px;
    height: 24px;
  }

  /* Styles for safety icons section */
  .main-product-section .icon-wrapper {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-product-section .icon-wrapper img,
  .main-product-section .icon-wrapper svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .main-product-section .icon-wrapper .material-icons,
  .main-product-section .icon-wrapper span {
    font-size: 30px;
    line-height: 34px;
    width: 30px;
    height: 30px;
  }

  .main-product-section .icon-text p {
    margin: 0;
  }

  /* Styles for unlock gifts section */
  .main-product-section .unlock-gifts-section {
    width: 100%;
  }

  .main-product-section .unlock-gifts-section h3 {
    font-size: 1.2em;
    margin-bottom: 10px;
    font-weight: bold;
    margin-top: 0;
  }

  .main-product-section .product-addon-section h3 {
    font-size: 1.2em;
    margin-bottom: 10px;
    font-weight: bold;
    margin-top: 0;
  }

  .main-product-section .unlock-gifts-section .gifts {
    display: flex;
    gap: 20px !important;
    justify-content: center;
  }

  .main-product-section .unlock-gifts-section .gift {
    text-align: center;
  }

  .main-product-section .unlock-gifts-section .gift-image {
    width: 100%;
    height: 180px;
    aspect-ratio: unset;
    border: 1px solid #ddd;
    border-radius: 8px;
    background-color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    line-height: 0;
    flex-direction: column;
    gap: 20px !important;
  }

  .main-product-section .unlock-gifts-section .gift-image div {
    line-height: normal;
  }

  .main-product-section .unlock-gifts-section .gift-image svg {
    width: 60%;
    min-width: 48px;
  }

  .main-product-section .unlock-gifts-section .gift-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .main-product-section .unlock-gifts-section .gift-image .lock-icon {
    font-size: 40px;
    color: #666;
  }

  .main-product-section .unlock-gifts-section .gift-image .placeholder-image {
    width: 100%;
    height: auto;
    background-color: #d3d3d3;
  }

  .main-product-section .unlock-gifts-section .gift[data-locked='false'] .gift-image:after {
    content: url('data:image/svg+xml,<svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 5.5L7.32941 9L14 2" stroke="black" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>');
    width: 30px;
    height: 30px;
    background: #fff;
    border-radius: 50%;
    position: absolute;
    top: 20px;
    left: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .main-product-section .product-points-section li {
    color: var(--sim-color);
  }

  .main-product-section .product-testimonial-section .testimonial-card {
    overflow: hidden;
    background-color: var(--test-background);
    color: var(--test-color);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    border: var(--border-solid);
    display: block;
  }
  .main-product-section .testimonial-card .testimonial-photo {
    display: block;
  }

  .main-product-section .testimonial-card_top {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .main-product-section .testimonial-card_image {
    line-height: 0;
  }
  .testimonial-card_top {
    margin-bottom: 8px;
  }

  .pack-options-section .pack {
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    border: var(--border-solid);
  }

  .pack-options-section .pack.active,
  .pack-options-section .pack:hover {
    border-color: var(--brdr-active);
  }

  .pack-options-section .pack.active:after {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    content: '';
    opacity: 0.1;
    background: var(--brdr-active);
  }

  .product-info-section .rating .rating-star {
    color: var(--fill);
  }

  .product-info-section .rating .rating-text {
    color: var(--review-color);
  }

  .pack-options-section .discount-label {
    color: var(--dis-color);
    background-color: var(--dis-bg-color);
  }

  .pack-options-section .pack-quantity {
    color: var(--price-color);
    background-color: var(--price-bg);
  }

  .main-product-section .lab-tested-circle-w:after {
    background: var(--stroke);
  }

  @media (max-width: 768px) {
    .main-product-section .lab-tested-step-wrapper:not(:last-child) .lab-tested-circle-w:after {
      content: '';
      height: 7px;
      top: 24px;
    }
    .main-product-section .unlock-gifts-section .gift-image {
      gap: 10px !important;
    }

    .main-product-section .testimonial-photo {
      width: 56px;
      height: 56px;
    }
    .main-product-section .testimonial-card {
      padding: 25px 16px;
    }
  }

  .main-product-section quantity-inputs {
    order: var(--order);
  }

  .main-product-section .payment-methods {
    margin: 20px 0 0;
  }

  .main-product-section .unlock-gifts-section .gift-title {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-top: 20px;
  }

  .main-product-section .product-sizechart-content .product-points-list {
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .main-product-section .product-sizechart-content .product-points-list li {
    font-size: 16px;
    color: var(--color-list);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    line-height: 150%;
  }

  .main-product-section .product-sizechart-content .product-points-list img {
    width: 24px;
    height: 24px;
  }

  .main-product-section .payment-secure-text p {
    color: #000;
    text-align: left;
  }

  .timeline-mode-text {
    display: block;
    font-weight: 500;
    font-size: 16px;
    line-height: 120%;
    margin-top: 6px;
  }

  .main-product_installment-form {
    margin-bottom: 10px;
  }

  @media (min-width: 769px) and (max-width: 1279px) {
    .main-product-section .product-sizechart-content .product-points-container {
      gap: 25px;
    }

    .main-product-section .product-sizechart-content .product-points-content {
      max-width: 50%;
    }
  }

  @media (max-width: 768px) {
    .main-product-section_wrapper {
      display: var(--xs-display-value);
    }
    .main-product-section .unlock-gifts-section .gifts {
      gap: 10px !important;
    }

    .main-product-section .heading {
      padding: 0;
    }

    .main-product-section .gallery-column {
      position: relative;
      align-self: normal;
    }

    .main-product-section .title h2,
    .main-product-section .title h1,
    .main-product-section .title h3,
    .main-product-section .title p {
      font-size: var(--xs-font-size);
      line-height: auto;
      margin: 0 0 16px;
    }

    .main-product-section .subtitle h2,
    .main-product-section .subtitle h3,
    .main-product-section .subtitle h1,
    .main-product-section .subtitle p {
      font-size: 16px;
      line-height: 24px;
    }

    .main-product-section .uppertitle h2,
    .main-product-section .uppertitle h3,
    .main-product-section .uppertitle h4,
    .main-product-section .uppertitle p {
      color: var(--upper-title);
      font-size: 14px;
      font-weight: 400;
      order: 5;
      margin-left: 3px;
    }

    .main-product-section .uppertitle {
      margin-bottom: 16px;
    }

    .main-product-section .uppertitle svg {
      max-width: 12px;
      margin-left: 0;
    }

    .main-product-section .price-block {
      flex-wrap: wrap;
    }

    .main-product-section .priced {
      margin: 0;
    }

    .main-product-section .product-points-content h2 {
      font-size: 28px;
      margin: 0 0 24px;
    }

    .main-product-section .product-points-content p {
      margin: 0 0 24px;
      font-weight: 500;
      font-size: 16px;
    }

    .main-product-section .product-points-content .product-points-list {
      gap: 9px;
    }

    .main-product-section .product-points-content .product-points-list li {
      margin-bottom: 0;
      font-size: 14px;
    }

    .main-product-section .unlock-gifts-section .gifts {
      flex-direction: row;
    }

    .main-product-section .unlock-gifts-section .gift {
      width: calc(100% / 3);
    }

    .main-product-section .unlock-gifts-section .gift-image div {
      font-size: 0.7rem;
    }

    .main-product-section .product-sizechart-content .product-points-content h2 {
      font-size: 28px;
      margin: 0 0 24px;
    }

    .main-product-section .product-sizechart-content .product-points-content p {
      margin: 0 0 24px;
      font-weight: 500;
      font-size: 16px;
    }

    .main-product-section .product-sizechart-content .product-points-list li {
      margin-bottom: 15px;
      font-size: 14px;
    }
    .main-product-section .cprice,
    .main-product-section .price {
      font-size: 16px;
    }
    .main-product-section .priced {
      font-size: 12px;
    }
  }
  @media (max-width: 389px) {
    .main-product-section .submit_add_cart {
      font-size: 14px;
    }
  }
  .payment-icons-list {
    flex-wrap: wrap;
  }
{%- endstylesheet -%}

<div
  class="main-product-section_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  style="
      {% if section.settings.setting_btn == 'global' %}
        --stroke: {{ settings.button_text_color }};
      {% else %}
        --stroke: {{ section.settings.button_text_color }};
      {% endif %}
      {% if section.settings.setting_btn == 'global' %}
        --btn-border-radius: {{ settings.button_radius }}px;
        --btn-border: {{ settings.button_border_size }}px solid {{ settings.button_color_border }};
        --btn-color: {{ settings.button_text_color }};
        --btn-background: {{ settings.button_color }};
      {% else %}
        --btn-border-radius: {{ section.settings.button_radius }}px;
        --btn-border: {{ section.settings.button_border_size }}px solid {{ block.settings.button_border_color }};
        --btn-color: {{ section.settings.button_text_color }};
        --btn-background:
          {% if section.settings.button_text_color != 'rgba(0,0,0,0)' %}
            {{ section.settings.button_color }}
          {% else %}
            var(--color-bg-btn)
      {% endif %};
      {% endif %}
      {% if section.settings.qty_align == 'right' %}
        --order: 2;
      {% else %}
        --order: 0;
      {% endif %}
    --stroke: {{ section.settings.stroke_item }};
    --price-bg: {{ section.settings.price_color_bg }};
    --price-color: {{ section.settings.price_color }};
    --dis-bg-color: {{ section.settings.discount_color_bg }};
    --dis-color: {{ section.settings.discount_color }};
    --review-color: {{ section.settings.review_color }};
    --brdr-active: {{ section.settings.card_border_color_active }};
      {% if section.settings.container_styling == "card" %}
        --border-solid: {{ section.settings.card_border }}px solid {{ section.settings.card_border_color }};
      {% else %}
        --border-solid: none;
      {% endif %}
      {% if section.settings.container_styling == "shadow" %}
        --box-shadow: {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_blur }}px {{ section.settings.box_shadow_spread }}px {{ block.settings.box_shadow_color }};
      {% else %}
        --box-shadow: none;
      {% endif %}
      --border-radius: {{ section.settings.container_radius  }}px;
      --sim-color: {{ section.settings.color }};
      --color-list: {{ section.settings.text_color_list }};
      --heading-transform: {{ section.settings.headline_typography }};
      {% case section.settings.heading_size %}
        {% when 'small' %}
          --font-size: 28px;
        {% when 'medium' %}
          --font-size: 40px;
        {% when 'large' %}
          --font-size: 48px;
      {% endcase %}
      {% case section.settings.heading_size %}
        {% when 'small' %}
          --xs-font-size: 20px;
        {% when 'medium' %}
          --xs-font-size: 32px;
        {% when 'large' %}
          --xs-font-size: 32px;
      {% endcase %};
      --xl-padding-x: {{ section.settings.padding_x_desk }}px;
      --xl-padding-y: {{ section.settings.padding_y_desk }}px;
      --xs-padding-x: {{ section.settings.padding_x_mob }}px;
      --xs-padding-y: {{ section.settings.padding_y_mob }}px;
      {% if section.settings.section_width == 'full' %}
        margin: 0 auto;
      --width-value: 100%;
      {% else %}
        margin: auto 0;
      --width-value: {{ settings.page_width }}px;
      {% endif %}
    --text-color: {{ section.settings.text_color }};
    --heading-align: left;
    --bg-color: {{ section.settings.background_color }};
    {% case section.settings.display_on %}
      {% when 'all' %}
        --xs-display-value: block;
      {% when 'mobile_only' %}
        --xs-display-value: block;
      {% when 'desktop_only' %}
        --xs-display-value: none;
    {% endcase %}
    {% case section.settings.display_on %}
      {% when 'all' %}
        --display-value: block;
      {% when 'mobile_only' %}
        --display-value: none;
      {% when 'desktop_only' %}
        --display-value: block;
    {% endcase %}
  "
>
  <div
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="      --custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_width }}">
      <div class="{{ section_prefix_class }}_content-wrapper">
        <div class="product-page-layout">
          {%- unless product.media.size == 0 -%}
            <div class="gallery-column">
              <div class="gallery-section" data-section-type="gallery">
                <div class="main-image-wrapper">
                  <button class="arrow arrow-left" aria-label="Previous Image">
                    {% render 'swiper-arrow-left-n' %}
                  </button>
                  <div class="main-image">
                    {% for block in section.blocks %}
                      {%- case block.type -%}
                        {%- when 'media' -%}
                          {% if product.images.size > 0 %}
                            {%- liquid
                              assign max_width = product.images.first.width
                              if product.images.first > 1400
                                assign max_width = 1400
                              endif
                              assign image_height = max_width | divided_by: product.images.first.aspect_ratio | round

                              capture image_alt
                                if product.images.first.alt != blank
                                  echo product.images.first.alt
                                else
                                  echo product.title
                                endif
                              endcapture

                              capture sizes_attr
                                echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 42.143vw'
                              endcapture
                            -%}
                            {{-
                              product.images.first
                              | image_url: width: max_width
                              | image_tag:
                                loading: 'lazy',
                                width: max_width,
                                height: image_height,
                                alt: image_alt,
                                sizes: sizes_attr,
                                class: '',
                                data-index: '0',
                                srcset: ''
                            -}}
                          {% else %}
                            {%- render 'placeholder-svgs', type: 'product', index: 1, class: '', data-index: '0' -%}
                          {% endif %}
                      {% endcase %}
                    {% endfor %}
                  </div>
                  <button class="arrow arrow-right" aria-label="Next Image">{% render 'swiper-arrow-right-n' %}</button>
                </div>
                {% for block in section.blocks %}
                  {%- case block.type -%}
                    {%- when 'media' -%}
                      {% if block.settings.show_thumbnails %}
                        <div class="thumbnails">
                          {% for image in product.images %}
                            <div
                              class="thumbnail"
                              data-main-image="{{ image | image_url: width: 600 }}"
                              data-index="{{ forloop.index0 }}"
                            >
                              {%- liquid
                                assign max_width = image.width
                                if image > 300
                                  assign max_width = 300
                                endif
                                assign image_height = max_width | divided_by: image.aspect_ratio | round

                                capture image_alt
                                  if image.alt != blank
                                    echo image.alt
                                  else
                                    echo product.title
                                  endif
                                endcapture

                                capture sizes_attr
                                  echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 8.786vw'
                                endcapture
                              -%}
                              {{-
                                image
                                | image_url: width: max_width
                                | image_tag:
                                  loading: 'lazy',
                                  width: max_width,
                                  height: image_height,
                                  alt: image_alt,
                                  sizes: sizes_attr,
                                  class: ''
                              -}}
                            </div>
                          {% endfor %}
                        </div>
                      {% endif %}
                  {% endcase %}
                {% endfor %}
              </div>
            </div>
          {%- endunless -%}
          <div class="content-column">
            {% for block in section.blocks %}
              {% comment %} Check if we should open a square-icon-grid wrapper {% endcomment %}
              {% if block.type == 'square_icon' %}
                {% comment %} Check if previous block was NOT square_icon - if so, open wrapper {% endcomment %}
                {% assign prev_index = forloop.index0 | minus: 1 %}
                {% if prev_index >= 0 %}
                  {% assign prev_block = section.blocks[prev_index] %}
                  {% if prev_block.type != 'square_icon' %}
                    <div
                      class="content-section safety-icons-section"
                      data-section-type="content"
                    >
                      <div
                        class="square-icon-grid"
                      >
                  {% endif %}
                {% else %}
                  <div
                    class="content-section safety-icons-section"
                    data-section-type="content"
                  >
                    <div
                      class="square-icon-grid"
                    >
                {% endif %}
              {% endif %}

              {% comment %} Check if we should open a square-icon-grid-row wrapper {% endcomment %}
              {% if block.type == 'square_icon_row' %}
                {% comment %} Check if previous block was NOT square_icon_row - if so, open wrapper {% endcomment %}
                {% assign prev_index_row = forloop.index0 | minus: 1 %}
                {% if prev_index_row >= 0 %}
                  {% assign prev_block_row = section.blocks[prev_index_row] %}
                  {% if prev_block_row.type != 'square_icon_row' %}
                    <div
                      class="content-section safety-icons-section"
                      data-section-type="content"
                      {{ block.shopify_attributes }}
                    >
                      <div
                        class="square-icon-grid square-icon-grid-row"
                      >
                  {% endif %}
                {% else %}
                  <div
                    class="content-section safety-icons-section"
                    data-section-type="content"
                    {{ block.shopify_attributes }}
                  >
                    <div
                      class="square-icon-grid square-icon-grid-row"
                    >
                {% endif %}
              {% endif %}
              {%- case block.type -%}
                {%- when 'title' -%}
                  <div
                    class="heading main-product_block-spacing"
                    style="--block-spacing: {{ block.settings.block_spacing | append: 'px' }}"
                    {{ block.shopify_attributes }}
                  >
                    {% if block.settings.uppertitle != blank %}
                      <div class="uppertitle">
                        <span class="star_span" style="--fill: {{ block.settings.star_color }};">
                          {% for i in (1..5) -%}
                            {%- render 'star_comparison' -%}
                          {%- endfor %}
                        </span>
                        {{- block.settings.uppertitle -}}
                      </div>
                    {% endif %}
                    <div class="title">
                      {%- if product.title != blank -%}
                        <h2>{{ product.title }}</h2>
                      {% else %}
                        <h2>Product title</h2>
                      {%- endif -%}
                    </div>
                    {% if block.settings.sub_heading != blank -%}
                      <h4 class="sub-heading">{{ block.settings.sub_heading -}}</h4>
                    {% endif -%}
                  </div>
                {%- when 'price' -%}
                  {%- if product.title != blank -%}
                    {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                      <strong class="product-common_taxes-text">
                        {%- liquid
                          if cart.taxes_included
                            echo 'products.product.include_taxes' | t
                          endif
                          if shop.shipping_policy.body != blank
                            echo ' '
                            echo 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url
                          endif
                        -%}
                      </strong>
                    {%- endif -%}
                  {%- endif -%}
                  <div
                    class="price-block main-product_block-spacing"
                    style="--block-spacing: {{ block.settings.block_spacing | append: 'px' }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if product.title != blank -%}
                      {% assign variant = product.selected_or_first_available_variant %}
                      {% if variant.compare_at_price > variant.price %}
                        <div class="cprice">{{ variant.compare_at_price | money }}</div>
                      {% endif %}
                      <div class="price">{{ variant.price | money }}</div>
                      {% if variant.compare_at_price > variant.price %}
                        {% assign discount = variant.compare_at_price | minus: variant.price %}
                        {% assign discount_percent = discount | times: 100 | divided_by: variant.compare_at_price %}
                        <div class="priced">Save {{ discount_percent | round }}%</div>
                      {% endif %}
                    {%- else -%}
                      <div class="price">$ 19.99</div>
                    {%- endif -%}
                    {%- if product.title != blank -%}
                      {%- if block.settings.show_stock -%}
                        {% if block.settings.outstock_text != blank or block.settings.instock_text != blank %}
                          <div class="instock">
                            {%- liquid
                              assign variant = product.selected_or_first_available_variant
                              assign inventory_count = variant.inventory_quantity | times: 1

                              if variant.inventory_management == 'shopify'
                                if variant.inventory_policy == 'continue'
                                  assign stock_text = block.settings.instock_text
                                  assign stock_color = block.settings.intstock_color
                                else
                                  if inventory_count < 1
                                    assign stock_text = block.settings.outstock_text
                                    assign stock_color = block.settings.outstock_color
                                  else
                                    assign stock_text = block.settings.instock_text
                                    assign stock_color = block.settings.intstock_color
                                  endif
                                endif
                              else
                                assign stock_text = block.settings.instock_text
                                assign stock_color = block.settings.intstock_color
                              endif
                            -%}
                            {%- if block.settings.show_pointer -%}
                              <svg
                                width="25"
                                height="25"
                                viewBox="0 0 25 25"
                                xmlns="http://www.w3.org/2000/svg"
                                style="overflow: visible; display: block;"
                              >
                                <circle cx="12.5" cy="12.5" r="4" fill="{{ stock_color }}" />
                                <circle class="ripple" cx="12.5" cy="12.5" r="4" fill="none" stroke="{{ stock_color }}" fill-opacity="0.22" stroke-width="1" />
                                <circle class="ripple" cx="12.5" cy="12.5" r="4" fill="none" stroke="{{ stock_color }}" fill-opacity="0.22" stroke-width="1" />
                                <circle class="ripple" cx="12.5" cy="12.5" r="4" fill="none" stroke="{{ stock_color }}" fill-opacity="0.22" stroke-width="1" />
                              </svg>
                            {%- endif -%}
                            <div
                              class="instock-text"
                              style="--instock-color: {{ stock_color }};"
                              data-instock-text="{{ block.settings.instock_text }}"
                              data-outstock-text="{{ block.settings.outstock_text }}"
                              data-instock-color="{{ block.settings.intstock_color }}"
                              data-outstock-color="{{ block.settings.outstock_color }}"
                            >
                              {{ stock_text }}
                            </div>
                          </div>
                        {% endif %}
                      {%- endif -%}
                    {%- else -%}
                      {%- if block.settings.show_stock -%}
                        {% if block.settings.outstock_text != blank or block.settings.instock_text != blank %}
                          <div class="instock">
                            {%- liquid
                              assign stock_text = block.settings.outstock_text
                              assign stock_color = block.settings.outstock_color
                            -%}
                            {%- if block.settings.show_pointer -%}
                              <svg
                                width="25"
                                height="25"
                                viewBox="0 0 25 25"
                                xmlns="http://www.w3.org/2000/svg"
                                style="overflow: visible; display: block;"
                              >
                                <circle cx="12.5" cy="12.5" r="4" fill="{{ stock_color }}" />
                                <circle class="ripple" cx="12.5" cy="12.5" r="4" fill="none" stroke="{{ stock_color }}" fill-opacity="0.22" stroke-width="1" />
                                <circle class="ripple" cx="12.5" cy="12.5" r="4" fill="none" stroke="{{ stock_color }}" fill-opacity="0.22" stroke-width="1" />
                                <circle class="ripple" cx="12.5" cy="12.5" r="4" fill="none" stroke="{{ stock_color }}" fill-opacity="0.22" stroke-width="1" />
                              </svg>
                            {%- endif -%}
                            <div
                              class="instock-text"
                              style="--instock-color: {{ stock_color }};"
                              data-outstock-text="{{ block.settings.outstock_text }}"
                              data-outstock-color="{{ block.settings.outstock_color }}"
                            >
                              {{ stock_text }}
                            </div>
                          </div>
                        {% endif %}
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                {%- when 'description' -%}
                  <div
                    class="description-block main-product_block-spacing"
                    style="--block-spacing: {{ block.settings.block_spacing | append: 'px' }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="short-description" style="color: {{ block.settings.text_color }}">
                      {{ product.description }}
                    </div>
                  </div>
                {%- when 'points' -%}
                  <div
                    class="product-points-content main-product_block-spacing"
                    style="--block-spacing: {{ block.settings.block_spacing | append: 'px' }}"
                    {{ block.shopify_attributes }}
                  >
                    <ul class="product-points-list">
                      <li>
                        {% if block.settings.icon_1 != blank %}
                          {%- liquid
                            assign max_width = block.settings.icon_1.width
                            if block.settings.icon_1 > 24
                              assign max_width = 24
                            endif
                            assign image_height = max_width | divided_by: block.settings.icon_1.aspect_ratio | round

                            capture image_alt
                              unless block.settings.icon_1.alt == blank
                                echo block.settings.icon_1.alt
                              else
                                echo 'Icon 1'
                              endunless
                            endcapture
                          -%}
                          {{-
                            block.settings.icon_1
                            | image_url: width: max_width
                            | image_tag:
                              loading: 'lazy',
                              width: max_width,
                              height: image_height,
                              alt: image_alt,
                              class: ''
                          -}}
                        {% else %}
                          {% if block.settings.icon_1_text != blank %}
                            <span class="material-symbols-outlined color">{{ block.settings.icon_1_text }}</span>
                          {% else %}
                            <span class="material-symbols-outlined">check</span>
                          {% endif %}
                        {% endif %}
                        {{ block.settings.point_1_text }}
                      </li>
                      <li>
                        {% if block.settings.icon_2 != blank %}
                          {%- liquid
                            assign max_width = block.settings.icon_2.width
                            if block.settings.icon_2 > 24
                              assign max_width = 24
                            endif
                            assign image_height = max_width | divided_by: block.settings.icon_2.aspect_ratio | round

                            capture image_alt
                              unless block.settings.icon_2.alt == blank
                                echo block.settings.icon_2.alt
                              else
                                echo 'Icon 2'
                              endunless
                            endcapture
                          -%}
                          {{-
                            block.settings.icon_2
                            | image_url: width: max_width
                            | image_tag:
                              loading: 'lazy',
                              width: max_width,
                              height: image_height,
                              alt: image_alt,
                              class: ''
                          -}}
                        {% else %}
                          {% if block.settings.icon_2_text != blank %}
                            <span class="material-symbols-outlined "> {{ block.settings.icon_2_text }}</span>
                          {% else %}
                            <span class="material-symbols-outlined">check</span>
                          {% endif %}
                        {% endif %}
                        {{ block.settings.point_2_text }}
                      </li>
                      <li>
                        {% if block.settings.icon_3 != blank %}
                          {%- liquid
                            assign max_width = block.settings.icon_3.width
                            if block.settings.icon_3 > 24
                              assign max_width = 24
                            endif
                            assign image_height = max_width | divided_by: block.settings.icon_3.aspect_ratio | round

                            capture image_alt
                              unless block.settings.icon_3.alt == blank
                                echo block.settings.icon_3.alt
                              else
                                echo 'Icon 3'
                              endunless
                            endcapture
                          -%}
                          {{-
                            block.settings.icon_3
                            | image_url: width: max_width
                            | image_tag:
                              loading: 'lazy',
                              width: max_width,
                              height: image_height,
                              alt: image_alt,
                              class: ''
                          -}}
                        {% else %}
                          {% if block.settings.icon_3_text != blank %}
                            <span class="material-symbols-outlined">{{ block.settings.icon_3_text }}</span>
                          {% else %}
                            <span class="material-symbols-outlined">check</span>
                          {% endif %}
                        {% endif %}
                        {{ block.settings.point_3_text }}
                      </li>
                    </ul>
                  </div>
