                                              {{ velue.name }}
                                            </div>
                                          {% endfor %}
                                        </div>
                                      </div>
                                    </div>
                                  {% when 'drop_color_c' %}
                                    <div class="option-group custom-variant-select">
                                      <label>{{ block.settings.label }}</label>
                                      <div class="custom-select" tabindex="0">
                                        <div class="select-trigger">Select option</div>
                                        <div class="select-options">
                                          {% for velue in option.values %}
                                            <div
                                              class="option-value"
                                              data-value="{{ velue.name }}"
                                              data-option-name="{{ option.name }}"
                                            >
                                              <i
                                                class="custom_color_{{ velue.name | strip | escape | downcase | replace: ' ', '_'   }}"
                                              ></i>
                                              {{ velue.name }}
                                            </div>
                                          {% endfor %}
                                        </div>
                                      </div>
                                    </div>
                                  {% when 'color_circles_rtext' %}
                                    <div class="option-block color-circles color-circles-right">
                                      <label>{{ block.settings.label }}</label>
                                      <div class="color-circle-list">
                                        {% for color in option.values %}
                                          <label class="color-circle-item" title="{{ color }}">
                                            <input
                                              type="radio"
                                              name="option_color"
                                              value="{{ color }}"
                                              class="color-radio"
                                            >
                                            <span
                                              class="circle custom_color_{{ color | strip | escape | downcase | replace: ' ', '_'   }}"
                                            ></span>
                                            <span class="label">{{ color }}</span>
                                          </label>
                                        {% endfor %}
                                      </div>
                                    </div>
                                  {% when 'color_circles_btext' %}
                                    <div class="option-block color-circles">
                                      <label>{{ block.settings.label }}</label>
                                      <div class="color-circle-list">
                                        {% for color in option.values %}
                                          <label class="color-circle-item" title="{{ color }}">
                                            <input
                                              type="radio"
                                              name="option_color"
                                              value="{{ color }}"
                                              class="color-radio"
                                            >
                                            <span
                                              class="circle custom_color_{{ color | strip | escape | downcase | replace: ' ', '_'   }}"
                                            ></span>
                                            <span class="label">{{ color }}</span>
                                          </label>
                                        {% endfor %}
                                      </div>
                                    </div>
                                  {% when 'color_circles_btext_active' %}
                                    <div class="option-block color-circles color-circles-active">
                                      <label>{{ block.settings.label }}</label>
                                      <div class="color-circle-list">
                                        {% for color in option.values %}
                                          <label class="color-circle-item" title="{{ color }}">
                                            <input
                                              type="radio"
                                              name="option_color"
                                              value="{{ color }}"
                                              class="color-radio"
                                            >
                                            <span
                                              class="circle custom_color_{{ color | strip | escape | downcase | replace: ' ', '_'   }}"
                                            ></span>
                                            <span class="label">{{ color }}</span>
                                          </label>
                                        {% endfor %}
                                      </div>
                                    </div>
                                  {% when 'color_circles_lbtext' %}
                                    <div class="option-block color-circles color-circles-active">
                                      <label>{{ block.settings.label }}: <span class="active-color"></span></label>
                                      <div class="color-circle-list">
                                        {% for color in option.values %}
                                          <label class="color-circle-item" title="{{ color }}">
                                            <input
                                              type="radio"
                                              name="option_color"
                                              value="{{ color }}"
                                              class="color-radio"
                                              data-label="{{ color }}"
                                            >
                                            <span
                                              class="circle custom_color_{{ color | strip | escape | downcase | replace: ' ', '_'   }}"
                                            ></span>
                                          </label>
                                        {% endfor %}
                                      </div>
                                    </div>
                                {% endcase %}
                              {% endif %}

                            {% when 'size', 'sizes' %}
                              {% assign size_option = option %}
                              {% if size_option != blank and size_option.values.size > 0 %}
                                <div class="option-block size-buttons">
                                  <label>{{ block.settings.label_size }}</label>
                                  <div class="size-button-list">
                                    {% for size in size_option.values %}
                                      <div class="size-button" data-size="{{ size }}">{{ size }}</div>
                                    {% endfor %}
                                  </div>
                                </div>
                              {% endif %}

                            {% else %}
                              {% if product.has_only_default_variant %}
                                {% comment %} option 0 {% endcomment %}
                              {% else %}
                                {% assign indexiteration = forloop.index0 %}
                                {% assign opt = product.options_with_values[indexiteration].name %}
                                {% if opt != blank %}
                                  {% assign option = product.options_with_values[indexiteration] %}
                                  {% assign name_op = option.name | downcase %}
                                  {% if name_op != 'color' and name_op != 'size' %}
                                    <div class="option-group custom-variant-select">
                                      <label>{{ name_op }}</label>
                                      <div class="custom-select" tabindex="0">
                                        <div class="select-trigger">Select option</div>
                                        <div class="select-options">
                                          {% for velue in option.values %}
                                            <div
                                              class="option-value"
                                              data-value="{{ velue.name }}"
                                              data-option-name="{{ option.name }}"
                                            >
                                              {{ velue.name }}
                                            </div>
                                          {% endfor %}
                                        </div>
                                      </div>
                                    </div>
                                  {% endif %}
                                {% endif %}
                              {% endif %}
                          {% endcase %}
                        {% endfor %}
                      </custom-variant>
                    </div>
                  {%- endunless -%}
              {% endcase %}

              {% comment %} Check if we should close the square-icon-grid wrapper {% endcomment %}
              {% if block.type == 'square_icon' %}
                {% comment %} Check if next block is NOT square_icon - if so, close wrapper {% endcomment %}
                {% assign next_index = forloop.index %}
                {% if next_index < section.blocks.size %}
                  {% assign next_block = section.blocks[next_index] %}
                  {% if next_block.type != 'square_icon' %}
                    </div>
                    </div>
                  {% endif %}
                {% else %}
                  {% comment %} This is the last block, close wrapper {% endcomment %}
                  </div>
                  </div>
                {% endif %}
              {% endif %}

              {% comment %} Check if we should close the square-icon-grid-row wrapper {% endcomment %}
              {% if block.type == 'square_icon_row' %}
                {% comment %} Check if next block is NOT square_icon_row - if so, close wrapper {% endcomment %}
                {% assign next_index_row = forloop.index %}
                {% if next_index_row < section.blocks.size %}
                  {% assign next_block_row = section.blocks[next_index_row] %}
                  {% if next_block_row.type != 'square_icon_row' %}
                    </div>
                    </div>
                  {% endif %}
                {% else %}
                  {% comment %} This is the last block, close wrapper {% endcomment %}
                  </div>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="json_prod_var">
  {{ product.variants | json }}
</script>
<script type="application/json" id="json_prod_options">
  {{ product.options_with_values | json }}
</script>

