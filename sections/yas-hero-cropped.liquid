                            <span class="star_span">
                              {% for i in (1..5) %}
                                {% render 'star_comparison' %}
                              {% endfor %}
                            </span>
                          </span>
                        </div>

                        <div class="review-text">
                          {{ block.settings['review-text'] }}
                        </div>
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="swiper-pagination"></div>
    {% if section.blocks.size > 1 %}
      <div class="swiper-b-prev" aria-label="Previous slide">{% render 'arrow-left-hero-svg' %}</div>
      <div class="swiper-b-next" aria-label="Next slide">{% render 'arrow-right-hero-svg' %}</div>
    {% endif %}
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var rootSel = '.hero-cropped-banner';
    var root = document.querySelector(rootSel);
    if (!root) return;

    var swiper = new Swiper(rootSel + ' .swiper-container', {
      loop: true,
      spaceBetween: 30,
      effect: 'fade',
      fadeEffect: { crossFade: true },
      navigation: {
        nextEl: rootSel + ' .swiper-b-next',
        prevEl: rootSel + ' .swiper-b-prev',
      },
      pagination: {
        el: rootSel + ' .swiper-pagination',
        clickable: true,
      },
      autoHeight: true,
      a11y: { enabled: true },
      keyboard: { enabled: true },
      watchOverflow: true,
    });
  });
</script>
