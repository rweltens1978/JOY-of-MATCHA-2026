{% assign firstarticle = '' %}
{%- for article in blog.articles -%}
  {% if forloop.first %}
    {% assign firstarticle = article %}
    {% break %}
  {% endif %}
{%- endfor -%}
{% assign postperpage = section.settings.post_per_page %}
{%- liquid

  assign section_prefix_class = 'main-blog'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}
{%- stylesheet -%}
  .main-blog_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .main-blog_wrapper {
    padding: var(--xl-padding-y) 0;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    height: auto;
  }

  .main-blog_wrapper.outer-padding,
  .main-blog_wrapper.inner-padding .container {
    background-color: var(--bg-color);
    color: var(--text-color);
  }

  .main-blog_wrapper.outer-padding .container,
  .main-blog_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .article__title,
  .main-blog_wrapper .article__author .text-2.text-grey,
  .article__desc,
  .article__link,
  .article__meta {
    color: var(--text-color);
    transition: all 0.3s ease;
  }

  .article__link:hover,
  .article__title:hover {
    color: var(--link-hover-color);
  }

  .main-blog_wrapper .article--featured.bg-info-scale-1 {
    background-color: var(--card-background-color);
  }

  .main-blog_wrapper .article--featured .article__title,
  .main-blog_wrapper .article--featured .article__author .text-2.text-grey,
  .main-blog_wrapper .article--featured .article__desc,
  .main-blog_wrapper .article--featured .article__link,
  .main-blog_wrapper .article--featured .article__meta {
    color: var(--card-text-color);
  }

  .main-blog_wrapper .article--featured .article__link:hover,
  .main-blog_wrapper .article--featured .article__title:hover {
    color: var(--card-link-color);
  }

  .blog__tab-list li a,
  .blog__tab-list .tab__item.active{
    color: var(--tabset-color);
    transition: all 0.3s ease;
  }

  .blog__tab-list li a:hover,
  .blog__tab-list .tab__item.active:hover{
    color: var(--tabset-hover-color);
  }

  .blog__tab-list .tab__item:before {
    content: '';
    left: 0;
    width: 0;
    bottom: 0;
    opacity: 0;
    height: 2px;
    position: absolute;
    border-bottom: 2px solid var(--tabset-color);
    transition: all 0.3s ease-in-out;
    -webkit-transition: all 0.3s ease-in-out;
    -moz-transition: all 0.3s ease-in-out;
    -ms-transition: all 0.3s ease-in-out;
    -o-transition: all 0.3s ease-in-out; 
  }

  .tab__list{
    border-bottom: 1px solid var(--tabset-color);
  }

  .main-blog_wrapper .pagination__list li{
    color: var(--pagination-text-color);
  }

  @media (min-width: 992px) {
    .main-blog_wrapper.outer-padding:has(.container-fluid),
    .main-blog_wrapper.outer-padding:has(.container) {
      padding-left: var(--xl-padding-x);
      padding-right: var(--xl-padding-x);
    }

    .main-blog_wrapper.inner-padding .container {
      --cp-spacer-left: var(--xl-padding-x);
      --cp-spacer-right: var(--xl-padding-x);
    }
  }

  @media (max-width: 991px) {
    .main-blog_wrapper.outer-padding:has(.container-fluid),
    .main-blog_wrapper.outer-padding:has(.container) {
      padding-left: var(--xs-padding-x);
      padding-right: var(--xs-padding-x);
    }

    .main-blog_wrapper.inner-padding .container {
      --cp-spacer-left: var(--xs-padding-x);
      --cp-spacer-right: var(--xs-padding-x);
    }

    .main-blog_wrapper {
      padding: var(--xs-padding-y) 0;
    }
  }
{%- endstylesheet -%}
{%- paginate blog.articles by postperpage -%}
  <div
