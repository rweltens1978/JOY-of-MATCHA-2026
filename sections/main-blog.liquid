    style="
      --text-color: {{ section.settings.text_color }};
      --xl-padding-x: {{ section.settings.padding_x_desk }}px;
      --xl-padding-y: {{ section.settings.padding_y_desk }}px;
      --xs-padding-x: {{ section.settings.padding_x_mob }}px;
      --xs-padding-y: {{ section.settings.padding_y_mob }}px;
      --bg-color: {{ section.settings.background_color }};
      --link-hover-color: {{ section.settings.link_hover_color }};
      --card-background-color: {{ section.settings.card_background_color }};
      --card-text-color: {{ section.settings.card_text_color }};
      --card-link-color: {{ section.settings.card_link_color }};
      --tabset-color: {{ section.settings.tabset_color }};
      --tabset-hover-color: {{ section.settings.tabset_hover_color }};
      --pagination-text-color: {{ section.settings.pagination_text_color }};
      --custom-width: {{ section.settings.custom_page_width }};
    "
  >
    <div class="{{ section_width }}">
      <div class="pure-g">
        <div class="pure-u-1">
          {% if section.settings.title != blank %}
            <div class="blog__head text-center">
              <h1 class="title mb-md-30">{{ section.settings.title }}</h1>
            </div>
          {% endif %}
          {%- if section.settings.enable_tag_categories and blog.all_tags.size > 0 -%}
            <div class="tabs blog__tab mb-15 mb-md-30">
              <ul class="tab__list blog__tab-list">
                <li>
                  <a href="/blogs/{{ blog.handle }}" class="tab__item {% if current_tags == blank %}active{% endif %}">
                    {{- section.settings.all_blogs_title -}}
                  </a>
                </li>
                {%- for tag in blog.all_tags -%}
                  <li>
                    <a
                      href="/blogs/{{ blog.handle }}/tagged/{{ tag | handle }}"
                      class="tab__item {% if current_tags contains tag %}active{% endif %}"
                    >
                      {{- tag -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {% endif %}
        </div>
      </div>

      {% if firstarticle.title != blank %}
        <div class="pure-g">
          <div class="pure-u-1">
            <div class="article article--featured bg-info-scale-1 xs-full-width">
              <figure class="article__img pure-u-1 pure-u-lg-1-2">
                <a href="{{ firstarticle.url }}" class="ratio4by2">
                  {% if firstarticle.image != blank %}
                    {%- liquid
                      assign max_width = firstarticle.image.width
                      if firstarticle.image > 1244
                        assign max_width = 1244
                      endif
                      assign image_height = max_width | divided_by: firstarticle.image.aspect_ratio | round

                      capture image_alt
                        unless firstarticle.image.alt == blank
                          echo firstarticle.image.alt
                        else
                          echo firstarticle.title | escape
                        endunless
                      endcapture
                    -%}
                    {{-
                      firstarticle.image
                      | image_url: width: max_width
                      | image_tag:
                        loading: 'eager',
                        width: max_width,
                        sizes: '(max-width: 1023px) calc(100vw - 66px), (max-width: 1199px) calc((100vw / 2) - 30px), 32.396vw',
                        height: image_height,
                        alt: image_alt,
                        class: 'pure-img lazyload svg__thumb'
                    -}}
                  {% else %}
                    {%- render 'placeholder-svgs', type: 'blog', index: 1, class: 'object-fit object-fit--absolute' -%}
                  {% endif %}
                </a>
              </figure>
              <div class="article__content pure-u-1 pure-u-lg-1-3">
                {% if section.settings.show_date != blank or section.settings.show_author != blank %}
                  <div class="article__meta d-none d-lg-block">
                    <div class="article__author">
                      <span class="text-2">
                        {%- if section.settings.show_date != blank %}
                          {{- firstarticle.published_at | time_tag: format: 'date' -}}
                        {% endif -%}
                        {%- if section.settings.show_author != blank %} by {{ firstarticle.author -}}{% endif -%}
                      </span>
                    </div>
                  </div>
                {% endif %}
                <a href="{{ firstarticle.url }}" class="article__title">{{ firstarticle.title | escape }}</a>
                {% if section.settings.show_date != blank or section.settings.show_author != blank %}
                  <div class="article__meta d-block d-lg-none">
                    <div class="article__author"> 
                      <span class="text-2">
                        {%- if section.settings.show_date != blank -%}
                          {{- firstarticle.published_at | date: '%b %d, %y' -}}
                        {%- endif -%}
                        {%- if section.settings.show_author != blank %} by {{ firstarticle.author -}}{% endif -%}
                      </span>
                    </div>
                  </div>
                {% endif %}
                {% if firstarticle.excerpt.size > 0 %}
                  <div class="article__desc">
                    {{ firstarticle.excerpt }}
                  </div>
                {% endif %}
                <a href="{{ firstarticle.url }}" class="article__link text-2 fw-700 td-none">
                  {{- section.settings.read_more_text -}}
                </a>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
      <div class="pure-g gutter-xl-45">
        {%- for article in blog.articles -%}
          {%- liquid
            assign blogLoopCounter = forloop.index

            assign placeholder_index = forloop.index | modulo: 3
            if placeholder_index == 0
              assign placeholder_index = 3
            endif
