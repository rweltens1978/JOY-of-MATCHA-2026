                                              assign max_width = settings.payment_icon_5.width
                                              if settings.payment_icon_5 > 48
                                                assign max_width = 48
                                              endif
                                              assign image_height = max_width | divided_by: settings.payment_icon_5.aspect_ratio | round

                                              capture image_alt
                                                unless settings.payment_icon_5.alt == blank
                                                  echo settings.payment_icon_5.alt
                                                else
                                                  echo firstarticle.title | escape
                                                endunless
                                              endcapture
                                            -%}
                                            {{-
                                              settings.payment_icon_5
                                              | image_url: width: max_width
                                              | image_tag:
                                                loading: 'lazy',
                                                width: max_width,
                                                height: image_height,
                                                alt: image_alt,
                                                class: 'pure-img lazyload'
                                            -}}
                                          </li>
                                        {% endif %}
                                        {% if settings.payment_icon_6 != blank %}
                                          <li>
                                            {%- liquid
                                              assign max_width = settings.payment_icon_6.width
                                              if settings.payment_icon_6 > 48
                                                assign max_width = 48
                                              endif
                                              assign image_height = max_width | divided_by: settings.payment_icon_6.aspect_ratio | round

                                              capture image_alt
                                                unless settings.payment_icon_6.alt == blank
                                                  echo settings.payment_icon_6.alt
                                                else
                                                  echo firstarticle.title | escape
                                                endunless
                                              endcapture
                                            -%}
                                            {{-
                                              settings.payment_icon_6
                                              | image_url: width: max_width
                                              | image_tag:
                                                loading: 'lazy',
                                                width: max_width,
                                                height: image_height,
                                                alt: image_alt,
                                                class: 'pure-img lazyload'
                                            -}}
                                          </li>
                                        {% endif %}
                                      </ul>
                                    {% endif %}
                                  {% endif %}
                                {% endif %}
                                {% if block.settings.show_reviews != blank %}
                                  {% if settings.reviews_ratings != blank or settings.reviews_text != blank %}
                                    <div class="rating justify-content-center">
                                      {% if settings.reviews_ratings != blank %}
                                        <span class="rating__star">
                                          {%- liquid
                                            assign max_width = settings.reviews_ratings.width
                                            if settings.reviews_ratings > 30
                                              assign max_width = 30
                                            endif
                                            assign image_height = max_width | divided_by: settings.reviews_ratings.aspect_ratio | round

                                            capture image_alt
                                              unless settings.reviews_ratings.alt == blank
                                                echo settings.reviews_ratings.alt
                                              else
                                                echo 'image_alternative.static' | t
                                              endunless
                                            endcapture
                                          -%}
                                          {{-
                                            settings.reviews_ratings
                                            | image_url: width: max_width
                                            | image_tag:
                                              loading: 'lazy',
                                              width: max_width,
                                              sizes: '(max-width: 767px) 100vw, (max-width: 1023px) calc(100vw - 30px), 35.573vw',
                                              height: image_height,
                                              alt: image_alt,
                                              class: ''
                                          -}}
                                        </span>
                                      {% endif %}
                                      {% if settings.reviews_text != blank %}
                                        <span class="rating__text">{{ settings.reviews_text }}</span>
                                      {% endif %}
                                    </div>
                                  {% endif %}
                                {% endif %}
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!-- Highlight -->
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {%- endfor -%}
      </div>
    </div>
    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "all_blogs_title",
      "label": "All blogs title",
      "default": "Show all"
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more text",
      "default": "Continue reading"
    },
    {
      "type": "text",
      "id": "posted_on_text",
      "label": "Posted on text",
      "default": "Posted on"
    },
    {
      "type": "number",
      "id": "post_per_page",
      "label": "Post per page",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "enable_tag_categories",
      "label": "Enable tag categories",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "contained-content",
          "label": "Contained content"
        },
        {
          "value": "container-fluid",
          "label": "Edge to edge"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_width",
      "label": "Enable custom page width",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_page_width",
      "label": "Custom page width",
      "min": 1292,
      "max": 1600,
      "step": 4,
      "default": 1472,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_width }}"
    },
    {
      "type": "header",
      "content": "Tabset settings"
    },
    {
      "type": "color",
      "id": "tabset_color",
      "label": "Tabset color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tabset_hover_color",
      "label": "Tabset hover color",
      "default": "#3f3f3f"
    },
    {
      "type": "header",
      "content": "Featured blog card"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_link_color",
      "label": "Card link color",
      "default": "#3f3f3f"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#3f3f3f"
    },
    {
      "type": "header",
      "content": "Pagination settings"
    },
    {
      "type": "color",
      "id": "pagination_text_color",
      "label": "Pagination text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_x_desk",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_y_desk",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_x_mob",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_y_mob",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding (Mobile)",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "number",
          "id": "after_post_number",
          "label": "After post number",
          "info": "Show banner after which post number"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color"
        },
        {
          "type": "select",
          "id": "size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "label": "Size",
          "default": "small"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "sub_title",
          "label": "Sub title"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "checkbox",
          "id": "show_payment_icons",
          "label": "Show payment icons"
        },
        {
          "type": "checkbox",
          "id": "show_reviews",
          "label": "Show Flash",
          "default": true
        }
      ]
    }
  ]
}
{% endschema %}
