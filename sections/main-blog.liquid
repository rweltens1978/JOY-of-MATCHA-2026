                                          capture image_alt
                                            unless settings.payment_icon_1.alt == blank
                                              echo settings.payment_icon_1.alt
                                            else
                                              echo firstarticle.title | escape
                                            endunless
                                          endcapture
                                        -%}
                                        {{-
                                          settings.payment_icon_1
                                          | image_url: width: max_width
                                          | image_tag:
                                            loading: 'lazy',
                                            width: max_width,
                                            height: image_height,
                                            alt: image_alt,
