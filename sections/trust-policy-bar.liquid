{% schema %}
{
  "name": "Trust policy bar",
  "tag": "section",
  "class": "section logo_carousel trust-policy-bar announcement-bar",
  "settings": [
    {
      "type": "header",
      "content": "General settings"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "font_variant",
      "label": "Font family",
      "options": [
        {
          "value": "default",
          "label": "Default by theme"
        },
        {
          "value": "custom",
          "label": "Own choice"
        }
      ],
      "default": "default"
    },
    {
      "type": "font_picker",
      "label": "Regular font",
      "id": "title_font",
      "default": "montserrat_n4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "contained-content",
          "label": "Contained content"
        },
        {
          "value": "container-fluid",
          "label": "Edge to edge"
        }
      ],
      "default": "container-fluid"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_width",
      "label": "Enable custom page width",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_page_width",
      "label": "Custom page width",
      "min": 1292,
      "max": 1600,
      "step": 4,
      "default": 1472,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_width }}"
    },
    {
      "type": "range",
      "id": "padding_x_desk",
      "label": "Horizontal padding",
      "info": "for desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_y_desk",
      "label": "Vertical padding",
      "info": "for desktop",
      "min": 0,
      "max": 100,
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_x_mob",
      "label": "Horizontal padding",
      "info": "for mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_y_mob",
      "label": "Vertical padding",
      "info": "for mobile",
      "min": 0,
      "max": 50,
      "default": 16
    },
    {
      "type": "select",
      "id": "display_on",
      "label": "Display on",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile_only",
          "label": "Mobile only"
        },
        {
          "value": "desktop_only",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Carousel settings"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (seconds)",
      "min": 25,
      "max": 100,
      "step": 1,
      "default": 45
    },
    {
      "type": "range",
      "id": "gap_icon",
      "label": "Gap icons",
      "min": 5,
      "max": 100,
      "step": 1,
      "default": 34
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "|"
    },
    {
      "type": "image_picker",
      "id": "separator_img",
      "label": "Image separator"
    },
    {
      "type": "select",
      "id": "scroll_setting",
      "label": "scroll setting",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_img",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "icon_google",
          "label": "Google icon"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust policy bar",
      "category": "Info",
      "blocks": [
        {
          "type": "text_block",
          "settings": {
            "text": "<p>FREE UK SHIPPING</p>"
          }
        },
