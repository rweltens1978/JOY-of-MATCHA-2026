{%- liquid
  assign section_prefix_class = 'main-icon-bar-one'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}
{%- stylesheet -%}
  .main-icon-bar-one_wrapper {
    display: var(--display-value);
    color: var(--text-color);
  }

  .main-icon-bar-one_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .main-icon-bar-one_container-wrapper {
    padding: var(--xl-padding-y) 0;
  }

  .inner-padding .main-icon-bar-one_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .main-icon-bar-one_container-wrapper {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-icon-bar-one_wrapper.inner-padding .container {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-icon-bar-one_wrapper.outer-padding .container {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .main-icon-bar-one_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-x);
    padding-right: var(--xl-padding-x);
  }

  .main-icon-bar-one_wrapper.inner-padding .container,
  .main-icon-bar-one_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-x);
    --cp-spacer-right: var(--xl-padding-x);
  }

  .main-icon-bar-one_content-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .main-icon-bar-one .heading {
    text-align: var(--heading-align);
    margin-bottom: 40px;
    width: 100%;
  }

  .main-icon-bar-one .wrapp_icon {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 50px;
    width: 100%;
  }

  .main-icon-bar-one .icon_item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 200px;
    gap: 16px;
  }

  .main-icon-bar-one .icon_item-img {
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-icon-bar-one .icon_item-img img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .main-icon-bar-one .icon_item-img svg {
    border-radius: 50%;
  }

  .main-icon-bar-one .title h1,
  .main-icon-bar-one .title h2,
  .main-icon-bar-one .title h3,
  .main-icon-bar-one .title p {
    font-size: var(--xl-heading-size);
    line-height: 110%;
    font-weight: 700;
    text-transform: var(--heading-transform);
    color: var(--text-color);
    text-align: var(--heading-align);
    margin: 0 0 16px 0;
  }

  .main-icon-bar-one .subtitle h1,
  .main-icon-bar-one .subtitle h2,
  .main-icon-bar-one .subtitle h3,
  .main-icon-bar-one .subtitle p {
    font-size: 24px;
    font-weight: 500;
    line-height: 150%;
    color: var(--subtitle-color);
    text-align: var(--heading-align);
    margin: 0;
  }

  .main-icon-bar-one .icon_item h4 {
    color: var(--icn-color);
  }

  .main-icon-bar-one a {
    transition: all 0.3s ease;
  }

  .main-icon-bar-one a:hover {
    color: var(--color-bg-btn);
  }

  .main-icon-bar-one .icon-heading {
    font-size: 18px;
    line-height: 120%;
    font-weight: 500;
  }

  .main-icon-bar-one .icon_item h4 {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .main-icon-bar-one_wrapper {
      display: var(--xs-display-value);
    }

    .main-icon-bar-one .subtitle h1,
    .main-icon-bar-one .subtitle h2,
    .main-icon-bar-one .subtitle h3,
    .main-icon-bar-one .subtitle p {
      font-size: 20px;
      font-weight: 500;
    }

    .main-icon-bar-one .icon-heading {
      font-size: 16px;
    }

    .outer-padding .main-icon-bar-one_container-wrapper:has(.container) {
      padding-left: var(--xs-padding-x);
      padding-right: var(--xs-padding-x);
    }

    .main-icon-bar-one_wrapper.inner-padding .container,
    .main-icon-bar-one_wrapper.outer-padding .container-fluid {
      --cp-spacer-left: var(--xs-padding-x);
      --cp-spacer-right: var(--xs-padding-x);
    }

    .main-icon-bar-one_container-wrapper {
      padding: var(--xs-padding-y) 0;
    }

    .main-icon-bar-one .title h1,
    .main-icon-bar-one .title h2,
    .main-icon-bar-one .title h3,
    .main-icon-bar-one .title p {
      font-size: var(--xs-heading-size);
      line-height: 100%;
    }

    .main-icon-bar-one .wrapp_icon {
      gap: 40px 23px;
      max-width: 390px;
      margin: 0 auto;
    }

    .main-icon-bar-one .icon_item {
      max-width: 160px;
      gap: 24px;
      flex: 1 1 45%;
    }

    .main-icon-bar-one .icon_item-img {
      max-width: 70px;
    }

    .main-icon-bar-one .icon_item h4 {
      font-size: 18px;
      line-height: 21.94px;
    }

    .icon_bar_1 .wrapp_icon {
      gap: 44px !important;
    }
  }
{%- endstylesheet -%}

<style>
  /* Font overrides */
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .main-icon-bar-one :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
  {% endif %}
</style>

<div
  class="{{ section_prefix_class }}_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  style="
    --icn-color: {{ section.settings.icon_color }};
    --subtitle-color: {{ section.settings.subtitle_color }};
    --heading-transform: {{ section.settings.headline_typography }};
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xl-heading-size: 28px;
      {% when 'medium' %}
      --xl-heading-size: 40px;
      {% when 'large' %}
      --xl-heading-size: 48px;
    {% endcase %}
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xs-heading-size: 20px;
      {% when 'medium' %}
      --xs-heading-size: 32px;
      {% when 'large' %}
      --xs-heading-size: 32px;
    {% endcase %}
    {% case section.settings.heading_align %}
      {% when 'left' %}
      --heading-align: left;
      {% when 'center' %}
      --heading-align: center;
      {% when 'right' %}
      --heading-align: right;
    {% endcase %}
    {% if section.settings.section_width == 'full' %}
    --width-value: 100%;
    {% else %}
    --width-value: {{ settings.page_width }}px;
    {% endif %}
    --text-color: {{ section.settings.text_color }};
    --bg-color: {{ section.settings.background_color }};
    --xl-padding-x: {{ section.settings.padding_x_desk }}px;
    --xl-padding-y: {{ section.settings.padding_y_desk }}px;
    --xs-padding-x: {{ section.settings.padding_x_mob }}px;
    --xs-padding-y: {{ section.settings.padding_y_mob }}px;
    {% case section.settings.display_on %}
      {% when 'all' %}
        --xs-display-value: block;
      {% when 'mobile_only' %}
        --xs-display-value: block;
      {% when 'desktop_only' %}
        --xs-display-value: none;
    {% endcase %}
    {% case section.settings.display_on %}
      {% when 'all' %}
        --display-value: block;
      {% when 'mobile_only' %}
        --display-value: none;
      {% when 'desktop_only' %}
        --display-value: block;
    {% endcase %}
  "
>
  <div
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="      --custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_width }}">
      <div class="{{ section_prefix_class }}_content-wrapper">
        {%- if section.settings.title != blank or section.settings.under_title_text != blank -%}
          <div class="heading word--break">
            <div class="title word--break">
              {%- if section.settings.title != blank -%}
                {{ section.settings.title }}
              {%- endif -%}
            </div>
            <div class="subtitle word--break">
              {%- if section.settings.subtitle != blank -%}
                {{ section.settings.subtitle }}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="wrapp_icon">
          {% for block in section.blocks %}
            {%- liquid
              assign placeholder_index = forloop.index | modulo: 4
              if placeholder_index == 0
                assign placeholder_index = 4
              endif
            -%}
            <div class="icon_item">
              <div class="icon_item-img">
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign max_width = block.settings.image.width
                    if block.settings.image > 80
                      assign max_width = 80
                    endif
                    assign image_height = max_width | divided_by: block.settings.image.aspect_ratio | round

                    capture image_alt
                      if block.settings.image.alt != blank
                        echo block.settings.image.alt
                      elsif block.settings.after_image.alt == blank
                        echo 'Icon'
                      else
                        echo block.settings.title
                      endif
                    endcapture
                  -%}
                  {{-
                    block.settings.image
                    | image_url: width: max_width
                    | image_tag: loading: 'lazy', width: max_width, height: image_height, alt: image_alt, class: ''
                  -}}
                {%- else -%}
                  {%- render 'placeholder-svgs', type: 'product', index: placeholder_index, class: '' -%}
                {%- endif -%}
              </div>
              <h4 class="icon-heading word--break">{{ block.settings.title }}</h4>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon Bar 1",
  "tag": "section",
  "class": "section icon_bar_1 main-icon-bar-one",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<h2>Why thousands of people choose us</h2>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<h3>Experience the [benefit] with our trusted products and support.</h3>"
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "headline_typography",
      "label": "Headline Typography",
      "options": [
        {
          "value": "uppercase",
          "label": "AA"
        },
        {
          "value": "capitalize",
          "label": "Aa"
        },
        {
          "value": "lowercase",
          "label": "aa"
        }
      ],
      "default": "capitalize"
    },
    {
      "type": "select",
      "id": "font_variant",
      "label": "Font Family",
      "options": [
        {
          "value": "default",
          "label": "Default by theme"
        },
        {
          "value": "custom",
          "label": "Own choice"
        }
      ],
      "default": "default"
    },
    {
      "type": "font_picker",
      "label": "Regular Font",
      "id": "title_font",
      "default": "montserrat_n4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "contained-content",
          "label": "Contained content"
        },
        {
          "value": "container-fluid",
          "label": "Edge to edge"
        }
      ],
      "default": "contained-content"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_width",
      "label": "Enable custom page width",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_page_width",
      "label": "Custom page width",
      "min": 1292,
      "max": 1600,
      "step": 4,
      "default": 1472,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_width }}"
    },
    {
      "type": "range",
      "id": "padding_x_desk",
      "label": "Horizontal Padding",
      "info": "for desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_y_desk",
      "label": "Vertical Padding",
      "info": "for desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_x_mob",
      "label": "Horizontal Padding",
      "info": "for mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_y_mob",
      "label": "Vertical Padding",
      "info": "for mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "select",
      "id": "display_on",
      "label": "Display On",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile_only",
          "label": "Mobile Only"
        },
        {
          "value": "desktop_only",
          "label": "Desktop Only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Icon Settings"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "icon_block",
      "name": "icon block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title For Block"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Bar 1",
      "category": "Icons",
      "blocks": [
        {
          "type": "icon_block",
          "settings": {
            "title": "USP #1"
          }
        },
        {
          "type": "icon_block",
          "settings": {
            "title": "USP #2"
          }
        },
        {
          "type": "icon_block",
          "settings": {
            "title": "USP #3"
          }
        },
        {
          "type": "icon_block",
          "settings": {
            "title": "USP #4"
          }
        },
        {
          "type": "icon_block",
          "settings": {
            "title": "USP #5"
          }
        },
        {
          "type": "icon_block",
          "settings": {
            "title": "USP #6"
          }
        }
      ]
    }
  ]
}
{% endschema %}
