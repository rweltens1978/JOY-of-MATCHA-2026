<section
  class="product-benefits-section {{ section_prefix_class }}_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  style="
    {% case section.settings.display_on %}
      {% when 'all' %}
        --xs-display-value: block;
      {% when 'mobile_only' %}
        --xs-display-value: block;
      {% when 'desktop_only' %}
        --xs-display-value: none;
    {% endcase %}
    {% case section.settings.display_on %}
      {% when 'all' %}
        --display-value: block;
      {% when 'mobile_only' %}
        --display-value: none;
      {% when 'desktop_only' %}
        --display-value: block;
    {% endcase %}
    --text-align: {{ section.settings.heading_align }};
    --text-transform: {{ section.settings.headline_typography }};
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --font-size: 28px;
      {% when 'medium' %}
      --font-size: 40px;
      {% when 'large' %}
      --font-size: 48px;
    {% endcase %}
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --sm-font-size: 20px;
      {% when 'medium' %}
      --sm-font-size: 32px;
      {% when 'large' %}
      --sm-font-size: 32px;
    {% endcase %}
    --tittle-color: {{ section.settings.text_color }};
    --bg-color:  {{ section.settings.background_color }};
    --xl-padding-x: {{ section.settings.padding_lr_desk }}px;
    --xl-padding-y: {{ section.settings.padding_tb_desk }}px;
    --xs-padding-y: {{ section.settings.padding_tb_mob }}px;
    --xs-padding-x: {{ section.settings.padding_lr_mob }}px;
    --text-transform: {{ section.settings.headline_typography }};
    --text-align: {{ section.settings.heading_align }};
    --text-color: {{ section.settings.subtext_color }};
    {% case section.settings.subheading_size %}
      {% when 'small' %}
      --mxs-font-size: 12px;
      {% when 'medium' %}
      --mxs-font-size: 16px;
      {% when 'large' %}
      --mxs-font-size: 20px;
    {% endcase %}
       {% case section.settings.subheading_size %}
      {% when 'small' %}
      --mb-font-size: 15px;
      {% when 'medium' %}
      --mb-font-size: 20px;
      {% when 'large' %}
      --mb-font-size: 24px;
    {% endcase %}
    --text-align: {{ section.settings.heading_align }};
    {% if section.settings.layout_order_mobile == 'reverse' %}
      --order-value: 2;
    {% else %}
      --order-value: 1;
    {% endif %}
    --width-value: {{ section.settings.image_width_desktop }}px;
    --height-value: {{ section.settings.image_height_desktop }}px;
    --xs-width-value: {{ section.settings.image_width_mobile }}px;
    --xs-height-value: {{ section.settings.image_height_mobile }}px;
  "
>
  <div
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="      --custom-width: {{ section.settings.custom_page_width }};"
  >
    <div class="{{ section_width }}">
      <div class="product-benefits-wrapper">
        <div class="section_header">
          {%- if section.settings.title != blank -%}
            <div
              class="title"
            >
              {{ section.settings.title }}
            </div>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <div
              class="subtitle"
            >
              {{ section.settings.subtitle }}
            </div>
          {%- endif -%}
        </div>
        <div class="product-benefits-middle">
          <div
            class="product-benefits-details"
          >
            <div
              class="product-benefits-rouded"
              style="
                --gradient-bottom: {{ section.settings.gradient_bottom }};
                --gradient-top: {{ section.settings.gradient_top }};
              "
            >
              <div class="product-benefits-image">
                {% if section.settings.pdimage != blank %}
                  {%- liquid
                    assign max_width = section.settings.pdimage.width
                    if section.settings.pdimage > 300
                      assign max_width = 300
                    endif
                    assign image_height = max_width | divided_by: section.settings.pdimage.aspect_ratio | round

                    capture image_alt
                      unless section.settings.pdimage.alt == blank
                        echo section.settings.pdimage.alt
                      else
                        echo 'image_alternative.static' | t
                      endunless
                    endcapture
                  -%}
                  {{-
                    section.settings.pdimage
                    | image_url: width: max_width
                    | image_tag:
                      loading: 'lazy',
                      width: max_width,
                      height: image_height,
                      alt: image_alt,
                      class: 'product_image'
                  -}}
                {% else %}
                  {%- render 'placeholder-svgs', type: 'product', index: 1, class: 'product_image' -%}
                {% endif %}
              </div>
            </div>
          </div>
          <div
            class="product-benefits-content"
            style="
              {% if section.settings.layout_order_mobile == 'reverse' %}
                --order-value: 1;
              {% else %}
                --order-value: 2;
              {% endif %}
            "
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign placeholder_index = forloop.index | modulo: 4
                if placeholder_index == 0
                  assign placeholder_index = 4
                endif
              -%}
              <div class="product-benefit-block product-benefit-block-{{ forloop.index }}">
                <div
                  class="product-benefit-image"
                  style="
                    --width-value: {{ section.settings.image_width_desktop }}px;
                    --height-value: {{ section.settings.image_height_desktop }}px;
                    --xs-width-value: {{ section.settings.image_width_mobile }}px;
                    --xs-height-value: {{ section.settings.image_height_mobile }}px;
                  "
                >
                  {% if block.settings.product_image != blank %}
                    {%- liquid
                      assign max_width = block.settings.product_image.width
                      if block.settings.product_image > 96
                        assign max_width = 96
                      endif
                      assign image_height = max_width | divided_by: block.settings.product_image.aspect_ratio | round

                      capture image_alt
                        unless block.settings.product_image.alt == blank
                          echo block.settings.product_image.alt
                        else
                          echo 'image_alternative.static' | t
                        endunless
                      endcapture
                    -%}
                    {{-
                      block.settings.product_image
                      | image_url: width: max_width
                      | image_tag: loading: 'lazy', width: max_width, height: image_height, alt: image_alt, class: ''
                    -}}
                  {% else %}
                    {%- render 'placeholder-svgs', type: 'collection', index: placeholder_index, class: '' -%}
                  {% endif %}
                </div>

                <div
                  class="product-benefit-description word--break"
                  style="
                    --xs-font-size: {{ section.settings.heading_font_size_mob }}px;
                    --xl-font-size: {{ section.settings.description_font_size_mob }}px;
                    --xxl-font-size: {{ section.settings.heading_font_size_desk }}px;
                    --xl-text-size: {{ section.settings.description_font_size_desk }}px;
                  "
                >
                  <h4
                    class="product-heading word--break"
                  >
                    {% if block.settings.product_text_heading != blank %}
                      {{ block.settings.product_text_heading }}
                    {% else %}
                      Example Heading
                    {% endif %}
                  </h4>

                  {% if block.settings.product_text_description != blank %}
                    {{ block.settings.product_text_description }}
                  {% else %}
                    <p>Help customers understand why this product stands out.</p>
                  {% endif %}
                </div>
              </div>
            {%- endfor -%}

            <div class="product-benefit product-benefit-1 ">
              {% render 'icons', icon_name: 'product-benefit-1' %}
            </div>
            <div class="product-benefit product-benefit-2">
              {% render 'icons', icon_name: 'product-benefit-2' %}
            </div>
            <div class="product-benefit product-benefit-3">
              {% render 'icons', icon_name: 'product-benefit-3' %}
            </div>
            <div class="product-benefit product-benefit-4">
              {% render 'icons', icon_name: 'product-benefit-4' %}
            </div>
            <div class="product-benefit product-benefit-5">
              {% render 'icons', icon_name: 'product-benefit-5' %}
            </div>
            <div class="product-benefit product-benefit-6">
              {% render 'icons', icon_name: 'product-benefit-6' %}
            </div>
          </div>
        </div>
        <div class="product-benefits-cta">
          <div class="button-wrapper">
            <a
              {% if section.settings.btnlink %}
                href="{{ section.settings.btnlink }}"
              {% endif %}
              class="cta-btn"
            >
              {{ section.settings.btnlink_text }}
              {% if section.settings.show_arrow == true %}
                {% if section.settings.icon != blank %}
                  <i class="icon_cart-btns">
                    {%- liquid
                      assign max_width = section.settings.icon.width
                      if section.settings.icon > 150
                        assign max_width = 150
                      endif
                      assign image_height = max_width | divided_by: section.settings.icon.aspect_ratio | round

                      capture image_alt
                        if section.settings.icon.alt != blank
                          echo section.settings.icon.alt
                        else
                          echo 'Icon' | escape
                        endif
                      endcapture
                    -%}
                    {{-
                      section.settings.icon
                      | image_url: width: max_width
                      | image_tag: loading: 'lazy', width: max_width, height: image_height, alt: image_alt, class: ''
                    -}}
                  </i>
                {% elsif section.settings.icon_alt != blank %}
                  <i class="icon_cart-btns material-symbols-outlined">
                    {{ section.settings.icon_alt }}
                  </i>
                {% else %}
                  <i class="icon_cart-btns">
                    {% render 'icon_arrow_submit2' %}
                  </i>
                {% endif %}
              {% endif %}
            </a>
          </div>
          <div class="payment_options">
            <div class="payment_options_stock">
              {% render 'icons', icon_name: 'green-ball' %}
              <span>{{ 'custom_section.product_benefits.stock_limit' | t }}</span>
            </div>
            <div class="payment_options_icons">
              {% assign icons_count = 0 %}
              {% capture icons %}
                {% for i in (1..7) %}
                  {% assign key    = 'payment_icon_' | append: i %}
                  {% assign altkey = 'payment_icon_' | append: i | append: '_alt' %}
                  {% assign icon   = settings[key] %}
                  {% if icon %}
                    {% assign icons_count = icons_count | plus: 1 %}
                    <li>
                    {%- liquid
                      assign max_width = icon.width
                      if icon > 72
                          assign max_width = 72
                      endif
                      assign image_height = max_width | divided_by: icon.aspect_ratio | round

                      capture image_alt
                        if icon.alt != blank
                          echo icon.alt
                        elsif icon.alt == blank
                          echo 'Payment method'
                        else
                          echo settings[altkey]
                        endif
                      endcapture

                      capture sizes_attr
                        echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(60vw - 30px), (max-width: 1199px) 4.706vw'
                      endcapture
                    -%}
                    {{-
                      icon
                      | image_url: width: max_width
                      | image_tag: loading: 'lazy', width: max_width, height: image_height, sizes: sizes_attr, alt: image_alt, class: 'payicon'
                    -}}
                    </li>
                  {% endif %}
                {% endfor %}
              {% endcapture %}
              {% if section.settings.show_payment_icons %}
                <ul class="benefits_payment-icons common_payment-icns">
                  {{ icons }}
                  {%- for type in shop.enabled_payment_types -%}
                    <li>
                      {{ type | payment_type_svg_tag }}
                    </li>
                  {%- endfor -%}
                </ul>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

