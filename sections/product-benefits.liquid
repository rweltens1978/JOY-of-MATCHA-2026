{%- liquid
  assign section_prefix_class = 'product-benefits-section'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}
<style>
  /* Font overrides */
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .product-benefits :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
    .product-benefits .material-symbols-outlined {
      font-family: "Material Symbols Outlined" !important;
      line-height: 1;
      display: inline-block;
    }
  {% endif %}
</style>
{%- stylesheet -%}
  .product-benefits .product-benefits-section {
    letter-spacing: 0;
  }

  .product-benefits-section_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .product-benefits-section_container-wrapper {
    padding: var(--xl-padding-y) 0;
  }

  .inner-padding .product-benefits-section_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .product-benefits-section_container-wrapper {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .product-benefits-section_wrapper.inner-padding .container {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .product-benefits-section_wrapper.outer-padding .container {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .product-benefits-section_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-x);
    --cp-spacer-right: var(--xl-padding-x);
  }

  .outer-padding .product-benefits-section_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-x);
    padding-right: var(--xl-padding-x);
  }

  .product-benefits-section_wrapper.inner-padding .container {
    --cp-spacer-left: var(--xl-padding-x);
    --cp-spacer-right: var(--xl-padding-x);
  }

  .product-benefits-section_content-wrapper {
    text-align: var(--heading-align);
  }

  .product-benefits a,
  .product-benefits-section .button-wrapper .cta-btn,
  .product-benefits-section .button-wrapper .cta-btn svg {
    transition: all 0.3s ease;
  }

  .product-benefits-section .button-wrapper .cta-btn .icon_cart-btns {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .product-benefits-section .button-wrapper .cta-btn .icon_cart-btns img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-benefits-section .button-wrapper .cta-btn:hover svg path {
    fill: #000000;
  }

  .product-benefits-section .button-wrapper .cta-btn:hover {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #000000;
  }

  .product-benefits a:hover {
    color: var(--color-bg-btn);
  }

  .product-benefits {
    display: block;
  }

  .product-benefits .title h2,
  .product-benefits .title h1,
  .product-benefits .title h3,
  .product-benefits .title p {
    font-size: var(--sm-font-size);
    font-weight: 600;
    line-height: 120%;
    color: var(--tittle-color);
    margin-bottom: 20px;
    text-transform: var(--text-transform);
    text-align: var(--text-align);
  }

  .product-benefits .subtitle p,
  .product-benefits .subtitle h1,
  .product-benefits .subtitle h2,
  .product-benefits .subtitle h3 {
    font-size: var(--mxs-font-size);
    line-height: 120%;
    text-align: var(--text-align);
    color: var(--text-color);
    text-transform: var(--text-transform);
    max-width: 800px;
    margin: 0 auto;
  }

  .product-benefits .product-benefits-wrapper {
    text-align: var(--text-align);
  }

  .product-benefits .product-benefit-block .product-heading {
    font-size: var(--xs-font-size);
    line-height: 100%;
  }

  .product-benefits .product-benefit-block p {
    font-size: var(--xl-font-size);
    line-height: 100%;
  }

  .product-benefits-section .product-benefits-rouded::before {
    background: linear-gradient(to bottom, var(--gradient-top), var(--gradient-bottom));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  }

  .product-benefits-section .product_image {
    width: var(--width-value);
    height: var(--height-value);
  }

  .product-benefits-section .title h2,
  .product-benefits-section .title {
    margin-bottom: 0 !important;
  }

  .product-benefits-section .product-benefits-details {
    display: flex;
    justify-content: center;
    height: 303px;
    overflow: hidden;
  }

  .product-benefits-section .product-benefits-rouded {
    width: 350px;
    height: 350px;
    position: relative;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .product-benefits-section .product-benefits-rouded::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 30px;
    opacity: 0.3;
    border-radius: 50%;
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  .product-benefits-content {
    margin-top: 26px;
  }

  .product-benefit-block {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 40px;
  }

  .product-benefit-image {
    min-width: 100px !important;
    min-height: 100px !important;
    height: 100px;
    width: 100px;
    background-color: #fff;
    border-radius: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .product-benefit-image img,
  .product-benefit-image svg {
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }

  .product-benefits-content .benefit_image {
    border-radius: 50%;
  }

  .product-benefit-description {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 100%;
  }

  .product-benefit-description .product-heading {
    margin: 0;
    font-family: 'Material Medium';
  }

  .product-benefit-description p {
    opacity: 0.7;
  }

  .product-benefits-section .product-benefits-cta {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .product-benefits-section .button-wrapper [aria-disabled='true'].cta-btn {
    pointer-events: none;
  }

  .product-benefits-section .button-wrapper .cta-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    background-color: #000000;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    font-size: 16px;
    padding: 17px 40px;
    border-radius: 100px;
  }

  .benefits_payment-icons {
    display: flex;
    gap: 6px;
    justify-content: flex-start;
    flex-wrap: wrap;
    list-style: none;
    align-items: center;
    margin: 0;
    padding-left: 0;
  }

  .product-benefits-section .button-wrapper svg {
    height: 15px;
    width: 15px;
  }

  .product-benefits-section .button-wrapper svg path {
    fill: #ffffff;
  }

  .product-benefits-section .payment_options {
    text-align: left;
  }

  .product-benefits-section .product_image {
    border-radius: 7.75px;
  }

  .payment_options_stock {
    display: none;
  }

  .product-benefit {
    display: none;
  }

  .payment_options_icons img {
    width: 38px;
    height: 26px;
  }

  .product-benefits-wrapper .section_header {
    margin-bottom: 33px;
  }

