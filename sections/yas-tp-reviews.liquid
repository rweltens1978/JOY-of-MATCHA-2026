{%- liquid
  assign section_prefix_class = 'main-tp-reviews'

  capture section_width
    case section.settings.section_width
      when 'container-fluid'
        echo 'container-fluid'
      else
        echo 'container'
    endcase
  endcapture
-%}
<style>
  {% if section.settings.font_variant == 'custom' %}
    {%- liquid
      assign body_font_bold = section.settings.title_font | font_modify: 'weight', 'bold'
      assign body_font_italic = section.settings.title_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    .main-tp-reviews :where(h1,h2,h3,h4,h5,h6,p,li,a,span,strong,em,small,button,label,div) {
      font-family: {{ section.settings.title_font.family }}, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
  {% endif %}
</style>

{%- stylesheet -%}
  .main-tp-reviews_content-wrapper a p {
    margin: 0 auto;
    color: var(--text-color);
    cursor: pointer;
  }

  .main-tp-reviews a {
    transition: all 0.3s ease;
  }

  .main-tp-reviews a:hover {
    color: var(--color-bg-btn);
  }

  .main-tp-reviews_wrapper {
    display: var(--display-value);
    text-align: var(--heading-align);
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }

  .main-tp-reviews_custom-page-width .container {
    max-width: calc(var(--custom-width, 1200) * 1px);
  }

  .main-tp-reviews_container-wrapper {
    padding: var(--xl-padding-y) 0;
  }

  .inner-padding .main-tp-reviews_content-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .outer-padding .main-tp-reviews_container-wrapper {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-tp-reviews_wrapper.inner-padding .container {
    background: var(--bg-color);
    color: var(--text-color);
  }

  .main-tp-reviews_wrapper.outer-padding .container {
    --cp-spacer-left: 0;
    --cp-spacer-right: 0;
  }

  .outer-padding .main-tp-reviews_container-wrapper:has(.container) {
    padding-left: var(--xl-padding-x);
    padding-right: var(--xl-padding-x);
  }

  .main-tp-reviews_wrapper.inner-padding .container,
  .main-tp-reviews_wrapper.outer-padding .container-fluid {
    --cp-spacer-left: var(--xl-padding-x);
    --cp-spacer-right: var(--xl-padding-x);
  }

  .main-tp-reviews .heading {
    margin: var(--margin);
  }

  .main-tp-reviews_content-wrapper {
    height: auto;
    display: block;
    position: relative;
    text-align: var(--heading-align);
  }

  .main-tp-reviews .title * {
    margin: 0;
  }

  .main-tp-reviews .title h2,
  .main-tp-reviews .title h1,
  .main-tp-reviews .title h3,
  .main-tp-reviews .title p {
    font-size: var(--xl-heading-size);
    line-height: 110%;
    font-weight: 700;
  }

  .main-tp-reviews .title {
    text-transform: var(--heading-transform);
    text-align: var(--heading-align);
    color: var(--title-color);
    margin: 0;
    margin-bottom: 16px;
  }

  .main-tp-reviews .subtitle h2,
  .main-tp-reviews .subtitle h3,
  .main-tp-reviews .subtitle h1,
  .main-tp-reviews .subtitle p {
    font-size: 24px;
    font-weight: 400;
    line-height: 150%;
  }
  .main-tp-reviews .subtitle{
    color: var(--sub-color);
    text-align: var(--heading-align);
    margin: 0;
    margin-bottom: 20px;
  }

  .main-tp-reviews .uppertitle * {
    margin: 0;
  }

  .main-tp-reviews .uppertitle {
    display: flex;
    justify-content: var(--heading-align);
    align-items: center;
    margin: 0;
    margin-bottom: 14.5px;
  }

  .main-tp-reviews .uppertitle svg path {
    fill: var(--fill);
  }

  .main-tp-reviews .uppertitle h2,
  .main-tp-reviews .uppertitle h3,
  .main-tp-reviews .uppertitle p {
    color: var(--upper-title);
    font-size: 16px;
    font-weight: 400;
    margin-left: 11px;
    line-height: 120%;
    order: 5;
  }

  .main-tp-reviews .slider-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }

  .main-tp-reviews .carousel-wrapper {
    width: 100%;
    margin: 0 auto;
    padding: 100px 0 25px;
    overflow: hidden;
    position: relative;
  }

  .main-tp-reviews .carousel {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 24px;
    position: relative;
    width: 100%;
    transition: transform 0.5s ease;
    padding: 0 40px;
  }

  .main-tp-reviews .carousel .carousel-item {
    flex: 0 0 auto;
    width: 404px;
    background-color: var(--card-bg);
    border: var(--border-solid);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: var(--box-shadow);
    gap: 8px;
    color: var(--body-color);
    padding: 24px;
  }

  .main-tp-reviews .top-slide-content {
    display: flex;
    width: 100%;
    margin: 0 auto;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
  }

  .main-tp-reviews .carousel .carousel-item .top-slide-content img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0;
  }

  .main-tp-reviews .carousel .carousel-item .top-slide-content .dots {
    width: 20px;
    height: 20px;
    border-radius: 0;
    margin-left: auto;
  }

  .main-tp-reviews .carousel .carousel-item .imgslide {
    width: 100%;
    height: auto;
    border-radius: 10px;
    object-fit: cover;
    margin: 0;
  }

  .main-tp-reviews .carousel .carousel-item .rating {
    color: #f4a261;
    font-size: 12px;
    margin: 0;
    width: 160px;
    margin-left: 13px;
    text-align: left;
    height: 13px;
  }

  .main-tp-reviews .carousel .carousel-item .name {
    font-weight: bold;
    font-size: 16px;
    line-height: 20px;
    margin: 0;
    width: 160px;
    margin-left: 13px;
    margin-bottom: 5px;
    text-align: left;
  }

  .main-tp-reviews .carousel .carousel-item .status {
    color: var(--status-color);
    font-size: 12px;
    line-height: 20px;
    margin: 0;
    width: 160px;
    margin-left: 13px;
    text-align: left;
    margin-bottom: 5px;
  }

  .main-tp-reviews .carousel .carousel-item .review-footer {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .main-tp-reviews .carousel .carousel-item p {
    font-size: 14px;
    line-height: 150%;
    color: var(--body-color);
    margin: 0;
    flex-grow: 1;
    display: flex;
    text-align: left;
    overflow: hidden;
    line-height: 1.3;
  }

  .main-tp-reviews .carousel .carousel-item .smiles {
    width: 70px;
    height: 14px;
    object-fit: cover;
  }

  .main-tp-reviews .fbicons {
    width: 16px;
    height: 16px;
    border-radius: 0;
  }

  .main-tp-reviews .carousel .carousel-item span {
    position: absolute;
    margin-left: 5px;
    line-height: 20px;
    font-size: 14px;
  }

  .main-tp-reviews .carousel-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-top: 78px;
  }

  .main-tp-reviews .carousel-nav .arrow {
    font-size: 20px;
    cursor: pointer;
    padding: 5px;
    border: 1px solid var(--swiper-navigation-color);
    color: var(--swiper-navigation-color);
    border-radius: 50%;
    transition: background-color 0.3s;
    width: 54px;
    line-height: normal;
    height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .main-tp-reviews .carousel-nav .dot {
    width: 16px;
    height: 16px;
    background: var(--bullet-color);
    border-radius: 50%;
    cursor: pointer;
  }

  .review-comments{
    font-size: 14px;
    line-height: 100%;
    font-weight: 400;
  }

  .main-tp-reviews .carousel-nav .dot.active {
    background: var(--bullet-active-color);
    width: 20px;
    height: 20px;
  }

  .fb_reviews .uppertitle .star_span svg{
    width: 18px;
    height: 18px;
  }

  .main-tp-reviews .uppertitle {
    margin-bottom: 20px;
  }

  .fb_reviews .title h1,
  .fb_reviews .title h2,
  .fb_reviews .title h3,
  .fb_reviews .title p {
    line-height: 110%;
    font-weight: 700;
  }

  .fb_reviews .title{
    margin-bottom: 0;
  }

  .fb_reviews .top-slide-content{
    gap: 27px;
  }

  .fb_reviews .carousel-wrapper {
    width: 100%;
    margin: 0 auto;
    padding: 39px 0 0;
    overflow: hidden;
    position: relative;
  }

  .fb_reviews .carousel-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 63px;
    margin-top: 78px;
  }

  .carousel-pagination{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  @media(min-width: 768px){
    .fb_reviews .uppertitle {
      display: flex;
      align-items: center;
      margin-bottom: 14.5px;
    }

    .carousel-pagination{
      gap: 30px;
    }

    .fb_reviews .carousel-nav .arrow{
      width: 54px !important;
      height: 54px !important;
    }

    .fb_reviews .carousel{
      gap: 44px !important;
    }
  }

  @media (max-width: 768px) {
    .fb_reviews .carousel-wrapper {
      width: 100%;
      margin: 0 auto;
      padding: 33px 0 0;
      overflow: hidden;
      position: relative;
    }

    .carousel-pagination{
      gap: 14px;
    }

    .fb_reviews .carousel-nav {
      gap: 34px;
    }

    .fb_reviews .uppertitle .star_span svg{
      max-width: 17px !important;
      width: 17px !important;
      height: 17px !important;
    }

    .fb_reviews .carousel-nav{
      margin-top: 40px !important;
    }

    .fb_reviews .carousel .carousel-item {
      width: 350px !important;
    }

    .main-tp-reviews_wrapper {
      display: var(--xs-display-value);
    }

    .fb_reviews .uppertitle{
      flex-direction: column;
      gap: 9px;
    }

    .outer-padding .main-tp-reviews_container-wrapper:has(.container)  {
      padding-left: var(--xs-padding-x);
      padding-right: var(--xs-padding-x);
    }

    .main-tp-reviews_wrapper.inner-padding .container,
    .main-tp-reviews_wrapper.outer-padding .container-fluid {
      --cp-spacer-left: var(--xs-padding-x);
      --cp-spacer-right: var(--xs-padding-x);
    }

    .main-tp-reviews_container-wrapper {
      padding: var(--xs-padding-y) 0;
    }

    .main-tp-reviews .title h2,
    .main-tp-reviews .title h1,
    .main-tp-reviews .title h3,
    .main-tp-reviews .title p {
      font-size: var(--xs-heading-size);
      line-height: auto;
    }

    .main-tp-reviews .title{
      margin: 0;
      margin-bottom: 16px;
    }

    .main-tp-reviews .subtitle h2,
    .main-tp-reviews .subtitle h3,
    .main-tp-reviews .subtitle h1,
    .main-tp-reviews .subtitle p {
      font-size: 20px;
      line-height: 24px;
    }

    .main-tp-reviews .uppertitle h2,
    .main-tp-reviews .uppertitle h3,
    .main-tp-reviews .uppertitle h4,
    .main-tp-reviews .uppertitle p {
      color: var(--upper-title);
      font-size: 14px;
      font-weight: 400;
      order: 5;
      margin-left: 3px;
    }

    .main-tp-reviews .uppertitle svg {
      max-width: 12px;
      margin-left: 0px;
    }

    .main-tp-reviews .uppertitle{
      margin-bottom: 12px;
    }

    .main-tp-reviews .carousel-wrapper {
      max-width: 100%;
      margin-top: 15px;
      padding-top: 0;
      padding-left: var(--xs-padding-x);
    }

    .main-tp-reviews .carousel {
      padding: 0 0px;
    }

    .main-tp-reviews .carousel .carousel-item {
      width: 350px;
      /* height: 404px; */
      gap: 20px;
    }

    .main-tp-reviews .carousel .carousel-item .top-slide-content img {
      width: 50px;
      height: 50px;
    }

    .main-tp-reviews .top-slide-content {
      margin-bottom: 0px;
    }

    .main-tp-reviews .carousel .carousel-item .rating {
      font-size: 13px;
    }

    .main-tp-reviews .carousel .carousel-item .name {
      font-size: 16px;
      line-height: 20px;
    }

    .main-tp-reviews .carousel .carousel-item .status {
      font-size: 12px;
      line-height: 20px;
    }

    .main-tp-reviews .carousel .carousel-item p {
      font-size: 14px;
      line-height: 150%;
    }

    .main-tp-reviews .fbicons {
      width: 16px;
      height: 16px;
      border-radius: 0;
    }

    .main-tp-reviews .carousel-nav .arrow {
      font-size: 16px;
      padding: 3px;
      width: 40px;
      height: 40px;
    }

    .main-tp-reviews .carousel-nav .dot {
      width: 10px !important;
      height: 10px !important;
      background: grey;
    }

    .main-tp-reviews .carousel-nav .dot.active {
      width: 12px !important;
      height: 12px !important;
    }

    .main-tp-reviews .swiper-b-next {
      width: 40px;
      height: 40px;
    }

    .main-tp-reviews .carousel-nav {
      margin-top: 40px;
      max-width: 340px;
    }

    .review-footer {
      display: flex;
      width: 100%;
      flex-wrap: nowrap;
      justify-content: space-between;
    }

    .review-comments {
      color: #020B1E;
      opacity: 50%;
    }
  }
{%- endstylesheet -%}

<div class="{{ section_prefix_class }}_wrapper {% if section.settings.section_width == 'contained-content' or section.settings.section_width == 'container-fluid' %}outer-padding{% else %}inner-padding{% endif %}"
  style="
    --status-color: {{ section.settings.status_color}};
    --title-color:  {{ section.settings.title_color }};
    --body-color: {{section.settings.body_color}};
    {% if section.settings.container_styling == "shadow" %}
      --box-shadow: {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_offset }}px {{ section.settings.box_shadow_blur }}px {{ section.settings.box_shadow_spread }}px {{ section.settings.box_shadow_color }};
    {% else %}
      --box-shadow: none;
    {% endif %}
    --radius: {{ section.settings.container_radius }}px;
    --border-solid: {{ section.settings.card_border }}px solid {{ section.settings.card_border_color }};
    --card-bg: {{ section.settings.card_background }};
    --upper-title: {{ section.settings.uppertitle_color }};
    --fill: {{ section.settings.star_color }};
    --sub-color: {{ section.settings.subtitle_color }};
    --heading-transform: {{ section.settings.headline_typography }};
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xs-heading-size: 20px;
      {% when 'medium' %}
      --xs-heading-size: 32px;
      {% when 'large' %}
      --xs-heading-size: 32px;
    {% endcase %}
    {% case section.settings.heading_size %}
      {% when 'small' %}
      --xl-heading-size: 28px;
      {% when 'medium' %}
      --xl-heading-size: 40px;
      {% when 'large' %}
      --xl-heading-size: 48px;
    {% endcase %}
    {% if section.settings.section_width == 'full' %}
      --margin: 0 10%
      --width-value: 100%;
    {% else %}
      --width-value: {{ settings.page_width }}px;
    {% endif %}
    --heading-align: {{ section.settings.heading_align }};
    --text-color: {{ section.settings.text_color }};
    --bg-color: {{ section.settings.background_color }};
    --xl-padding-x: {{ section.settings.padding_x_desk }}px;
    --xl-padding-y: {{ section.settings.padding_y_desk }}px;
    --xs-padding-x: {{ section.settings.padding_x_mob }}px;
    --xs-padding-y: {{ section.settings.padding_y_mob }}px;
    {% case section.settings.display_on %}
      {% when 'all' %}
        --xs-display-value: block;
      {% when 'mobile_only' %}
        --xs-display-value: block;
      {% when 'desktop_only' %}
        --xs-display-value: none;
    {% endcase %}
    {% case section.settings.display_on %}
      {% when 'all' %}
        --display-value: block;
      {% when 'mobile_only' %}
        --display-value: none;
      {% when 'desktop_only' %}
        --display-value: block;
    {% endcase %}
  "
>
  <div 
    class="{{ section_prefix_class }}_container-wrapper {% if section.settings.enable_custom_width %}{{ section_prefix_class }}_custom-page-width{% endif %}"
    style="
      --custom-width: {{ section.settings.custom_page_width }};
    "
  >
    <div class="{{ section_width }}">
      <div class="content-wrapper {{ section_prefix_class }}_content-wrapper">
      {%- if section.settings.uppertitle != blank or section.settings.subtitle or section.settings.title != blank -%}
      <div class="heading">
      {% if section.settings.uppertitle != blank %}
        <div class="uppertitle">
          <span class="star_span">{% for i in (1..5) %}{% render 'star_comparison' %}{% endfor %}</span>
          {{ section.settings.uppertitle }}
        </div>
      {% endif %}
      <div class="title">
        {%- if section.settings.title != blank -%}
          {{ section.settings.title }}
        {%- endif -%}
      </div>
      <div class="subtitle">
        {%- if section.settings.subtitle != blank -%}
          {{ section.settings.subtitle }}
        {%- endif -%}
      </div>
      </div>
      {%- endif -%}
      <div class="slider-container">
        <div class="carousel-wrapper">
          <div class="carousel" data-section-id="{{ section.id }}">
            {% for block in section.blocks %}
              {%- liquid 
                assign placeholder_index = forloop.index | modulo: 4
                  if placeholder_index == 0
                    assign placeholder_index = 4
                  endif
              -%}
              <div class="carousel-item">
                <div class="top-slide-content">
                  {% if block.settings.image != blank %}
                    {%- liquid
                      assign max_width = block.settings.image.width
                      if block.settings.image > 60
                          assign max_width = 60
                      endif
                      assign image_height = max_width | divided_by: block.settings.image.aspect_ratio | round

                      capture image_alt
                        if block.settings.image.alt != blank
                          echo block.settings.image.alt
                        elsif block.settings.image.alt == blank
                          echo 'Image'
                        else
                          echo block.settings.name
                        endif
                      endcapture
                    -%}
                    {{-
                      block.settings.image
                      | image_url: width: max_width
                      | image_tag: loading: 'lazy', width: max_width, height: image_height, alt: image_alt, class: ''
                    -}}
                  {% else %}
                    {%- render 'placeholder-svgs', type: 'hero', index: placeholder_index, class: '' -%}
                  {% endif %}
                  <div>
                    <div class="name">{{ block.settings.name }}</div>
                    <div class="status">{{ block.settings.status }}</div>
                  </div>
                  {% if block.settings.show_dots != blank %}
                    <img class="dots" src="{{ 'dots.svg' | asset_url }}"/>
                  {% else %}
                    <div class="dots"></div>
                  {% endif %}
                </div>
                {{ block.settings.text | truncate: 480 }}
                <div class="review-footer">
                  <div><img class="smiles" src="{{ 'gstars.svg' | asset_url }}"/></div>
                  <div class="review-comments">{{ block.settings.comments }}</div>
                </div>
              </div>
            {% endfor %}
            {% for block in section.blocks %}
              {%- liquid 
                assign placeholder_index = forloop.index | modulo: 4
                  if placeholder_index == 0
                    assign placeholder_index = 4
                  endif
              -%}
              <div class="carousel-item">
                <div class="top-slide-content">
                  {% if block.settings.image != blank %}
                    {%- liquid
                      assign max_width = block.settings.image.width
                      if block.settings.image > 60
                          assign max_width = 60
                      endif
                      assign image_height = max_width | divided_by: block.settings.image.aspect_ratio | round

                      capture image_alt
                        if block.settings.image.alt != blank
                          echo block.settings.image.alt
                        elsif block.settings.image.alt == blank
                          echo 'Image'
                        else
                          echo block.settings.name
                        endif
                      endcapture
                    -%}
                    {{-
                      block.settings.image
                      | image_url: width: max_width
                      | image_tag: loading: 'lazy', width: max_width, height: image_height, alt: image_alt, class: ''
                    -}}
                  {% else %}
                    {%- render 'placeholder-svgs', type: 'hero', index: placeholder_index, class: '' -%}
                  {% endif %}
                  <div>
                    <div class="name">{{ block.settings.name }}</div>
                    <div class="status">{{ block.settings.status }}</div>
                  </div>
                  {% if block.settings.show_dots != blank %}
                    <img class="dots" src="{{ 'dots.svg' | asset_url }}"/>
                  {% else %}
                    <div class="dots"></div>
                  {% endif %}
                </div>
                {{ block.settings.text | truncate: 480 }}
                <div class="review-footer">
                  <div><img class="smiles" src="{{ 'gstars.svg' | asset_url }}"/></div>
                  <div class="review-comments">{{ block.settings.comments }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="carousel-nav">
          <button class="arrow" data-direction="prev">
            {% render 'swiper-arrow-left-n' %}
          </button>
          <div class="carousel-pagination">
            {% for block in section.blocks %}
              <div role="button" class="dot{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}"></div>
            {% endfor %}
          </div>
          <button class="arrow" data-direction="next">
            {% render 'swiper-arrow-right-n' %}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const carousel = document.querySelector(`#shopify-section-${sectionId} .carousel`);
    const dots = document.querySelectorAll(`#shopify-section-${sectionId} .dot`);
    const arrows = document.querySelectorAll(`#shopify-section-${sectionId} .arrow`);
    const autoScrollEnabled = {{ section.settings.auto_scroll | json }}; // Ensure boolean value
    const scrollSpeed = {{ section.settings.scroll_speed | times: 1000 }}; // Convert seconds to ms
    let currentIndex = 0;
    let autoScrollInterval = null;
    const totalItems = carousel.children.length; // Number of original items
    const itemWidth = carousel.children[0].offsetWidth + 24; // Width + updated gap of 24px
    const visibleItems = Math.ceil(carousel.parentElement.offsetWidth / itemWidth); // Round up for full coverage

    // Clone items for infinite scrolling (2 sets of clones)
    const originalItems = Array.from(carousel.children);
    for (let i = 0; i < 2; i++) {
      originalItems.forEach(item => {
        const clone = item.cloneNode(true);
        carousel.appendChild(clone);
      });
    }
    const realTotalItems = carousel.children.length; // Total items after cloning

    // Set initial position in the middle
    currentIndex = totalItems;
    carousel.style.transition = 'none';
    carousel.style.transform = `translateX(${-currentIndex * itemWidth}px)`;
    setTimeout(() => {
      carousel.style.transition = 'transform 0.5s ease';
    }, 50);

    function updateCarousel(transition = true) {
      const offset = -currentIndex * itemWidth;

      if (transition) {
        carousel.style.transition = 'transform 0.5s ease';
      } else {
        carousel.style.transition = 'none';
      }

      carousel.style.transform = `translateX(${offset}px)`;

      // Infinite loop handling
      if (currentIndex >= totalItems * 2) {
        setTimeout(() => {
          currentIndex = totalItems;
          carousel.style.transition = 'none';
          carousel.style.transform = `translateX(${-currentIndex * itemWidth}px)`;
          setTimeout(() => {
            carousel.style.transition = 'transform 0.5s ease';
          }, 50);
        }, 500);
      } else if (currentIndex < totalItems) {
        setTimeout(() => {
          currentIndex = totalItems * 2 - visibleItems;
          carousel.style.transition = 'none';
          carousel.style.transform = `translateX(${-currentIndex * itemWidth}px)`;
          setTimeout(() => {
            carousel.style.transition = 'transform 0.5s ease';
          }, 50);
        }, 500);
      }

      // Update active dot
      let dotIndex = (currentIndex % totalItems);
      dots.forEach((dot, index) => {

        if(dotIndex >= {{section.blocks.size}}){
          dotIndex = dotIndex - {{section.blocks.size}} % totalItems;
        }
        dot.classList.toggle('active', index === dotIndex);
      });
    }

    function startAutoScroll() {
      stopAutoScroll(); // Clear before starting
      if (autoScrollEnabled === true) { // Explicit comparison with true
        autoScrollInterval = setInterval(() => {
          currentIndex++;
          updateCarousel(true);
        }, scrollSpeed / totalItems); // Divide scrollSpeed by totalItems for per-slide timing
      } else {}
    }

    function stopAutoScroll() {
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
      }
    }

    // Arrow navigation
    arrows.forEach(arrow => {
      arrow.addEventListener('click', () => {
        stopAutoScroll();
        const direction = arrow.getAttribute('data-direction');
        if (direction === 'prev') {
          currentIndex--;
        } else if (direction === 'next') {
          currentIndex++;
        }
        updateCarousel(true);
        if (autoScrollEnabled) startAutoScroll();
      });
    });

    // Dot navigation
    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        stopAutoScroll();
        const index = parseInt(dot.getAttribute('data-index'));
        currentIndex = totalItems + index;
        updateCarousel(true);
        if (autoScrollEnabled) startAutoScroll();
      });
    });

    // Pause on hover
    carousel.addEventListener('mouseenter', stopAutoScroll);
    carousel.addEventListener('mouseleave', () => {
      if (autoScrollEnabled) startAutoScroll();
    });

    // Add touch controls for mobile devices
    let touchStartX = 0;
    let touchCurrentX = 0;
    let isDragging = false;

    carousel.addEventListener('touchstart', (e) => {
      stopAutoScroll();
      touchStartX = e.touches[0].clientX;
      touchCurrentX = touchStartX;
      isDragging = true;
      carousel.style.transition = 'none'; // Disable animation during swipe
    });

    carousel.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      touchCurrentX = e.touches[0].clientX;
      const diff = touchCurrentX - touchStartX;
      const newOffset = -currentIndex * itemWidth + diff;
      carousel.style.transform = `translateX(${newOffset}px)`;
    });

    carousel.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const diff = touchCurrentX - touchStartX;
      const threshold = itemWidth / 3; // Threshold for switching slides

      if (Math.abs(diff) > threshold) {
        if (diff > 0) {
          currentIndex--; // Swipe right
        } else {
          currentIndex++; // Swipe left
        }
      }

      carousel.style.transition = 'transform 0.5s ease';
      updateCarousel(true);
      if (autoScrollEnabled) startAutoScroll();
    });

    // Initialization
    updateCarousel(false);
    startAutoScroll(); // Attempt to start auto-scroll
  });
</script>

