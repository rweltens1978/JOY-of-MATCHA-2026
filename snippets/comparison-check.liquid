{% if section.settings.icon_check != blank %}
  {%- liquid
    assign max_width = section.settings.icon_check.width
    if section.settings.icon_check > 24
        assign max_width = 24
    endif
    assign image_height = max_width | divided_by: section.settings.icon_check.aspect_ratio | round

    capture image_alt
      if section.settings.icon_check.alt != blank
        echo section.settings.icon_check.alt
      else
        echo 'image_alternative.static' | t
      endif
    endcapture

    capture sizes_attr
      echo '(max-width: 415px) calc(100vw - 30px), (max-width: 767px) calc(50vw - 30px), (max-width: 1199px) 59.216vw'
    endcapture
  -%}
  {{-
    section.settings.icon_check
    | image_url: width: max_width
    | image_tag: loading: 'lazy', width: max_width, height: image_height, sizes: sizes_attr, alt: image_alt, class: ''
  -}}
{% else %}
<svg width="56" height="56" viewBox="0 0 48 47" fill="none" xmlns="http://www.w3.org/2000/svg">
