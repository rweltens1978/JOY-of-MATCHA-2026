  {
         "name": "License",
        "settings": [
          {
            "type": "header",
            "content": "License Configuration"
          },
          {
            "type": "paragraph",
            "content": "Enter your theme license key to activate all features. You can find your license key in your purchase confirmation email or customer portal."
          },
          {
            "id": "license_key",
            "type": "text",
            "label": "License Key *",
            "info": "Enter your purchased theme license key (REQUIRED)",
            "placeholder": "GHBB86P6-D62RZ7YG-X79RQSRK-VCINFV"
          },
          {
            "id": "store_url", 
            "type": "text",
            "label": "Shopify Store URL *",
            "info": "Enter your Shopify Store URL WITHOUT the https://. If you’re using a custom domain, use that instead of the myshopify.com URL(REQUIRED)",
            "placeholder": "yourstore.myshopify.com"
          }
        ]
      },

